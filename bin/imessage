#!/usr/bin/env python3
import argparse
import sqlite3
import datetime
import os
import sys
import subprocess
import shutil
import time
import glob
import json
import base64
import plistlib
import re
import struct

def get_db_path():
    """chat.db path. IMESSAGE_DB_PATH overrides the macOS default (used by tests)."""
    override = os.environ.get("IMESSAGE_DB_PATH")
    if override:
        return os.path.expanduser(override)
    return os.path.expanduser("~/Library/Messages/chat.db")

def get_db_connection():
    db_path = get_db_path()
    if not os.path.exists(db_path):
        print(f"ERROR: iMessage database not found at {db_path}", file=sys.stderr)
        sys.exit(1)
    try:
        return sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    except Exception as e:
        print(f"ERROR: Could not open database in read-only mode: {e}", file=sys.stderr)
        sys.exit(1)

def format_size(bytes_num):
    if not bytes_num: return "0 B"
    for unit in ['B', 'KB', 'MB', 'GB']:
        if abs(bytes_num) < 1024.0:
            return f"{bytes_num:.1f} {unit}"
        bytes_num /= 1024.0
    return f"{bytes_num:.1f} TB"

AUDIO_EXTENSIONS = {'.caf', '.m4a', '.wav', '.mp3', '.aac', '.ogg', '.aiff', '.flac'}
AUDIO_MIME_MAP = {
    '.caf': 'audio/x-caf',
    '.m4a': 'audio/mp4',
    '.mp4': 'audio/mp4',
    '.wav': 'audio/wav',
    '.mp3': 'audio/mpeg',
    '.aac': 'audio/aac',
    '.ogg': 'audio/ogg',
    '.aiff': 'audio/aiff',
    '.flac': 'audio/flac',
}

def get_caf_duration(path):
    """Parse CAF header for sample rate and valid frame count to compute exact duration."""
    if not path or not os.path.exists(path):
        return None
    try:
        with open(path, 'rb') as f:
            hdr = f.read(8)
            if len(hdr) < 8 or hdr[:4] != b'caff':
                return None
            sr = None
            while True:
                chunk_hdr = f.read(12)
                if len(chunk_hdr) < 12:
                    break
                ctype, csize = struct.unpack('>4sq', chunk_hdr)
                if ctype == b'desc':
                    desc_data = f.read(csize)
                    if len(desc_data) >= 8:
                        sr = struct.unpack('>d', desc_data[:8])[0]
                elif ctype == b'pakt':
                    pakt_data = f.read(min(csize, 24))
                    if len(pakt_data) >= 16 and sr and sr > 0:
                        pkts, valid_frames = struct.unpack('>qq', pakt_data[:16])
                        return round(valid_frames / sr, 2)
                    if csize > len(pakt_data):
                        f.seek(csize - len(pakt_data), 1)
                else:
                    if csize > 0:
                        f.seek(csize, 1)
    except Exception:
        pass
    return None

def get_audio_duration(path):
    """Returns duration in seconds for an audio file, using fast CAF parser or afinfo."""
    if not path or not os.path.exists(path):
        return None
    ext = os.path.splitext(path)[1].lower()
    if ext == '.caf':
        dur = get_caf_duration(path)
        if dur is not None:
            return dur
    try:
        afinfo_bin = '/usr/bin/afinfo'
        if os.path.exists(afinfo_bin):
            res = subprocess.run([afinfo_bin, path], capture_output=True, text=True, timeout=5)
            for line in res.stdout.splitlines():
                if 'estimated duration:' in line:
                    parts = line.split('estimated duration:')[1].split()
                    if parts:
                        return round(float(parts[0]), 2)
    except Exception:
        pass
    return None

def format_duration(seconds):
    """Format duration in seconds to compact string like '15s' or '1m 32s'."""
    if seconds is None:
        return None
    total_sec = int(round(seconds))
    mins = total_sec // 60
    secs = total_sec % 60
    if mins > 0:
        return f"{mins}m {secs}s"
    return f"{secs}s"

def build_voice_note_label(duration_formatted, transcription):
    """Build a clear label for voice notes instead of an empty message."""
    if transcription and duration_formatted:
        return f'[voice note, {duration_formatted}: "{transcription}"]'
    elif transcription:
        return f'[voice note: "{transcription}"]'
    elif duration_formatted:
        return f'[voice note, {duration_formatted}]'
    return '[voice note]'

def extract_attachment_user_info(user_info_blob):
    """Extract transcription, uti, and metadata from attachment user_info blob."""
    if not user_info_blob:
        return {}
    try:
        return plistlib.loads(user_info_blob)
    except Exception:
        return {}

def fetch_attachments_for_messages(cursor, msg_ids):
    """
    Fetch and enrich all attachments for a list of message IDs.
    Returns a dict mapping msg_id to a list of attachment dicts.
    """
    if not msg_ids:
        return {}
    att_placeholders = ",".join(["?"] * len(msg_ids))
    att_query = f"""
    SELECT 
        maj.message_id,
        a.filename,
        a.mime_type,
        a.transfer_name,
        a.total_bytes,
        a.user_info,
        a.uti
    FROM message_attachment_join maj
    JOIN attachment a ON maj.attachment_id = a.ROWID
    WHERE maj.message_id IN ({att_placeholders})
    """
    cursor.execute(att_query, msg_ids)
    attachments_map = {}
    for msg_id, filename, mime_type, transfer_name, total_bytes, user_info, uti in cursor.fetchall():
        if msg_id not in attachments_map:
            attachments_map[msg_id] = []
        
        full_path = os.path.expanduser(filename) if filename else None
        ext = os.path.splitext(full_path or transfer_name or "")[1].lower()
        
        p = extract_attachment_user_info(user_info)
        transcription = p.get('audio-transcription') or None
        
        is_audio = (
            ext in AUDIO_EXTENSIONS
            or (uti and ('coreaudio' in uti.lower() or 'audio' in uti.lower()))
            or (mime_type and mime_type.startswith('audio/'))
            or transcription is not None
        )
        
        resolved_mime = mime_type
        if not resolved_mime or resolved_mime == 'application/octet-stream':
            if ext in AUDIO_MIME_MAP:
                resolved_mime = AUDIO_MIME_MAP[ext]
            elif ext in ['.jpg', '.jpeg']:
                resolved_mime = 'image/jpeg'
            elif ext == '.png':
                resolved_mime = 'image/png'
            elif ext in ['.heic', '.heif']:
                resolved_mime = 'image/heic'
            elif ext == '.mov':
                resolved_mime = 'video/quicktime'
            elif ext == '.mp4':
                resolved_mime = 'video/mp4'
            elif is_audio:
                resolved_mime = 'audio/x-caf'
            else:
                resolved_mime = 'application/octet-stream'

        dur_sec = get_audio_duration(full_path) if is_audio and full_path else None
        dur_fmt = format_duration(dur_sec) if dur_sec is not None else None

        attachments_map[msg_id].append({
            'filename': full_path,
            'mime_type': resolved_mime,
            'transfer_name': transfer_name or (os.path.basename(full_path) if full_path else 'attachment'),
            'size': format_size(total_bytes),
            'is_audio': bool(is_audio),
            'duration_seconds': dur_sec,
            'duration_formatted': dur_fmt,
            'transcription': transcription,
            'uti': uti,
        })
    return attachments_map

def synthesize_message_text(raw_text, attr_body, is_audio_message, att_list):
    """
    Synthesizes message text, populating voice note transcripts and labels
    when text is empty or when audio attachments exist.
    Returns: (text: str, is_audio: bool, transcription: str | None)
    """
    msg_text = raw_text or ""
    if not msg_text or msg_text.strip() == "":
        msg_text = parse_attributed_body(attr_body)
    
    audio_atts = [a for a in att_list if a.get('is_audio')]
    is_audio = bool(is_audio_message or audio_atts)
    
    transcription = None
    for a in audio_atts:
        if a.get('transcription'):
            transcription = a['transcription']
            break
            
    dur_fmt = None
    for a in audio_atts:
        if a.get('duration_formatted'):
            dur_fmt = a['duration_formatted']
            break

    if is_audio:
        voice_label = build_voice_note_label(dur_fmt, transcription)
        if not msg_text or msg_text.strip() == "" or msg_text == "<empty message>":
            msg_text = voice_label
        else:
            msg_text = f"{msg_text.strip()} {voice_label}".strip()
            
    if not msg_text or msg_text.strip() == "":
        msg_text = "<empty message>"

    return msg_text, is_audio, transcription

def normalize_handle(val):
    if not val: return ""
    clean = "".join([c for c in val if c.isalnum() or c == '@'])
    if clean.startswith('1') and len(clean) == 11 and clean.isdigit():
        clean = clean[1:]
    return clean.lower()

def get_contacts_map():
    ab_paths = glob.glob(os.path.expanduser('~/Library/Application Support/AddressBook/**/*.abcddb'), recursive=True)
    cmap = {}
    for p in ab_paths:
        try:
            conn = sqlite3.connect(f"file:{p}?mode=ro", uri=True)
            c = conn.cursor()
            sql = """
            SELECT 
                r.ZFIRSTNAME, r.ZLASTNAME, r.ZORGANIZATION,
                p.ZFULLNUMBER, e.ZADDRESS
            FROM ZABCDRECORD r
            LEFT JOIN ZABCDPHONENUMBER p ON r.Z_PK = p.ZOWNER
            LEFT JOIN ZABCDEMAILADDRESS e ON r.Z_PK = e.ZOWNER
            """
            c.execute(sql)
            for fname, lname, org, phone, email in c.fetchall():
                full_name = " ".join(filter(None, [fname, lname])) or org or ""
                if not full_name: continue
                if phone:
                    cmap[normalize_handle(phone)] = full_name
                if email:
                    cmap[normalize_handle(email)] = full_name
            conn.close()
        except Exception:
            pass
    return cmap

def list_chats(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    query = """
    SELECT 
        c.ROWID, 
        COALESCE(c.display_name, ''), 
        c.chat_identifier,
        MAX(m.date) as last_msg_date
    FROM chat c
    LEFT JOIN chat_message_join cmj ON c.ROWID = cmj.chat_id
    LEFT JOIN message m ON cmj.message_id = m.ROWID
    GROUP BY c.ROWID
    ORDER BY last_msg_date DESC
    LIMIT ?
    """
    cursor.execute(query, (args.limit,))
    rows = cursor.fetchall()
    
    cmap = get_contacts_map()
    chats = []
    for rowid, display_name, identifier, last_msg_date in rows:
        cursor.execute("""
            SELECT h.id
            FROM chat_handle_join chj
            JOIN handle h ON chj.handle_id = h.ROWID
            WHERE chj.chat_id = ?
        """, (rowid,))
        handles = [r[0] for r in cursor.fetchall()]
        
        participants = []
        for h in handles:
            norm = normalize_handle(h)
            pname = cmap.get(norm, h)
            participants.append({'name': pname, 'handle': h})
            
        if display_name:
            name = display_name
        elif participants:
            name = ", ".join([p['name'] for p in participants])
        else:
            name = identifier or "<Direct Chat>"

        chats.append({
            'rowid': rowid,
            'chat_id': rowid,
            'display_name': display_name,
            'name': name,
            'identifier': identifier,
            'last_msg_date': last_msg_date,
            'participants': participants
        })
        
    if getattr(args, 'json', False):
        print(json.dumps(chats, indent=2))
    else:
        print(f"{'ID':<6} | {'Display Name / Participants':<35} | {'Identifier':<35}")
        print("-" * 85)
        for c in chats:
            print(f"{c['rowid']:<6} | {c['name']:<35} | {c['identifier']:<35}")
    conn.close()

def parse_attributed_body(blob):
    if not blob: return ""
    try:
        markers = [
            b'NSString' + bytes([1, 148, 132, 1]) + b'+',
            b'NSString' + bytes([1, 149, 132, 1]) + b'+',
            b'NSString' + bytes([1, 132, 1]) + b'+'
        ]
        for marker in markers:
            idx = blob.find(marker)
            if idx != -1:
                start = idx + len(marker)
                if start < len(blob):
                    flag = blob[start]
                    if flag == 0x81:
                        if start + 3 <= len(blob):
                            length = int.from_bytes(blob[start+1:start+3], byteorder='little')
                            if 0 < length <= len(blob) - (start + 3):
                                return blob[start + 3 : start + 3 + length].decode('utf-8', errors='ignore').strip('\x00\x01\ufffc')
                        if start + 2 <= len(blob):
                            length = blob[start+1]
                            if 0 < length <= len(blob) - (start + 2):
                                return blob[start + 2 : start + 2 + length].decode('utf-8', errors='ignore').strip('\x00\x01\ufffc')
                    elif flag == 0x82:
                        if start + 3 <= len(blob):
                            length = int.from_bytes(blob[start+1:start+3], byteorder='big')
                            if 0 < length <= len(blob) - (start + 3):
                                return blob[start + 3 : start + 3 + length].decode('utf-8', errors='ignore').strip('\x00\x01\ufffc')
                    else:
                        length = flag
                        if 0 < length <= len(blob) - (start + 1):
                            return blob[start + 1 : start + 1 + length].decode('utf-8', errors='ignore').strip('\x00\x01\ufffc')
    except: pass
    return ""

APPLE_EPOCH = datetime.datetime(2001, 1, 1, tzinfo=datetime.timezone.utc)

def format_apple_seconds(seconds):
    """Human timestamp (unchanged) plus ISO 8601 with the host's local UTC offset."""
    if seconds is None:
        return "", None
    dt_local = (APPLE_EPOCH + datetime.timedelta(seconds=float(seconds))).astimezone()
    human = dt_local.strftime("%Y-%m-%d %I:%M %p")
    iso = dt_local.replace(microsecond=0).isoformat()
    return human, iso

def format_apple_ns(date_ns):
    if not date_ns:
        return "", None
    return format_apple_seconds(int(date_ns) / 1_000_000_000)

def parse_edit_history(blob, date_edited_ns=0, message_date_ns=0):
    """
    Parses message_summary_info and date_edited to extract rewrite history.
    Returns: (is_edited: bool, edit_count: int, last_edited: str | None, edit_history: list)
    History entries keep `timestamp` and add `timestamp_iso`.
    """
    if not blob:
        if date_edited_ns and date_edited_ns > 0:
            last_ts, _last_iso = format_apple_ns(date_edited_ns)
            return True, 1, last_ts, []
        return False, 0, None, []

    try:
        data = plistlib.loads(blob)
    except Exception:
        if date_edited_ns and date_edited_ns > 0:
            last_ts, _last_iso = format_apple_ns(date_edited_ns)
            return True, 1, last_ts, []
        return False, 0, None, []

    ec = data.get('ec')
    if not ec or not isinstance(ec, dict):
        if date_edited_ns and date_edited_ns > 0:
            last_ts, _last_iso = format_apple_ns(date_edited_ns)
            return True, 1, last_ts, []
        return False, 0, None, []

    sorted_parts = sorted(ec.keys(), key=lambda k: int(k) if str(k).isdigit() else str(k))
    if not sorted_parts:
        return False, 0, None, []

    max_revisions = max((len(ec[k]) for k in sorted_parts if isinstance(ec[k], list)), default=0)
    if max_revisions <= 1:
        if date_edited_ns and date_edited_ns > 0:
            last_ts, _last_iso = format_apple_ns(date_edited_ns)
            return True, 1, last_ts, []
        return False, 0, None, []

    history = []
    for rev_idx in range(max_revisions):
        part_texts = []
        rev_date = None
        for p_key in sorted_parts:
            part_edits = ec[p_key]
            if not isinstance(part_edits, list) or not part_edits:
                continue
            item = part_edits[rev_idx] if rev_idx < len(part_edits) else part_edits[-1]
            if rev_date is None and item.get('d'):
                rev_date = item.get('d')
            t_str = parse_attributed_body(item.get('t'))
            if t_str:
                part_texts.append(t_str)

        ts_str = ''
        ts_iso = None
        if rev_date:
            ts_str, ts_iso = format_apple_seconds(rev_date)
        elif rev_idx == 0 and message_date_ns:
            ts_str, ts_iso = format_apple_ns(message_date_ns)

        label = "original" if rev_idx == 0 else f"edit_{rev_idx}"
        history.append({
            'revision': rev_idx,
            'label': label,
            'timestamp': ts_str,
            'timestamp_iso': ts_iso,
            'text': " ".join(part_texts)
        })

    edit_count = max_revisions - 1
    last_edited = history[-1]['timestamp'] if history and history[-1]['timestamp'] else None
    if not last_edited and date_edited_ns and date_edited_ns > 0:
        last_edited, _last_iso = format_apple_ns(date_edited_ns)

    return True, edit_count, last_edited, history

_REACTION_NAMES = {
    0: "love",
    1: "like",
    2: "dislike",
    3: "laugh",
    4: "emphasize",
    5: "question",
    6: "emoji",
}

_URL_RE = re.compile(r"https?://[^\s<>\"']+")


def classify_associated_type(assoc_type):
    """Tapback rows use 2000-2006 (added) and 3000-3006 (removed)."""
    if assoc_type is None:
        return None
    try:
        code = int(assoc_type)
    except (TypeError, ValueError):
        return None
    if 2000 <= code <= 2006:
        return code, _REACTION_NAMES[code - 2000], "added"
    if 3000 <= code <= 3006:
        return code, _REACTION_NAMES[code - 3000], "removed"
    return None


def target_guid_from_associated(raw):
    """associated_message_guid looks like 'p:0/<guid>' or 'bp:<guid>'."""
    if not raw or not isinstance(raw, str):
        return None
    value = raw.strip()
    if not value:
        return None
    if "/" in value:
        value = value.rsplit("/", 1)[-1]
    if value.startswith("bp:"):
        value = value[3:]
    return value or None


def message_column_names(cursor):
    cursor.execute("PRAGMA table_info(message)")
    return {row[1] for row in cursor.fetchall()}


def message_select_list(available):
    def field(column, alias):
        if column in available:
            return f"m.{column} AS {alias}"
        return f"NULL AS {alias}"

    parts = [
        "m.ROWID AS msg_id",
        field("guid", "guid"),
        "c.ROWID AS chat_id",
        "c.display_name AS display_name",
        "c.chat_identifier AS chat_identifier",
        "m.date AS date_ns",
        "m.is_from_me AS is_from_me",
        "h.id AS handle",
        "m.text AS text",
        field("attributedBody", "attributed_body"),
        field("date_edited", "date_edited_ns"),
        field("message_summary_info", "summary_blob"),
        field("is_audio_message", "is_audio_message"),
        field("associated_message_type", "associated_message_type"),
        field("associated_message_guid", "associated_message_guid"),
        field("associated_message_emoji", "associated_message_emoji"),
        field("balloon_bundle_id", "balloon_bundle_id"),
        field("payload_data", "payload_data"),
    ]
    return ",\n        ".join(parts)


MESSAGE_FROM = """
FROM message m
JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
JOIN chat c ON cmj.chat_id = c.ROWID
LEFT JOIN handle h ON m.handle_id = h.ROWID
"""


MESSAGE_FROM_LOOSE = """
FROM message m
LEFT JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
LEFT JOIN chat c ON cmj.chat_id = c.ROWID
LEFT JOIN handle h ON m.handle_id = h.ROWID
"""


def fetch_message_dicts(cursor, select_sql, tail_sql, params, from_sql=None):
    cursor.execute(f"SELECT {select_sql} {from_sql or MESSAGE_FROM} WHERE {tail_sql}", params)
    cols = [d[0] for d in cursor.description]
    return [dict(zip(cols, row)) for row in cursor.fetchall()]


def resolve_chat_ids(cursor, target):
    if target is None:
        return []
    target = str(target).strip()
    if not target:
        return []
    if target.isdigit():
        return [int(target)]
    cursor.execute(
        "SELECT ROWID FROM chat WHERE display_name LIKE ? OR chat_identifier LIKE ?",
        (f"%{target}%", f"%{target}%"),
    )
    return [r[0] for r in cursor.fetchall()]


def chat_placeholders(chat_ids):
    return ",".join(["?"] * len(chat_ids))


def sender_identity(is_from_me, handle, cmap, prefer_contact_name):
    """
    Outgoing chat.db rows store the other participant on handle_id.
    `handle` is the sender's own address and is empty for the account owner.
    `participant` preserves the other party's handle from that column.
    """
    counterpart = handle or ""
    if is_from_me:
        return "Me", "", counterpart
    if prefer_contact_name and cmap is not None:
        sender = cmap.get(normalize_handle(handle), handle or "Unknown")
    else:
        sender = handle or "Unknown"
    return sender, counterpart, counterpart


def last_edited_iso(history, date_edited_ns):
    if history:
        iso = history[-1].get("timestamp_iso")
        if iso:
            return iso
    if date_edited_ns:
        _human, iso = format_apple_ns(date_edited_ns)
        return iso
    return None


def _resolve_archive_value(objects, value, seen):
    if isinstance(value, plistlib.UID):
        idx = int(value)
        if idx in seen or idx < 0 or idx >= len(objects):
            return None
        seen = set(seen)
        seen.add(idx)
        return _resolve_archive_value(objects, objects[idx], seen)
    if isinstance(value, dict):
        if "NS.relative" in value or "NS.base" in value:
            rel = _resolve_archive_value(objects, value.get("NS.relative"), set(seen))
            base = _resolve_archive_value(objects, value.get("NS.base"), set(seen))
            if isinstance(rel, str) and rel:
                if isinstance(base, str) and base and not rel.startswith("http"):
                    return base.rstrip("/") + "/" + rel.lstrip("/")
                return rel
            return rel if isinstance(rel, str) else None
        out = {}
        for key, item in value.items():
            if key.startswith("$"):
                continue
            out[key] = _resolve_archive_value(objects, item, set(seen))
        return out
    if isinstance(value, list):
        return [_resolve_archive_value(objects, item, set(seen)) for item in value]
    if value == "$null":
        return None
    return value


def decode_payload_object(blob):
    if not blob:
        return None
    try:
        obj = plistlib.loads(blob)
    except Exception:
        return None
    if isinstance(obj, dict) and obj.get("$archiver") == "NSKeyedArchiver":
        objects = obj.get("$objects") or []
        root = (obj.get("$top") or {}).get("root")
        return _resolve_archive_value(objects, root, set())
    return obj


def _first_str(*values):
    for value in values:
        if isinstance(value, str) and value.strip():
            return value.strip()
    return None


def _find_link_dict(node):
    if isinstance(node, dict):
        if any(key in node for key in ("URL", "url", "title", "siteName", "summary", "originalURL")):
            return node
        for child in node.values():
            found = _find_link_dict(child)
            if found:
                return found
    elif isinstance(node, list):
        for child in node:
            found = _find_link_dict(child)
            if found:
                return found
    return None


def _artist_from_node(node):
    if not isinstance(node, dict):
        return None
    direct = _first_str(node.get("artist"), node.get("artistName"), node.get("albumArtist"))
    if direct:
        return direct
    for child in node.values():
        if isinstance(child, dict):
            found = _artist_from_node(child)
            if found:
                return found
    return None


def attachment_is_plugin_payload(att):
    blob = " ".join([
        str(att.get("transfer_name") or ""),
        str(att.get("filename") or ""),
        str(att.get("uti") or ""),
    ]).lower()
    return "pluginpayload" in blob


def extract_link_preview(payload_blob, message_text, balloon_bundle_id, attachments):
    """
    Pull URL, title, subtitle, artist, and site name out of payload_data.
    Accepts a plain binary plist or an NSKeyedArchiver LPLinkMetadata archive.
    The raw pluginPayloadAttachment stays on `attachments` for callers that need bytes.
    """
    decoded = decode_payload_object(payload_blob)
    meta = _find_link_dict(decoded) if decoded is not None else None
    url = title = subtitle = site_name = artist = None
    if isinstance(meta, dict):
        url = _first_str(meta.get("URL"), meta.get("url"), meta.get("originalURL"))
        title = _first_str(meta.get("title"))
        subtitle = _first_str(meta.get("summary"), meta.get("subtitle"))
        site_name = _first_str(meta.get("siteName"), meta.get("site_name"))
        artist = _artist_from_node(meta.get("specialization")) or _artist_from_node(meta)
        if artist and title and artist == title:
            artist = _artist_from_node(meta.get("specialization"))
    balloon = balloon_bundle_id or ""
    is_linkish = (
        "URLBalloon" in balloon
        or "RichLink" in balloon
        or "spotify" in balloon.lower()
        or any(attachment_is_plugin_payload(att) for att in attachments)
    )
    if not url and is_linkish and message_text:
        match = _URL_RE.search(message_text)
        if match:
            url = match.group(0)
    if artist is None and subtitle and site_name and "spotify" in site_name.lower():
        artist = subtitle
    if meta is None and not is_linkish:
        return None
    if not any([url, title, subtitle, site_name, artist]):
        return None
    return {
        "url": url,
        "title": title,
        "subtitle": subtitle,
        "artist": artist,
        "site_name": site_name,
    }


def lookup_message_guids(cursor, guids):
    cleaned = [g for g in dict.fromkeys(guids) if g]
    if not cleaned:
        return {}
    placeholders = ",".join(["?"] * len(cleaned))
    try:
        cursor.execute(
            f"SELECT ROWID, guid FROM message WHERE guid IN ({placeholders})",
            cleaned,
        )
    except sqlite3.OperationalError:
        return {}
    return {guid: rowid for rowid, guid in cursor.fetchall() if guid}


def build_reaction_record(row, cmap, prefer_contact_name, guid_to_id):
    _code, reaction_type, action = classify_associated_type(row.get("associated_message_type"))
    target_guid = target_guid_from_associated(row.get("associated_message_guid"))
    emoji = row.get("associated_message_emoji") or None
    if reaction_type != "emoji":
        emoji = None
    elif isinstance(emoji, str):
        emoji = emoji or None
    sender, handle, participant = sender_identity(
        bool(row.get("is_from_me")), row.get("handle"), cmap, prefer_contact_name
    )
    human, iso = format_apple_ns(row.get("date_ns"))
    return {
        "msg_id": row["msg_id"],
        "guid": row.get("guid"),
        "type": reaction_type,
        "action": action,
        "emoji": emoji,
        "sender": sender,
        "handle": handle,
        "participant": participant,
        "is_from_me": bool(row.get("is_from_me")),
        "target_msg_id": guid_to_id.get(target_guid) if target_guid else None,
        "target_guid": target_guid,
        "associated_message_guid": row.get("associated_message_guid"),
        "associated_message_type": int(row.get("associated_message_type") or 0),
        "timestamp": human,
        "timestamp_iso": iso,
    }


def base_message_fields(row, cmap, prefer_contact_name, attachments_map):
    is_from_me = bool(row.get("is_from_me"))
    sender, handle, participant = sender_identity(
        is_from_me, row.get("handle"), cmap, prefer_contact_name
    )
    human, iso = format_apple_ns(row.get("date_ns"))
    display_name = row.get("display_name") or ""
    chat_ident = row.get("chat_identifier") or ""
    chat = display_name if display_name else chat_ident
    att_list = attachments_map.get(row["msg_id"], [])
    msg_text, is_audio, transcription = synthesize_message_text(
        row.get("text"), row.get("attributed_body"), row.get("is_audio_message"), att_list
    )
    is_edited, edit_count, last_edited, edit_history = parse_edit_history(
        row.get("summary_blob"), row.get("date_edited_ns") or 0, row.get("date_ns") or 0
    )
    link_preview = extract_link_preview(
        row.get("payload_data"), msg_text, row.get("balloon_bundle_id"), att_list
    )
    return {
        "kind": "message",
        "msg_id": row["msg_id"],
        "guid": row.get("guid"),
        "timestamp": human,
        "timestamp_iso": iso,
        "chat": chat,
        "chat_id": row.get("chat_id"),
        "sender": sender,
        "handle": handle,
        "participant": participant,
        "is_from_me": is_from_me,
        "text": msg_text,
        "is_audio_message": is_audio,
        "transcription": transcription,
        "is_edited": is_edited,
        "has_edits": is_edited,
        "edit_count": edit_count,
        "last_edited": last_edited,
        "last_edited_iso": last_edited_iso(edit_history, row.get("date_edited_ns") or 0) if is_edited else None,
        "edit_history": edit_history,
        "attachments": att_list,
        "link_preview": link_preview,
        "balloon_bundle_id": row.get("balloon_bundle_id"),
        "reactions": [],
    }


def reaction_list_item(row, reaction, cmap, prefer_contact_name):
    """Structured tapback. text is null so the Loved/Liked quote is not repeated as a message."""
    item = base_message_fields(row, cmap, prefer_contact_name, {})
    item["kind"] = "reaction"
    item["text"] = None
    item["link_preview"] = None
    item["reactions"] = []
    item["reaction"] = reaction
    return item


def present_rows(cursor, rows, cmap, prefer_contact_name, reactions_mode):
    if not rows:
        return []
    msg_ids = [row["msg_id"] for row in rows]
    attachments_map = fetch_attachments_for_messages(cursor, msg_ids)
    target_guids = []
    for row in rows:
        if classify_associated_type(row.get("associated_message_type")):
            guid = target_guid_from_associated(row.get("associated_message_guid"))
            if guid:
                target_guids.append(guid)
    guid_to_id = lookup_message_guids(cursor, target_guids)
    for row in rows:
        if row.get("guid"):
            guid_to_id.setdefault(row["guid"], row["msg_id"])

    by_id = {}
    by_guid = {}
    for row in rows:
        if classify_associated_type(row.get("associated_message_type")):
            continue
        item = base_message_fields(row, cmap, prefer_contact_name, attachments_map)
        by_id[item["msg_id"]] = item
        if item.get("guid"):
            by_guid[item["guid"]] = item

    if reactions_mode == "separate":
        items = []
        for row in rows:
            if classify_associated_type(row.get("associated_message_type")):
                reaction = build_reaction_record(row, cmap, prefer_contact_name, guid_to_id)
                items.append(reaction_list_item(row, reaction, cmap, prefer_contact_name))
            else:
                items.append(by_id[row["msg_id"]])
        return items

    attached_ids = set()
    built_reactions = {}
    for row in rows:
        if not classify_associated_type(row.get("associated_message_type")):
            continue
        reaction = build_reaction_record(row, cmap, prefer_contact_name, guid_to_id)
        built_reactions[row["msg_id"]] = reaction
        target = by_guid.get(reaction.get("target_guid")) if reaction.get("target_guid") else None
        if target is None and reaction.get("target_msg_id") in by_id:
            target = by_id[reaction["target_msg_id"]]
        if target is not None:
            target["reactions"].append(reaction)
            attached_ids.add(row["msg_id"])

    items = []
    for row in rows:
        if classify_associated_type(row.get("associated_message_type")):
            if row["msg_id"] in attached_ids:
                continue
            reaction = built_reactions[row["msg_id"]]
            items.append(reaction_list_item(row, reaction, cmap, prefer_contact_name))
        else:
            items.append(by_id[row["msg_id"]])
    return items


def annotate_batch(items, scanned_rows, since_input):
    emitted = {item["msg_id"] for item in items}
    ordered_rows = sorted(scanned_rows, key=lambda row: row["msg_id"])
    max_id = ordered_rows[-1]["msg_id"] if ordered_rows else since_input
    ordered_items = sorted(items, key=lambda item: item["msg_id"])
    idx = 0
    for item in ordered_items:
        skipped = 0
        while idx < len(ordered_rows) and ordered_rows[idx]["msg_id"] < item["msg_id"]:
            row = ordered_rows[idx]
            if row["msg_id"] not in emitted and classify_associated_type(row.get("associated_message_type")):
                skipped += 1
            idx += 1
        item["skipped_before"] = {"reaction": skipped}
        item["next_since_msg_id"] = max_id
        if idx < len(ordered_rows) and ordered_rows[idx]["msg_id"] == item["msg_id"]:
            idx += 1
    filtered = 0
    for row in ordered_rows:
        if row["msg_id"] not in emitted and classify_associated_type(row.get("associated_message_type")):
            filtered += 1
    return {"reaction": filtered}, max_id


def emit_read_result(args, items, filtered, next_since, has_more, text_header, text_lines):
    if getattr(args, "json", False):
        if getattr(args, "with_meta", False):
            print(json.dumps({
                "messages": items,
                "filtered": filtered,
                "next_since_msg_id": next_since,
                "has_more": bool(has_more),
            }, indent=2))
        else:
            print(json.dumps(items, indent=2))
        return
    print(text_header)
    print("=" * 85)
    for line in text_lines:
        print(line)


def format_item_line(item, prefix_chat=False):
    if item.get("kind") == "reaction":
        reaction = item.get("reaction") or {}
        emoji = f" {reaction['emoji']}" if reaction.get("emoji") else ""
        target = reaction.get("target_msg_id")
        target_bit = f" -> #{target}" if target else ""
        return (
            f"[{item['timestamp']}] {item['sender']} reaction "
            f"{reaction.get('type')}{emoji} {reaction.get('action')}{target_bit}"
        )
    edit_marker = f" [Edited ({item['edit_count']}x)]" if item.get("is_edited") else ""
    msg_text = item.get("text") or ""
    if item.get("attachments"):
        att_strs = []
        for att in item["attachments"]:
            dur_str = f", duration: {att['duration_formatted']}" if att.get("duration_formatted") else ""
            path_str = f", path: {att['filename']}" if att.get("filename") else ""
            att_strs.append(
                f"[Attachment: {att['transfer_name']} ({att['mime_type']}, {att['size']}{dur_str}{path_str})]"
            )
        att_desc = " ".join(att_strs)
        if msg_text and not msg_text.startswith("[voice note") and msg_text != "<empty message>":
            msg_text = f"{msg_text} {att_desc}".strip()
        elif msg_text.startswith("[voice note"):
            msg_text = f"{msg_text} {att_desc}".strip()
        else:
            msg_text = att_desc or msg_text
    preview = item.get("link_preview")
    if preview:
        bits = [preview.get("title"), preview.get("artist") or preview.get("subtitle"), preview.get("site_name")]
        summary = " | ".join([b for b in bits if b])
        if summary:
            msg_text = f"{msg_text} [link: {summary}]".strip()
    if item.get("reactions"):
        bits = []
        for reaction in item["reactions"]:
            emoji = f" {reaction['emoji']}" if reaction.get("emoji") else ""
            bits.append(f"{reaction['type']}{emoji} {reaction['action']} by {reaction['sender']}")
        msg_text = f"{msg_text} [reactions: {'; '.join(bits)}]"
    chat_bit = f" [{item['chat']}]" if prefix_chat else ""
    return f"[{item['timestamp']}]{edit_marker}{chat_bit} {item['sender']}: {msg_text}"


def reaction_predicate(available):
    if "associated_message_type" not in available:
        return "0"
    return (
        "(COALESCE(m.associated_message_type, 0) BETWEEN 2000 AND 2006 "
        "OR COALESCE(m.associated_message_type, 0) BETWEEN 3000 AND 3006)"
    )


def finish_no_chat(conn, args, target):
    if getattr(args, "json", False):
        if getattr(args, "with_meta", False):
            since = getattr(args, "since_msg_id", None)
            print(json.dumps({
                "messages": [],
                "filtered": {"reaction": 0},
                "next_since_msg_id": since,
                "has_more": False,
            }, indent=2))
        else:
            print(json.dumps([]))
        conn.close()
        return
    print(f"ERROR: No chat found matching '{target}'", file=sys.stderr)
    conn.close()
    sys.exit(1)


def presentation_options(args):
    if getattr(args, "include_filtered", False):
        return "separate"
    mode = getattr(args, "reactions", None) or "attach"
    if mode not in ("attach", "separate"):
        return "attach"
    return mode


def fetch_reactions_for_messages(cursor, select_sql, chat_ids, message_rows, available):
    if "associated_message_type" not in available:
        return []
    guids = [row.get("guid") for row in message_rows if row.get("guid")]
    if not guids:
        return []
    placeholders = chat_placeholders(chat_ids)
    guid_clauses = []
    params = list(chat_ids)
    for guid in guids:
        guid_clauses.append(
            "(m.associated_message_guid = ? OR m.associated_message_guid = ? OR m.associated_message_guid LIKE ?)"
        )
        params.extend([guid, f"bp:{guid}", f"p:%/{guid}"])
    where = (
        f"c.ROWID IN ({placeholders}) AND {reaction_predicate(available)} "
        f"AND ({' OR '.join(guid_clauses)})"
    )
    return fetch_message_dicts(cursor, select_sql, where, params)


def dedupe_rows(rows):
    seen = set()
    ordered = []
    for row in sorted(rows, key=lambda item: item["msg_id"]):
        if row["msg_id"] in seen:
            continue
        seen.add(row["msg_id"])
        ordered.append(row)
    return ordered


def add_read_presentation_args(parser, *, with_limit=False, with_days=False, default_limit=5):
    if with_days:
        parser.add_argument("--days", type=int, default=14, help="Days of history to fetch (default 14)")
    if with_limit:
        parser.add_argument("--limit", type=int, default=default_limit, help=f"Maximum rows to return (default {default_limit})")
    parser.add_argument(
        "--since-msg-id",
        type=int,
        default=None,
        help="Only rows in this chat with ROWID strictly greater than this id (polling cursor)",
    )
    parser.add_argument(
        "--reactions",
        choices=["attach", "separate"],
        default="attach",
        help="Attach tapbacks to the message they target, or list them as structured records",
    )
    parser.add_argument(
        "--include-filtered",
        action="store_true",
        help="Keep filtered rows (tapbacks) inline as structured records so ids are visible",
    )
    parser.add_argument(
        "--with-meta",
        action="store_true",
        help="Wrap JSON as {messages, filtered, next_since_msg_id, has_more}",
    )
    parser.add_argument("--json", action="store_true", help="Output results in JSON format")

def read_messages(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    target = args.chat
    chat_ids = resolve_chat_ids(cursor, target)
    if not chat_ids:
        finish_no_chat(conn, args, target)
        return

    available = message_column_names(cursor)
    select_sql = message_select_list(available)
    placeholders = chat_placeholders(chat_ids)
    now = datetime.datetime.now(datetime.timezone.utc)
    threshold_dt = now - datetime.timedelta(days=args.days)
    threshold_ns = int((threshold_dt - APPLE_EPOCH).total_seconds() * 1_000_000_000)
    where = f"c.ROWID IN ({placeholders}) AND m.date >= ?"
    params = [*chat_ids, threshold_ns]
    since = getattr(args, "since_msg_id", None)
    if since is not None:
        where += " AND m.ROWID > ?"
        params.append(since)
    where += " ORDER BY m.ROWID ASC"
    rows = fetch_message_dicts(cursor, select_sql, where, params)
    mode = presentation_options(args)
    items = present_rows(cursor, rows, None, False, mode)
    filtered, next_since = annotate_batch(items, rows, since)
    header = f"READING MESSAGES FROM THE LAST {args.days} DAYS FOR '{target}' ({len(items)} shown):"
    lines = [format_item_line(item, prefix_chat=True) for item in items]
    emit_read_result(args, items, filtered, next_since, False, header, lines)
    conn.close()

def search_messages(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    query_str = args.query
    limit = args.limit or 30
    available = message_column_names(cursor)
    select_sql = message_select_list(available)
    where = """(
        m.text LIKE ?
        OR (m.text IS NULL AND m.attributedBody LIKE ?)
        OR EXISTS (
            SELECT 1 FROM message_attachment_join maj
            JOIN attachment a ON maj.attachment_id = a.ROWID
            WHERE maj.message_id = m.ROWID AND a.user_info LIKE ?
        )
    )"""
    params = [f"%{query_str}%", f"%{query_str}%", f"%{query_str}%"]
    since = getattr(args, "since_msg_id", None)
    if since is not None:
        where += " AND m.ROWID > ?"
        params.append(since)
    where += " ORDER BY m.date DESC LIMIT ?"
    params.append(int(limit) + 1)
    rows = fetch_message_dicts(cursor, select_sql, where, params)
    has_more = len(rows) > limit
    if has_more:
        rows = rows[:limit]
    mode = presentation_options(args)
    items = present_rows(cursor, rows, None, False, mode)
    filtered, next_since = annotate_batch(items, rows, since)
    header = f"SEARCH RESULTS FOR '{query_str}' ({len(items)} matching messages found):"
    lines = []
    for item in items:
        line = format_item_line(item)
        lines.append(f"{line} [Chat {item.get('chat_id')}: {item.get('chat')}]")
    emit_read_result(args, items, filtered, next_since, has_more, header, lines)
    conn.close()

def search_contacts(args):
    query = (args.query or "").lower()
    ab_paths = glob.glob(os.path.expanduser('~/Library/Application Support/AddressBook/**/*.abcddb'), recursive=True)
    
    contacts = []
    for p in ab_paths:
        try:
            conn = sqlite3.connect(f"file:{p}?mode=ro", uri=True)
            c = conn.cursor()
            sql = """
            SELECT 
                r.ZFIRSTNAME, r.ZLASTNAME, r.ZORGANIZATION,
                p.ZFULLNUMBER, e.ZADDRESS
            FROM ZABCDRECORD r
            LEFT JOIN ZABCDPHONENUMBER p ON r.Z_PK = p.ZOWNER
            LEFT JOIN ZABCDEMAILADDRESS e ON r.Z_PK = e.ZOWNER
            """
            c.execute(sql)
            for fname, lname, org, phone, email in c.fetchall():
                full_name = " ".join(filter(None, [fname, lname]))
                search_target = " ".join(filter(None, [full_name, org, phone, email])).lower()
                if not query or query in search_target:
                    contacts.append({
                        'name': full_name or org or "Unknown",
                        'organization': org or "",
                        'phone': phone or "",
                        'email': email or ""
                    })
            conn.close()
        except Exception:
            pass

    # Deduplicate
    unique = []
    seen = set()
    for c in contacts:
        key = (c['name'], c['phone'], c['email'])
        if key not in seen:
            seen.add(key)
            unique.append(c)

    if getattr(args, 'json', False):
        print(json.dumps(unique, indent=2))
    else:
        print(f"CONTACT RESULTS ({len(unique)} contacts found):")
        print(f"{'Name':<25} | {'Organization':<20} | {'Phone':<18} | {'Email':<25}")
        print("-" * 95)
        for c in unique[:50]:
            print(f"{c['name']:<25} | {c['organization']:<20} | {c['phone']:<18} | {c['email']:<25}")

def get_members(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    target = args.chat
    
    chat_ids = []
    if target.isdigit():
        chat_ids = [int(target)]
    else:
        cursor.execute(
            "SELECT ROWID FROM chat WHERE display_name LIKE ? OR chat_identifier LIKE ?", 
            (f"%{target}%", f"%{target}%")
        )
        chat_ids = [r[0] for r in cursor.fetchall()]
        
    if not chat_ids:
        if getattr(args, 'json', False):
            print(json.dumps([]))
            conn.close()
            return
        print(f"ERROR: No chat found matching '{target}'", file=sys.stderr)
        conn.close()
        sys.exit(1)
        
    placeholders = ",".join(["?"] * len(chat_ids))
    query = f"""
    SELECT 
        c.ROWID,
        COALESCE(c.display_name, ''),
        c.chat_identifier,
        h.id,
        h.service
    FROM chat c
    JOIN chat_handle_join chj ON c.ROWID = chj.chat_id
    JOIN handle h ON chj.handle_id = h.ROWID
    WHERE c.ROWID IN ({placeholders})
    """
    cursor.execute(query, chat_ids)
    rows = cursor.fetchall()
    
    members = []
    for rowid, display_name, chat_ident, handle_id, service in rows:
        name = display_name if display_name else chat_ident
        members.append({
            'chat_id': rowid,
            'display_name': name,
            'handle': handle_id,
            'service': service
        })

    if getattr(args, 'json', False):
        print(json.dumps(members, indent=2))
    else:
        print(f"MEMBERS FOR CHAT '{target}' ({len(members)} members):")
        print(f"{'Chat ID':<8} | {'Chat Name':<25} | {'Handle / Phone':<30} | {'Service':<10}")
        print("-" * 80)
        for m in members:
            print(f"{m['chat_id']:<8} | {m['display_name']:<25} | {m['handle']:<30} | {m['service']:<10}")
    conn.close()

def get_attachment_payload(args):
    filepath = os.path.abspath(os.path.expanduser(args.path))
    if not os.path.exists(filepath):
        print(f"ERROR: Attachment file not found at '{filepath}'", file=sys.stderr)
        sys.exit(1)
        
    target_path = filepath
    mime = "application/octet-stream"
    ext = os.path.splitext(filepath)[1].lower()
    parent_name = os.path.basename(os.path.dirname(filepath)) or "file"
    file_base = os.path.splitext(os.path.basename(filepath))[0]
    
    if ext in ['.heic', '.heif']:
        jpg_path = f"/tmp/imessage_conv_{parent_name}_{file_base}.jpg"
        subprocess.run(['sips', '-s', 'format', 'jpeg', filepath, '--out', jpg_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if os.path.exists(jpg_path):
            target_path = jpg_path
            mime = "image/jpeg"
    elif ext == '.caf':
        m4a_path = f"/tmp/imessage_conv_{parent_name}_{file_base}.m4a"
        afconvert_bin = '/usr/bin/afconvert'
        if os.path.exists(afconvert_bin):
            subprocess.run([afconvert_bin, '-f', 'm4af', '-d', 'aac', filepath, m4a_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if os.path.exists(m4a_path):
                target_path = m4a_path
                mime = "audio/mp4"
            else:
                mime = "audio/x-caf"
        else:
            mime = "audio/x-caf"
    elif ext in ['.m4a', '.mp4']:
        mime = "audio/mp4"
    elif ext == '.wav':
        mime = "audio/wav"
    elif ext == '.mp3':
        mime = "audio/mpeg"
    elif ext == '.aac':
        mime = "audio/aac"
    elif ext in ['.jpg', '.jpeg']:
        mime = "image/jpeg"
    elif ext == '.png':
        mime = "image/png"
    elif ext == '.gif':
        mime = "image/gif"
    elif ext == '.pdf':
        mime = "application/pdf"
    elif ext == '.txt':
        mime = "text/plain"

    is_audio = ext in AUDIO_EXTENSIONS or mime.startswith('audio/')
    dur_sec = get_audio_duration(filepath) if is_audio else None
    dur_fmt = format_duration(dur_sec) if dur_sec is not None else None

    # Try looking up transcription and metadata in chat.db
    transcription = None
    language = None
    try:
        conn = sqlite3.connect(f"file:{get_db_path()}?mode=ro", uri=True)
        c = conn.cursor()
        basename = os.path.basename(filepath)
        normpath = filepath.replace(os.path.expanduser('~'), '~')
        c.execute("""
            SELECT user_info, attribution_info
            FROM attachment
            WHERE filename = ? OR filename = ? OR filename LIKE ?
            ORDER BY (CASE WHEN filename = ? OR filename = ? THEN 0 ELSE 1 END), ROWID DESC LIMIT 1
        """, (filepath, normpath, f"%{basename}", filepath, normpath))
        row = c.fetchone()
        if row and row[0]:
            p = extract_attachment_user_info(row[0])
            transcription = p.get('audio-transcription') or None
            language = p.get('transcription-language') or p.get('language') or None
        conn.close()
    except Exception:
        pass

    with open(target_path, 'rb') as f:
        data = f.read()

    payload = {
        'path': filepath,
        'converted_path': target_path if target_path != filepath else None,
        'mime_type': mime,
        'size_bytes': len(data),
        'base64': base64.b64encode(data).decode('utf-8'),
        'is_audio': bool(is_audio),
        'duration_seconds': dur_sec,
        'duration_formatted': dur_fmt,
        'transcription': transcription,
        'language': language
    }
    
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"File: {filepath}")
        if payload['converted_path']:
            print(f"Converted: {payload['converted_path']}")
        print(f"MIME: {mime} ({len(data)} bytes)")
        if dur_fmt:
            print(f"Duration: {dur_fmt} ({dur_sec}s)")
        if transcription:
            print(f"Transcription: {transcription}")
        print(f"Base64 string length: {len(payload['base64'])} characters")

IMSG_UNCERTAIN_MARKERS = ('may_have_completed', 'still_in_flight')
ATTACHMENT_STAGING_DIR = os.path.expanduser("~/Library/Messages/Attachments/imessage-mcp")


def _resolve_chat(recipient):
    """Resolve recipient to (chat_rowid, chat_identifier) via chat.db; falls back to (None, recipient)."""
    try:
        conn = sqlite3.connect(f"file:{get_db_path()}?mode=ro", uri=True)
        c = conn.cursor()
        if recipient.isdigit():
            c.execute("SELECT ROWID, chat_identifier FROM chat WHERE ROWID = ?", (int(recipient),))
        else:
            c.execute("SELECT ROWID, chat_identifier FROM chat WHERE display_name LIKE ? OR chat_identifier = ?", (f"%{recipient}%", recipient))
        row = c.fetchone()
        conn.close()
        if row and row[1]:
            return row[0], row[1]
    except Exception:
        pass
    return None, recipient


def _send_via_imsg(chat_rowid, recipient, message, attachment_path):
    """Send through the imsg CLI. Returns (status, detail) where status is 'sent', 'uncertain', or 'unavailable'."""
    imsg_bin = os.environ.get('IMSG_BIN') or shutil.which('imsg') or '/opt/homebrew/bin/imsg'
    if not os.path.exists(imsg_bin):
        return 'unavailable', 'imsg CLI not installed'

    cmd = [imsg_bin, 'send']
    if chat_rowid is not None:
        cmd += ['--chat-id', str(chat_rowid)]
    else:
        cmd += ['--to', recipient]
    if message:
        cmd += ['--text', message]
    if attachment_path:
        cmd += ['--file', attachment_path]

    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        return 'uncertain', 'imsg send timed out after 180s; outcome unknown, not retrying'

    detail = (res.stderr or res.stdout or '').strip()
    if res.returncode == 0:
        return 'sent', detail
    # imsg reports delivery disposition on failed mutations; anything that may
    # have reached Messages must not be retried on another transport.
    if any(marker in detail for marker in IMSG_UNCERTAIN_MARKERS):
        return 'uncertain', detail
    return 'unavailable', detail or f'imsg exited with code {res.returncode}'


def _stage_attachment(attachment_path):
    """Copy the file into Messages' own attachments dir; its sandbox blocks reads from /tmp, Desktop, etc."""
    os.makedirs(ATTACHMENT_STAGING_DIR, exist_ok=True)
    staged = os.path.join(ATTACHMENT_STAGING_DIR, f"{int(time.time())}_{os.path.basename(attachment_path)}")
    shutil.copy2(attachment_path, staged)
    return staged


def _send_via_applescript(target_ident, recipient, message, attachment_path):
    """Fallback: native AppleScript send. Attachment and text arrive as separate bubbles."""
    script = """on run argv
    set chatIdent to item 1 of argv
    set rawRecipient to item 2 of argv
    set messageText to item 3 of argv
    set filePath to item 4 of argv
    tell application "Messages"
        try
            set targetChat to first chat whose id contains chatIdent or guid contains chatIdent
            if filePath is not "" then send POSIX file filePath to targetChat
            if messageText is not "" then send messageText to targetChat
            return
        on error
        end try
        try
            if filePath is not "" then send POSIX file filePath to buddy chatIdent
            if messageText is not "" then send messageText to buddy chatIdent
            return
        on error
        end try
        if filePath is not "" then send POSIX file filePath to buddy rawRecipient
        if messageText is not "" then send messageText to buddy rawRecipient
    end tell
end run"""
    staged_path = _stage_attachment(attachment_path) if attachment_path else ''
    res = subprocess.run(
        ['osascript', '-e', script, target_ident, recipient, message or '', staged_path],
        capture_output=True, text=True
    )
    if res.returncode != 0:
        print(f"ERROR: AppleScript send failed: {res.stderr or res.stdout}", file=sys.stderr)
        sys.exit(1)


def send_message(args):
    recipient = args.recipient
    message = args.message or ''
    attachment = args.attachment

    attachment_path = None
    if attachment:
        attachment_path = os.path.abspath(os.path.expanduser(attachment))
        if not os.path.exists(attachment_path):
            print(f"ERROR: Attachment file not found at '{attachment_path}'", file=sys.stderr)
            sys.exit(1)

    if not message and not attachment_path:
        print("ERROR: Nothing to send: provide --message and/or --attachment", file=sys.stderr)
        sys.exit(1)

    chat_rowid, target_ident = _resolve_chat(recipient)

    status, detail = _send_via_imsg(chat_rowid, recipient, message, attachment_path)
    if status == 'sent':
        print(f"Message sent to '{recipient}' ({target_ident}) via imsg successfully!")
        return
    if status == 'uncertain':
        print(f"ERROR: imsg send outcome uncertain, not retrying to avoid double-send: {detail}", file=sys.stderr)
        sys.exit(1)

    print(f"imsg unavailable ({detail}); falling back to AppleScript", file=sys.stderr)
    _send_via_applescript(target_ident, recipient, message, attachment_path)
    print(f"Message sent to '{recipient}' ({target_ident}) via AppleScript successfully!")

def get_recent_messages(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    target = args.chat
    limit = getattr(args, "limit", 5) or 5
    chat_ids = resolve_chat_ids(cursor, target)
    if not chat_ids:
        finish_no_chat(conn, args, target)
        return

    available = message_column_names(cursor)
    select_sql = message_select_list(available)
    placeholders = chat_placeholders(chat_ids)
    since = getattr(args, "since_msg_id", None)
    mode = presentation_options(args)
    has_more = False
    if since is not None:
        # One range read: chat_message_join.chat_id plus message.ROWID > cursor.
        # Limit counts raw rows (including tapbacks) so the cursor cannot skip them.
        where = f"c.ROWID IN ({placeholders}) AND m.ROWID > ? ORDER BY m.ROWID ASC LIMIT ?"
        params = [*chat_ids, since, int(limit) + 1]
        rows = fetch_message_dicts(cursor, select_sql, where, params)
        has_more = len(rows) > limit
        if has_more:
            rows = rows[:limit]
    else:
        predicate = reaction_predicate(available)
        # Newest N visible messages. has_more stays false here: this is not a forward page.
        # since_msg_id is what pages forward, and only that path counts raw rows against limit.
        where = f"c.ROWID IN ({placeholders}) AND NOT ({predicate}) ORDER BY m.ROWID DESC LIMIT ?"
        params = [*chat_ids, int(limit)]
        rows = fetch_message_dicts(cursor, select_sql, where, params)
        has_more = False
        rows.reverse()
        if rows:
            rows = dedupe_rows(rows + fetch_reactions_for_messages(
                cursor, select_sql, chat_ids, rows, available
            ))
    cmap = get_contacts_map()
    items = present_rows(cursor, rows, cmap, True, mode)
    filtered, next_since = annotate_batch(items, rows, since)
    header = f"LAST {len(items)} RECENT MESSAGES FOR '{target}':"
    lines = [format_item_line(item) for item in items]
    emit_read_result(args, items, filtered, next_since, has_more, header, lines)
    conn.close()
def get_edit_history(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    msg_id = args.message_id
    available = message_column_names(cursor)
    select_sql = message_select_list(available)
    rows = fetch_message_dicts(cursor, select_sql, "m.ROWID = ? LIMIT 1", (msg_id,), MESSAGE_FROM_LOOSE)
    if not rows:
        if getattr(args, 'json', False):
            print(json.dumps({'error': f'Message #{msg_id} not found'}))
        else:
            print(f"ERROR: Message #{msg_id} not found", file=sys.stderr)
        conn.close()
        sys.exit(1)

    row = rows[0]
    cmap = get_contacts_map()
    attachments_map = fetch_attachments_for_messages(cursor, [row["msg_id"]])
    item = base_message_fields(row, cmap, True, attachments_map)
    history = item["edit_history"]
    if not history:
        history = [{
            'revision': 0,
            'label': 'original',
            'timestamp': item['timestamp'],
            'timestamp_iso': item['timestamp_iso'],
            'text': item['text']
        }]

    result = {
        'msg_id': item['msg_id'],
        'guid': item['guid'],
        'chat_id': item['chat_id'],
        'chat': item['chat'] or 'Unknown',
        'sender': item['sender'],
        'handle': item['handle'],
        'participant': item['participant'],
        'is_from_me': item['is_from_me'],
        'timestamp': item['timestamp'],
        'timestamp_iso': item['timestamp_iso'],
        'is_audio_message': item['is_audio_message'],
        'transcription': item['transcription'],
        'is_edited': item['is_edited'],
        'has_edits': item['has_edits'],
        'edit_count': item['edit_count'],
        'last_edited': item['last_edited'],
        'last_edited_iso': item['last_edited_iso'],
        'current_text': item['text'],
        'edit_history': history,
        'attachments': item['attachments'],
        'link_preview': item['link_preview'],
    }

    if getattr(args, 'json', False):
        print(json.dumps(result, indent=2))
    else:
        if item['is_edited']:
            print(f"EDIT HISTORY FOR MESSAGE #{item['msg_id']} ({item['edit_count']} edits, last edited: {item['last_edited']}):")
            print("=" * 85)
            print(f"Chat: {result['chat']} (ID: {item['chat_id']}) | Sender: {item['sender']} | Current: {item['text']}")
            print("-" * 85)
            for h in history:
                label_display = "[Original]" if h['revision'] == 0 else f"[Edit {h['revision']}]"
                print(f"{label_display:<12} {h['timestamp']}: {h['text']}")
        else:
            print(f"Message #{item['msg_id']} has no edit history (original message only).")
            print("=" * 85)
            print(f"Chat: {result['chat']} | Sender: {item['sender']} | Date: {item['timestamp']}")
            print(f"Text: {item['text']}")
    conn.close()

def edit_message(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    msg_id = args.message_id
    new_text = args.text
    if not new_text or not new_text.strip():
        if getattr(args, 'json', False):
            print(json.dumps({'error': 'Replacement text cannot be empty', 'success': False}))
        else:
            print("ERROR: Replacement text cannot be empty", file=sys.stderr)
        conn.close()
        sys.exit(1)

    query = """
    SELECT 
        m.ROWID,
        m.guid,
        m.date,
        m.is_from_me,
        c.guid,
        c.chat_identifier,
        COALESCE(c.display_name, ''),
        m.text,
        m.message_summary_info
    FROM message m
    JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
    JOIN chat c ON cmj.chat_id = c.ROWID
    WHERE m.ROWID = ?
    LIMIT 1
    """
    cursor.execute(query, (msg_id,))
    row = cursor.fetchone()
    if not row:
        err_msg = f"Message #{msg_id} not found"
        if getattr(args, 'json', False):
            print(json.dumps({'error': err_msg, 'success': False}))
        else:
            print(f"ERROR: {err_msg}", file=sys.stderr)
        conn.close()
        sys.exit(1)

    row_id, message_guid, date_ns, is_from_me, chat_guid, chat_ident, display_name, current_text, summary_blob = row

    if not is_from_me:
        err_msg = f"Cannot edit message #{msg_id}: only outgoing messages sent by you can be edited (this is an incoming message)."
        if getattr(args, 'json', False):
            print(json.dumps({'error': err_msg, 'success': False}))
        else:
            print(f"ERROR: {err_msg}", file=sys.stderr)
        conn.close()
        sys.exit(1)

    # Apple 15-minute edit window check
    apple_epoch = datetime.datetime(2001, 1, 1, tzinfo=datetime.timezone.utc)
    sec = (date_ns or 0) / 1_000_000_000
    msg_dt = apple_epoch + datetime.timedelta(seconds=sec)
    now_dt = datetime.datetime.now(datetime.timezone.utc)
    elapsed_seconds = (now_dt - msg_dt).total_seconds()

    if elapsed_seconds > 900:
        elapsed_mins = int(elapsed_seconds / 60)
        err_msg = f"Cannot edit message #{msg_id}: iMessage only permits editing messages within 15 minutes of sending. This message was sent {elapsed_mins} minutes ago ({msg_dt.astimezone().strftime('%Y-%m-%d %I:%M %p')})."
        if getattr(args, 'json', False):
            print(json.dumps({'error': err_msg, 'success': False}))
        else:
            print(f"ERROR: {err_msg}", file=sys.stderr)
        conn.close()
        sys.exit(1)

    # Edit count check (Apple limits to 5 edits)
    is_ed, count, last_ts, hist = parse_edit_history(summary_blob, 0, date_ns)
    if count >= 5:
        err_msg = f"Cannot edit message #{msg_id}: maximum edit limit of 5 revisions reached."
        if getattr(args, 'json', False):
            print(json.dumps({'error': err_msg, 'success': False}))
        else:
            print(f"ERROR: {err_msg}", file=sys.stderr)
        conn.close()
        sys.exit(1)

    conn.close()

    # Dispatch via imsg
    imsg_bin = os.environ.get('IMSG_BIN') or shutil.which('imsg') or '/opt/homebrew/bin/imsg'
    if not os.path.exists(imsg_bin):
        err_msg = "imsg CLI tool not found at /opt/homebrew/bin/imsg. Install imsg or build the dylib bridge to edit messages."
        if getattr(args, 'json', False):
            print(json.dumps({'error': err_msg, 'success': False}))
        else:
            print(f"ERROR: {err_msg}", file=sys.stderr)
        sys.exit(1)

    target_chat = chat_guid or chat_ident
    cmd = [
        imsg_bin, 'edit',
        '--chat', target_chat,
        '--message', message_guid,
        '--new-text', new_text,
        '--json'
    ]

    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        err_msg = "imsg edit timed out after 30 seconds."
        if getattr(args, 'json', False):
            print(json.dumps({'error': err_msg, 'success': False}))
        else:
            print(f"ERROR: {err_msg}", file=sys.stderr)
        sys.exit(1)

    stdout_str = (res.stdout or '').strip()
    stderr_str = (res.stderr or '').strip()

    if res.returncode == 0:
        if getattr(args, 'json', False):
            try:
                parsed = json.loads(stdout_str)
                print(json.dumps(parsed, indent=2))
            except Exception:
                print(json.dumps({
                    'success': True,
                    'msg_id': msg_id,
                    'message_guid': message_guid,
                    'new_text': new_text,
                    'output': stdout_str
                }, indent=2))
        else:
            print(f"Message #{msg_id} edited successfully to: '{new_text}'")
        return

    # Handle error from imsg
    err_detail = stderr_str or stdout_str or f"imsg exited with code {res.returncode}"
    is_sip_blocked = 'SIP' in err_detail or 'bridge' in err_detail or 'not_started' in err_detail

    if getattr(args, 'json', False):
        if is_sip_blocked:
            print(json.dumps({
                'success': False,
                'bridge_available': False,
                'msg_id': msg_id,
                'message_guid': message_guid,
                'chat': chat_ident,
                'display_name': display_name or "",
                'original_text': current_text or "",
                'suggested_text': new_text,
                'error': "Messages edit bridge is unavailable because System Integrity Protection (SIP) is enabled on the host Mac. Apple does not support message editing via AppleScript.",
                'fallback_recommendation': "Instruct the user to edit the message manually on their device using suggested_text, or call imessage_send_message to send a follow-up correction."
            }, indent=2))
            return
        else:
            print(json.dumps({'error': err_detail, 'success': False}, indent=2))
            sys.exit(1)
    else:
        if is_sip_blocked:
            print("NOTICE: Messages edit bridge is unavailable because System Integrity Protection (SIP) is enabled on this Mac. Apple does not support message editing via AppleScript.", file=sys.stderr)
            print(f"Suggested text for manual edit: '{new_text}'", file=sys.stderr)
        else:
            print(f"ERROR: Failed to edit message #{msg_id}: {err_detail}", file=sys.stderr)
        sys.exit(1)

def search_group_chats(args):
    raw_participants = args.participants
    if isinstance(raw_participants, str):
        query_participants = [p.strip() for p in raw_participants.split(',') if p.strip()]
    elif isinstance(raw_participants, list):
        query_participants = raw_participants
    else:
        query_participants = []

    conn = get_db_connection()
    cursor = conn.cursor()
    cmap = get_contacts_map()

    cursor.execute("SELECT ROWID, COALESCE(display_name, ''), chat_identifier FROM chat")
    chats = cursor.fetchall()

    matching_chats = []
    for rowid, display_name, identifier in chats:
        cursor.execute("""
            SELECT h.id
            FROM chat_handle_join chj
            JOIN handle h ON chj.handle_id = h.ROWID
            WHERE chj.chat_id = ?
        """, (rowid,))
        handles = [r[0] for r in cursor.fetchall()]

        participants = []
        participant_search_space = []
        for h in handles:
            norm = normalize_handle(h)
            pname = cmap.get(norm, h)
            participants.append({'name': pname, 'handle': h})
            participant_search_space.append(f"{pname} {h}".lower())

        # Check if ALL requested queries match at least one participant in this chat
        all_matched = True
        for q in query_participants:
            q_lower = q.lower()
            found = any(q_lower in search_str for search_str in participant_search_space)
            if not found:
                all_matched = False
                break

        if all_matched and (handles or display_name):
            name = display_name if display_name else ", ".join([p['name'] for p in participants])
            matching_chats.append({
                'rowid': rowid,
                'display_name': display_name,
                'name': name,
                'identifier': identifier,
                'participants': participants
            })

    if getattr(args, 'json', False):
        print(json.dumps(matching_chats, indent=2))
    else:
        print(f"SEARCH GROUP CHATS MATCHING {query_participants} ({len(matching_chats)} chats found):")
        print("=" * 85)
        for c in matching_chats:
            print(f"[{c['rowid']}] {c['name']} ({c['identifier']})")
    conn.close()

def main():
    parser = argparse.ArgumentParser(description="iMessage CLI tool for macOS")
    subparsers = parser.add_subparsers(dest="command", required=True)
    
    list_parser = subparsers.add_parser("list", help="List active iMessage chats")
    list_parser.add_argument("--limit", type=int, default=30, help="Number of chats to list (default 30)")
    list_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    list_parser.set_defaults(func=list_chats)
    
    read_parser = subparsers.add_parser("read", help="Read recent messages from a chat")
    read_parser.add_argument("chat", help="Numeric chat ROWID (list/chat_id), display name, phone number, or email")
    add_read_presentation_args(read_parser, with_days=True)
    read_parser.set_defaults(func=read_messages)

    recent_parser = subparsers.add_parser("recent", help="Get recent messages preview")
    recent_parser.add_argument("chat", help="Numeric chat ROWID (list/chat_id), display name, phone number, or email")
    add_read_presentation_args(recent_parser, with_limit=True)
    recent_parser.set_defaults(func=get_recent_messages)

    search_parser = subparsers.add_parser("search", help="Search message history")
    search_parser.add_argument("query", help="Search keyword or phrase")
    add_read_presentation_args(search_parser, with_limit=True, default_limit=30)
    search_parser.set_defaults(func=search_messages)

    search_group_parser = subparsers.add_parser("search-group", help="Search group chats by participant names/handles")
    search_group_parser.add_argument("participants", nargs="+", help="Participant names or phone numbers")
    search_group_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    search_group_parser.set_defaults(func=search_group_chats)

    contacts_parser = subparsers.add_parser("contacts", help="Search macOS contacts")
    contacts_parser.add_argument("query", nargs="?", default="", help="Name, phone number, or email search query")
    contacts_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    contacts_parser.set_defaults(func=search_contacts)

    members_parser = subparsers.add_parser("members", help="Get members of a group chat")
    members_parser.add_argument("chat", help="Chat ID or chat identifier")
    members_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    members_parser.set_defaults(func=get_members)

    attachment_parser = subparsers.add_parser("attachment", help="Get base64/multimodal attachment payload")
    attachment_parser.add_argument("path", help="POSIX path to attachment file")
    attachment_parser.add_argument("--json", action="store_true", help="Output JSON with base64 data")
    attachment_parser.set_defaults(func=get_attachment_payload)

    send_parser = subparsers.add_parser("send", help="Send an iMessage")
    send_parser.add_argument("recipient", help="Recipient identifier")
    send_parser.add_argument("--message", "-m", help="Message text body")
    send_parser.add_argument("--attachment", "-a", help="POSIX path to attachment file")
    send_parser.set_defaults(func=send_message)

    edits_parser = subparsers.add_parser("edits", help="View edit and rewrite history for a message")
    edits_parser.add_argument("message_id", type=int, help="Message ROWID")
    edits_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    edits_parser.set_defaults(func=get_edit_history)

    edit_parser = subparsers.add_parser("edit", help="Edit a previously sent iMessage")
    edit_parser.add_argument("message_id", type=int, help="Message ROWID to edit")
    edit_parser.add_argument("--text", "-t", required=True, help="New replacement message text")
    edit_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    edit_parser.set_defaults(func=edit_message)
    
    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
