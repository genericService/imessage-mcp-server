def get_db_path():
    """chat.db path. IMESSAGE_DB_PATH overrides the macOS default (used by tests)."""
    override = os.environ.get("IMESSAGE_DB_PATH")
    if override:
        return os.path.expanduser(override)
    return os.path.expanduser("~/Library/Messages/chat.db")

def get_db_connection():
    db_path = get_db_path()
    if not os.path.exists(db_path):
        print(f"ERROR: iMessage database not found at {db_path}", file=sys.stderr)
        sys.exit(1)
    try:
        return sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    except Exception as e:
        print(f"ERROR: Could not open database in read-only mode: {e}", file=sys.stderr)
        sys.exit(1)

def get_call_history_db_path():
    """CallHistory.storedata path. CALL_HISTORY_DB_PATH overrides the macOS default (used by tests)."""
    override = os.environ.get("CALL_HISTORY_DB_PATH")
    if override:
        return os.path.expanduser(override)
    return os.path.expanduser("~/Library/Application Support/CallHistoryDB/CallHistory.storedata")

def get_call_history_connection():
    db_path = get_call_history_db_path()
    if not os.path.exists(db_path):
        return None, f"Call history database not found at {db_path}. Ensure Full Disk Access is granted or iPhone call syncing is enabled."
    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        return conn, None
    except Exception as e:
        return None, f"Could not open call history database in read-only mode ({e}). Check Full Disk Access permissions."

INDEX_SCHEMA_VERSION = 1

def get_mcp_home_dir():
    override = os.environ.get("IMESSAGE_MCP_DIR")
    if override and override.strip():
        p = os.path.abspath(os.path.expanduser(override.strip()))
    else:
        p = os.path.expanduser("~/.imessage-mcp")
    if not os.path.exists(p):
        os.makedirs(p, mode=0o700, exist_ok=True)
    try:
        os.chmod(p, 0o700)
    except Exception:
        pass
    return p

def get_transcribe_models_dir():
    override = os.environ.get("TRANSCRIBE_MODELS_DIR")
    if override and override.strip():
        p = os.path.abspath(os.path.expanduser(override.strip()))
    else:
        p = os.path.join(get_mcp_home_dir(), "models")
    if not os.path.exists(p):
        os.makedirs(p, mode=0o700, exist_ok=True)
    try:
        os.chmod(p, 0o700)
    except Exception:
        pass
    return p

def get_index_db_path():
    override = os.environ.get("INDEX_DB_PATH")
    if override and override.strip():
        return os.path.abspath(os.path.expanduser(override.strip()))
    return os.path.join(get_mcp_home_dir(), "index.db")

def get_transcripts_db_path():
    if is_index_enabled():
        return get_index_db_path()
    return os.path.join(get_mcp_home_dir(), "transcripts.db")

def ensure_transcripts_table(conn):
    conn.execute("""
        CREATE TABLE IF NOT EXISTS transcripts (
            cache_key TEXT PRIMARY KEY,
            attachment_guid TEXT,
            attachment_path TEXT,
            file_size INTEGER,
            file_mtime REAL,
            transcription TEXT,
            language TEXT,
            engine TEXT,
            duration_seconds REAL,
            segments_json TEXT,
            created_at TEXT
        );
    """)
    conn.execute("CREATE INDEX IF NOT EXISTS idx_transcripts_guid ON transcripts(attachment_guid);")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_transcripts_path ON transcripts(attachment_path);")

def get_transcripts_db_connection(read_only=False):
    db_path = get_transcripts_db_path()
    if read_only:
        if not os.path.exists(db_path):
            return None
        uri = f"file:{db_path}?mode=ro"
        try:
            return sqlite3.connect(uri, uri=True)
        except Exception:
            return None
    ensure_index_dir_and_permissions(db_path)
    conn = sqlite3.connect(db_path)
    conn.execute("PRAGMA journal_mode = WAL")
    conn.execute("PRAGMA synchronous = NORMAL")
    ensure_transcripts_table(conn)
    conn.commit()
    try:
        os.chmod(db_path, 0o600)
    except Exception:
        pass
    return conn

def _query_transcript_row(conn, guid, filepath, file_size, file_mtime):
    if not conn:
        return None
    try:
        c = conn.cursor()
        ensure_transcripts_table(conn)
        row = None
        if guid:
            c.execute("""
                SELECT transcription, language, engine, duration_seconds, segments_json, file_size, file_mtime
                FROM transcripts WHERE attachment_guid = ? LIMIT 1
            """, (guid,))
            row = c.fetchone()
        if not row and filepath:
            c.execute("""
                SELECT transcription, language, engine, duration_seconds, segments_json, file_size, file_mtime
                FROM transcripts WHERE attachment_path = ? LIMIT 1
            """, (os.path.abspath(filepath),))
            row = c.fetchone()
        if not row and filepath:
            basename = os.path.basename(filepath)
            c.execute("""
                SELECT transcription, language, engine, duration_seconds, segments_json, file_size, file_mtime
                FROM transcripts WHERE attachment_path LIKE ? ORDER BY ROWID DESC LIMIT 1
            """, (f"%{basename}",))
            row = c.fetchone()
        if not row:
            return None

        txt, lang, eng, dur, segs_json, c_size, c_mtime = row
        if file_size is not None and c_size is not None and abs(c_size - file_size) > 0:
            return None
        if file_mtime is not None and c_mtime is not None and abs(c_mtime - file_mtime) > 1.0:
            return None

        segments = None
        if segs_json:
            try:
                segments = json.loads(segs_json)
            except Exception:
                segments = None

        return {
            "transcription": txt,
            "language": lang,
            "engine": eng,
            "duration_seconds": dur,
            "segments": segments
        }
    except Exception:
        return None

def get_cached_transcript(guid=None, filepath=None, file_size=None, file_mtime=None):
    conn = get_transcripts_db_connection(read_only=True)
    res = None
    if conn:
        try:
            res = _query_transcript_row(conn, guid, filepath, file_size, file_mtime)
        finally:
            try:
                conn.close()
            except Exception:
                pass

    if res is not None:
        return res

    if is_index_enabled():
        standalone = os.path.join(get_mcp_home_dir(), "transcripts.db")
        if os.path.exists(standalone) and os.path.abspath(standalone) != os.path.abspath(get_transcripts_db_path()):
            try:
                s_conn = sqlite3.connect(f"file:{standalone}?mode=ro", uri=True)
                res = _query_transcript_row(s_conn, guid, filepath, file_size, file_mtime)
                s_conn.close()
                if res is not None:
                    save_cached_transcript(
                        guid=guid, filepath=filepath, file_size=file_size, file_mtime=file_mtime,
                        transcription=res["transcription"], language=res["language"],
                        engine=res["engine"], duration_seconds=res["duration_seconds"],
                        segments=res.get("segments")
                    )
                    return res
            except Exception:
                pass
    return None

def save_cached_transcript(guid, filepath, file_size, file_mtime, transcription, language, engine, duration_seconds, segments=None, msg_id=None):
    conn = get_transcripts_db_connection(read_only=False)
    if not conn:
        return
    try:
        c = conn.cursor()
        ensure_transcripts_table(conn)
        abs_path = os.path.abspath(filepath) if filepath else None
        key = f"{guid or abs_path}:{file_size}:{file_mtime}"
        segs_json = json.dumps(segments) if segments else None
        now_iso = datetime.datetime.now(datetime.timezone.utc).isoformat()
        c.execute("""
            INSERT OR REPLACE INTO transcripts (
                cache_key, attachment_guid, attachment_path, file_size, file_mtime,
                transcription, language, engine, duration_seconds, segments_json, created_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            key, guid, abs_path,
            file_size, file_mtime, transcription, language, engine,
            duration_seconds, segs_json, now_iso
        ))
        conn.commit()

        if is_index_enabled():
            target_msg_id = msg_id
            if target_msg_id is None and (guid or filepath):
                try:
                    c.execute("""
                        SELECT msg_id FROM attachments_idx
                        WHERE path = ? OR filename = ? LIMIT 1
                    """, (abs_path, os.path.basename(filepath)))
                    m_row = c.fetchone()
                    if m_row:
                        target_msg_id = m_row[0]
                except Exception:
                    pass

            if target_msg_id is not None:
                try:
                    c.execute("SELECT text_decoded FROM messages_idx WHERE msg_id = ?", (target_msg_id,))
                    t_row = c.fetchone()
                    if t_row is not None:
                        current = t_row[0] or ""
                        if transcription and transcription not in current:
                            updated_text = f"{current} {transcription}".strip() if current else transcription
                            c.execute("UPDATE messages_idx SET text_decoded = ? WHERE msg_id = ?", (updated_text, target_msg_id))
                            conn.commit()
                except Exception:
                    pass
    except Exception:
        pass
    finally:
        try:
            conn.close()
        except Exception:
            pass

def find_whisper_bin():
    override = os.environ.get("TRANSCRIBE_WHISPER_BIN")
    if override:
        p = os.path.abspath(os.path.expanduser(override))
        if os.path.exists(p) and os.access(p, os.X_OK):
            return p
        return None
    for b in ("whisper-cli", "whisper-cpp"):
        p = shutil.which(b)
        if p and os.access(p, os.X_OK):
            return p
    for p in ("/opt/homebrew/bin/whisper-cli", "/usr/local/bin/whisper-cli", "/opt/homebrew/bin/whisper-cpp"):
        if os.path.exists(p) and os.access(p, os.X_OK):
            return p
    return None

def download_whisper_model(model_name=DEFAULT_TRANSCRIBE_MODEL, dest_dir=None, force=False):
    clean_name = model_name.lower().replace("ggml-", "").replace(".bin", "")
    if clean_name not in MODEL_REGISTRY:
        sys.stderr.write(f"[Transcribe] Error: Unknown model '{model_name}'. Available: {', '.join(MODEL_REGISTRY.keys())}\n")
        return False

    meta = MODEL_REGISTRY[clean_name]
    target_dir = dest_dir or get_transcribe_models_dir()
    os.makedirs(target_dir, mode=0o700, exist_ok=True)
    target_path = os.path.join(target_dir, meta["filename"])

    if os.path.exists(target_path) and not force:
        h = hashlib.sha256()
        with open(target_path, "rb") as f:
            while chunk := f.read(65536):
                h.update(chunk)
        if h.hexdigest() == meta["sha256"]:
            return True

    tmp_path = f"{target_path}.tmp"
    url = meta["url"]
    expected_size = meta["size"]
    expected_sha = meta["sha256"]

    sys.stderr.write(f"[Transcribe] Downloading {clean_name} ({expected_size / 1024 / 1024:.1f} MB)...\n")
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "imessage-mcp-server/1.14.0"})
        with urllib.request.urlopen(req) as resp, open(tmp_path, "wb") as out_file:
            hasher = hashlib.sha256()
            while True:
                chunk = resp.read(131072)
                if not chunk:
                    break
                out_file.write(chunk)
                hasher.update(chunk)

        actual_sha = hasher.hexdigest()
        if actual_sha != expected_sha:
            sys.stderr.write(f"[Transcribe] Checksum mismatch for {clean_name}\n")
            if os.path.exists(tmp_path):
                os.remove(tmp_path)
            return False

        os.replace(tmp_path, target_path)
        os.chmod(target_path, 0o600)
        sys.stderr.write(f"[Transcribe] Downloaded and verified model: {target_path}\n")
        return True
    except Exception as e:
        sys.stderr.write(f"[Transcribe] Download failed: {e}\n")
        if os.path.exists(tmp_path):
            os.remove(tmp_path)
        return False

def find_whisper_model():
    explicit_path = os.environ.get("TRANSCRIBE_MODEL_PATH")
    if explicit_path:
        p = os.path.abspath(os.path.expanduser(explicit_path))
        if os.path.exists(p) and os.path.getsize(p) > 0:
            return p
        return None

    whisper_bin = os.environ.get("TRANSCRIBE_WHISPER_BIN", "")
    if "mock" in whisper_bin.lower():
        return "/tmp/mock_model.bin"

    model_name = os.environ.get("TRANSCRIBE_MODEL", DEFAULT_TRANSCRIBE_MODEL)
    clean_name = model_name.lower().replace("ggml-", "").replace(".bin", "")
    models_dir = get_transcribe_models_dir()

    search_dirs = [models_dir]
    default_dir = os.path.expanduser("~/.imessage-mcp/models")
    if default_dir not in search_dirs:
        search_dirs.append(default_dir)

    for d in search_dirs:
        candidates = [
            os.path.join(d, f"ggml-{clean_name}.bin"),
            os.path.join(d, f"{clean_name}.bin"),
            os.path.join(d, clean_name),
        ]
        for c in candidates:
            if os.path.exists(c) and os.path.getsize(c) > 0:
                return c

    # Fallback to any existing model in the directory if default not found
    for d in search_dirs:
        if os.path.exists(d):
            for f in os.listdir(d):
                if f.endswith(".bin") and f.startswith("ggml-"):
                    fp = os.path.join(d, f)
                    if os.path.getsize(fp) > 0:
                        return fp

    auto_dl = os.environ.get("TRANSCRIBE_AUTO_DOWNLOAD", "").lower() in ("true", "1")
    if auto_dl:
        ok = download_whisper_model(model_name=clean_name, dest_dir=models_dir)
        if ok:
            target = os.path.join(models_dir, f"ggml-{clean_name}.bin")
            if os.path.exists(target):
                return target
    return None

def prepare_audio_for_transcription(audio_path):
    temp_dir = tempfile.mkdtemp(prefix="imsg_transcribe_")
    try:
        os.chmod(temp_dir, 0o700)
    except Exception:
        pass
    wav_path = os.path.join(temp_dir, "audio_16k.wav")

    def cleanup():
        try:
            shutil.rmtree(temp_dir, ignore_errors=True)
        except Exception:
            pass

    try:
        afconvert_bin = "/usr/bin/afconvert"
        if os.path.exists(afconvert_bin):
            res = subprocess.run([
                afconvert_bin, "-f", "WAVE", "-d", "LEI16@16000", "-c", "1",
                audio_path, wav_path
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode == 0 and os.path.exists(wav_path) and os.path.getsize(wav_path) > 0:
                return wav_path, cleanup

        ffmpeg_bin = shutil.which("ffmpeg")
        if ffmpeg_bin:
            res = subprocess.run([
                ffmpeg_bin, "-y", "-i", audio_path, "-ar", "16000", "-ac", "1", wav_path
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode == 0 and os.path.exists(wav_path) and os.path.getsize(wav_path) > 0:
                return wav_path, cleanup
    except Exception:
        pass
    return None, cleanup

def run_whisper_transcription(wav_path, duration_seconds, whisper_bin=None, model_path=None):
    if not whisper_bin:
        whisper_bin = find_whisper_bin()
    if not model_path:
        model_path = find_whisper_model()
    if not whisper_bin or not model_path:
        return None, None, None, "engine_unavailable"

    out_prefix = os.path.join(os.path.dirname(wav_path), "whisper_out")
    lang_hints = os.environ.get("TRANSCRIBE_LANGUAGES", DEFAULT_TRANSCRIBE_LANGUAGES).strip()
    lang_arg = "auto"
    if lang_hints and "," not in lang_hints:
        lang_arg = lang_hints

    cmd = [
        whisper_bin,
        "-m", model_path,
        "-f", wav_path,
        "-l", lang_arg,
        "-oj",
        "-of", out_prefix,
        "-np",
        "-nt"
    ]

    job_timeout = float(os.environ.get("TRANSCRIBE_JOB_TIMEOUT_SECONDS", str(DEFAULT_TRANSCRIBE_JOB_TIMEOUT_SECONDS)))
    start_time = time.time()
    try:
        def preexec():
            try:
                os.nice(15)
            except Exception:
                pass

        res = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=job_timeout,
            preexec_fn=preexec if hasattr(os, "nice") else None
        )
        elapsed = time.time() - start_time
        if res.returncode != 0:
            sys.stderr.write(f"[Transcribe] whisper process exited with code {res.returncode}\n")
            return None, None, None, "failed"

        out_json = f"{out_prefix}.json"
        if not os.path.exists(out_json):
            return None, None, None, "failed"

        with open(out_json, "r", encoding="utf-8") as f:
            data = json.load(f)

        detected_lang = data.get("result", {}).get("language") or "es"
        raw_segments = data.get("transcription", [])
        text_parts = []
        segments = []
        for seg in raw_segments:
            seg_text = seg.get("text", "").strip()
            if seg_text:
                text_parts.append(seg_text)
            offsets = seg.get("offsets", {})
            start_sec = round(offsets.get("from", 0) / 1000.0, 2)
            end_sec = round(offsets.get("to", 0) / 1000.0, 2)
            segments.append({
                "start": start_sec,
                "end": end_sec,
                "text": seg_text
            })

        full_text = " ".join(text_parts).strip()
        dur_display = duration_seconds if duration_seconds is not None else 0.0
        sys.stderr.write(f"[Transcribe] whisper transcribed {dur_display:.1f}s audio in {elapsed:.2f}s (lang: {detected_lang})\n")
        return full_text, detected_lang, segments, "ok"
    except subprocess.TimeoutExpired:
        sys.stderr.write(f"[Transcribe] whisper timed out after {job_timeout}s\n")
        return None, None, None, "failed"
    except Exception as e:
        sys.stderr.write(f"[Transcribe] whisper execution failed: {type(e).__name__}\n")
        return None, None, None, "failed"

def run_apple_speech_transcription(wav_path, duration_seconds):
    helper_path = os.path.join(os.path.dirname(__file__), "apple-speech-transcribe.swift")
    if not os.path.exists(helper_path) or not os.path.exists("/usr/bin/swift"):
        return None, None, None, "engine_unavailable"

    lang_hints = os.environ.get("TRANSCRIBE_LANGUAGES", "es-MX,es,en-US,en")
    cmd = ["/usr/bin/swift", helper_path, wav_path, lang_hints]
    job_timeout = float(os.environ.get("TRANSCRIBE_JOB_TIMEOUT_SECONDS", str(DEFAULT_TRANSCRIBE_JOB_TIMEOUT_SECONDS)))
    start_time = time.time()
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=job_timeout)
        elapsed = time.time() - start_time
        if res.returncode == 2 or res.returncode == 3:
            sys.stderr.write(f"[Transcribe] Apple Speech unavailable (code {res.returncode})\n")
            return None, None, None, "engine_unavailable"
        if res.returncode != 0:
            return None, None, None, "failed"

        data = json.loads(res.stdout)
        text = data.get("transcription")
        lang = data.get("language")
        segs = data.get("segments", [])
        dur_display = duration_seconds if duration_seconds is not None else 0.0
        sys.stderr.write(f"[Transcribe] apple_speech transcribed {dur_display:.1f}s audio in {elapsed:.2f}s (lang: {lang})\n")
        return text, lang, segs, "ok"
    except subprocess.TimeoutExpired:
        return None, None, None, "failed"
    except Exception:
        return None, None, None, "failed"

def transcribe_audio_with_lock(filepath, guid=None, msg_id=None, with_segments=False):
    dur_sec = get_audio_duration(filepath)
    max_sec = float(os.environ.get("TRANSCRIBE_MAX_SECONDS", str(DEFAULT_TRANSCRIBE_MAX_SECONDS)))
    if dur_sec is not None and dur_sec > max_sec:
        sys.stderr.write(f"[Transcribe] Audio duration ({dur_sec:.1f}s) exceeds TRANSCRIBE_MAX_SECONDS ({max_sec:.1f}s), skipping\n")
        return None, None, None, None, "too_long"

    engine_choice = os.environ.get("TRANSCRIBE_ENGINE", "whisper").strip().lower()
    if engine_choice == "apple":
        helper_path = os.path.join(os.path.dirname(__file__), "apple-speech-transcribe.swift")
        if not os.path.exists(helper_path) or not os.path.exists("/usr/bin/swift"):
            return None, None, None, None, "engine_unavailable"
    else:
        w_bin = find_whisper_bin()
        w_model = find_whisper_model()
        if not w_bin or not w_model:
            return None, None, None, None, "engine_unavailable"

    lock_dir = get_mcp_home_dir()
    lock_file = os.path.join(lock_dir, "transcribe.lock")
    wait_ms = int(os.environ.get("TRANSCRIBE_WAIT_MS", str(DEFAULT_TRANSCRIBE_WAIT_MS)))

    fd = os.open(lock_file, os.O_CREAT | os.O_RDWR, 0o600)
    start_wait = time.time()
    acquired = False
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            acquired = True
            break
        except (BlockingIOError, IOError):
            if (time.time() - start_wait) * 1000.0 >= wait_ms:
                break
            time.sleep(0.05)

    if not acquired:
        os.close(fd)
        return None, None, None, None, "pending"

    try:
        st = None
        try:
            st = os.stat(filepath)
        except Exception:
            pass
        f_size = st.st_size if st else None
        f_mtime = st.st_mtime if st else None
        cached = get_cached_transcript(guid=guid, filepath=filepath, file_size=f_size, file_mtime=f_mtime)
        if cached and cached.get("transcription"):
            return (
                cached["transcription"],
                cached.get("language"),
                cached.get("engine"),
                cached.get("segments"),
                "ok"
            )

        wav_path, cleanup = prepare_audio_for_transcription(filepath)
        if not wav_path or not os.path.exists(wav_path):
            cleanup()
            return None, None, None, None, "failed"

        try:
            if engine_choice == "apple":
                txt, lang, segs, status = run_apple_speech_transcription(wav_path, dur_sec)
                eng_name = "apple_speech"
            else:
                txt, lang, segs, status = run_whisper_transcription(wav_path, dur_sec, whisper_bin=w_bin, model_path=w_model)
                eng_name = "whisper"

            if status == "ok" and txt:
                save_cached_transcript(
                    guid, filepath, f_size, f_mtime,
                    txt, lang, eng_name, dur_sec,
                    segments=segs, msg_id=msg_id
                )
                return txt, lang, eng_name, segs, "ok"
            else:
                return None, None, None, None, status
        finally:
            cleanup()
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
            os.close(fd)
        except Exception:
            pass

def is_index_enabled():
    val = os.environ.get("INDEX_ENABLED", "").strip().lower()
    return val in ("true", "1", "yes")

def get_recheck_days():
    raw = os.environ.get("INDEX_RECHECK_DAYS")
    if raw and raw.strip():
        try:
            return max(1, int(raw.strip()))
        except ValueError:
            pass
    return 14

def ensure_index_dir_and_permissions(db_path):
    dir_path = os.path.dirname(db_path)
    if not os.path.exists(dir_path):
        os.makedirs(dir_path, mode=0o700, exist_ok=True)
    try:
        os.chmod(dir_path, 0o700)
    except Exception:
        pass
    if os.path.exists(db_path):
        try:
            os.chmod(db_path, 0o600)
        except Exception:
            pass

def get_index_db_connection(read_only=False):
    db_path = get_index_db_path()
    if read_only:
        if not os.path.exists(db_path):
            return None
        uri = f"file:{db_path}?mode=ro"
        return sqlite3.connect(uri, uri=True)
    ensure_index_dir_and_permissions(db_path)
    conn = sqlite3.connect(db_path)
    conn.execute("PRAGMA journal_mode = WAL")
    conn.execute("PRAGMA synchronous = NORMAL")
    ensure_transcripts_table(conn)
    try:
        os.chmod(db_path, 0o600)
    except Exception:
        pass
    return conn

def init_index_schema(conn, force=False):
    c = conn.cursor()
    if force:
        c.executescript("""
            DROP TRIGGER IF EXISTS messages_idx_ai;
            DROP TRIGGER IF EXISTS messages_idx_ad;
            DROP TRIGGER IF EXISTS messages_idx_au;
            DROP TABLE IF EXISTS messages_fts;
            DROP TABLE IF EXISTS messages_idx;
            DROP TABLE IF EXISTS attachments_idx;
            DROP TABLE IF EXISTS contacts_idx;
            DROP TABLE IF EXISTS transcripts;
            DROP TABLE IF EXISTS meta;
        """)

    c.executescript("""
        CREATE TABLE IF NOT EXISTS messages_idx (
            msg_id INTEGER PRIMARY KEY,
            guid TEXT,
            chat_id INTEGER,
            handle_id INTEGER,
            is_from_me INTEGER,
            date INTEGER,
            date_unix INTEGER,
            item_type INTEGER,
            has_attachments INTEGER,
            text_decoded TEXT
        );
        CREATE INDEX IF NOT EXISTS idx_messages_idx_chat_id ON messages_idx(chat_id);
        CREATE INDEX IF NOT EXISTS idx_messages_idx_date_unix ON messages_idx(date_unix);
        CREATE INDEX IF NOT EXISTS idx_messages_idx_date ON messages_idx(date);

        CREATE VIRTUAL TABLE IF NOT EXISTS messages_fts USING fts5(
            text_decoded,
            content='messages_idx',
            content_rowid='msg_id',
            tokenize="unicode61 remove_diacritics 2"
        );

        CREATE TRIGGER IF NOT EXISTS messages_idx_ai AFTER INSERT ON messages_idx BEGIN
            INSERT INTO messages_fts(rowid, text_decoded) VALUES (new.msg_id, new.text_decoded);
        END;

        CREATE TRIGGER IF NOT EXISTS messages_idx_ad AFTER DELETE ON messages_idx BEGIN
            INSERT INTO messages_fts(messages_fts, rowid, text_decoded) VALUES('delete', old.msg_id, old.text_decoded);
        END;

        CREATE TRIGGER IF NOT EXISTS messages_idx_au AFTER UPDATE ON messages_idx BEGIN
            INSERT INTO messages_fts(messages_fts, rowid, text_decoded) VALUES('delete', old.msg_id, old.text_decoded);
            INSERT INTO messages_fts(rowid, text_decoded) VALUES (new.msg_id, new.text_decoded);
        END;

        CREATE TABLE IF NOT EXISTS attachments_idx (
            attachment_id INTEGER,
            msg_id INTEGER,
            filename TEXT,
            transfer_name TEXT,
            mime_type TEXT,
            uti TEXT,
            total_bytes INTEGER,
            path TEXT,
            PRIMARY KEY (attachment_id, msg_id)
        );
        CREATE INDEX IF NOT EXISTS idx_attachments_idx_msg_id ON attachments_idx(msg_id);

        CREATE TABLE IF NOT EXISTS contacts_idx (
            handle TEXT PRIMARY KEY,
            display_name TEXT
        );

        CREATE TABLE IF NOT EXISTS meta (
            schema_version INTEGER,
            last_indexed_msg_id INTEGER,
            last_full_sync_at TEXT,
            chat_db_inode INTEGER,
            chat_db_size INTEGER
        );
    """)

    c.execute("SELECT COUNT(*) FROM meta")
    if c.fetchone()[0] == 0:
        c.execute("""
            INSERT INTO meta (schema_version, last_indexed_msg_id, last_full_sync_at, chat_db_inode, chat_db_size)
            VALUES (?, 0, NULL, 0, 0)
        """, (INDEX_SCHEMA_VERSION,))
    ensure_transcripts_table(conn)
    conn.commit()

def build_index(batch_size=5000, force_rebuild=False):
    try:
        os.nice(15)
    except Exception:
        pass

    db_path = get_index_db_path()
    if force_rebuild and os.path.exists(db_path):
        for ext in ("", "-wal", "-shm"):
            p = db_path + ext
            if os.path.exists(p):
                try:
                    os.remove(p)
                except Exception:
                    pass

    conn_idx = get_index_db_connection()
    init_index_schema(conn_idx, force=force_rebuild)

    standalone_cache = os.path.join(get_mcp_home_dir(), "transcripts.db")
    if os.path.exists(standalone_cache) and os.path.abspath(standalone_cache) != os.path.abspath(db_path):
        try:
            s_conn = sqlite3.connect(f"file:{standalone_cache}?mode=ro", uri=True)
            ensure_transcripts_table(s_conn)
            cur_temp = conn_idx.cursor()
            cur_temp.execute("ATTACH DATABASE ? AS standalone_db", (standalone_cache,))
            cur_temp.execute("""
                INSERT OR IGNORE INTO transcripts
                SELECT * FROM standalone_db.transcripts
            """)
            conn_idx.commit()
            cur_temp.execute("DETACH DATABASE standalone_db")
            s_conn.close()
        except Exception:
            pass

    conn_chat = get_db_connection()
    cur_chat = conn_chat.cursor()
    cur_idx = conn_idx.cursor()

    cur_idx.execute("SELECT last_indexed_msg_id FROM meta LIMIT 1")
    meta_row = cur_idx.fetchone()
    last_id = meta_row[0] if (meta_row and not force_rebuild) else 0

    cur_chat.execute("SELECT MAX(ROWID) FROM message")
    max_row = cur_chat.fetchone()
    max_id = max_row[0] if (max_row and max_row[0]) else 0

    chat_db_path = get_db_path()
    try:
        st = os.stat(chat_db_path)
        inode = st.st_ino
        size = st.st_size
    except Exception:
        inode = 0
        size = 0

    sys.stderr.write(f"[Index] Building index from msg_id {last_id} to {max_id} (batch size: {batch_size})...\n")

    available_cols = message_column_names(cur_chat)
    att_cols = set()
    try:
        cur_chat.execute("PRAGMA table_info(attachment)")
        att_cols = {r[1] for r in cur_chat.fetchall()}
    except Exception:
        pass

    uti_select = "a.uti" if "uti" in att_cols else "NULL AS uti"
    user_info_select = "a.user_info" if "user_info" in att_cols else "NULL AS user_info"
    attr_body_select = "m.attributedBody" if "attributedBody" in available_cols else "NULL AS attributed_body"
    item_type_select = "m.item_type" if "item_type" in available_cols else "0 AS item_type"

    total_indexed = 0

    while True:
        query = f"""
            SELECT 
                m.ROWID as msg_id,
                m.guid,
                MIN(cmj.chat_id) as chat_id,
                m.handle_id,
                m.is_from_me,
                m.date,
                {item_type_select},
                m.text,
                {attr_body_select}
            FROM message m
            LEFT JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
            WHERE m.ROWID > ?
            GROUP BY m.ROWID
            ORDER BY m.ROWID ASC
            LIMIT ?
        """
        cur_chat.execute(query, (last_id, batch_size))
        rows = cur_chat.fetchall()
        if not rows:
            break

        msg_ids = [r[0] for r in rows]
        att_map = {}
        if msg_ids:
            placeholders = ",".join(["?"] * len(msg_ids))
            att_query = f"""
                SELECT 
                    maj.message_id,
                    a.ROWID,
                    a.guid,
                    a.filename,
                    a.mime_type,
                    a.transfer_name,
                    a.total_bytes,
                    {uti_select},
                    {user_info_select}
                FROM message_attachment_join maj
                JOIN attachment a ON maj.attachment_id = a.ROWID
                WHERE maj.message_id IN ({placeholders})
            """
            cur_chat.execute(att_query, msg_ids)
            for a_msg_id, a_id, a_guid, a_fn, a_mime, a_tf, a_bytes, a_uti, a_uinfo in cur_chat.fetchall():
                if a_msg_id not in att_map:
                    att_map[a_msg_id] = []
                att_map[a_msg_id].append({
                    "attachment_id": a_id,
                    "guid": a_guid,
                    "filename": a_fn,
                    "mime_type": a_mime,
                    "transfer_name": a_tf,
                    "total_bytes": a_bytes or 0,
                    "uti": a_uti,
                    "user_info": a_uinfo,
                })

        batch_msgs = []
        batch_atts = []

        for r in rows:
            m_id, guid, chat_id, handle_id, is_from_me, date_val, item_type, text_val, attr_body = r
            atts = att_map.get(m_id, [])
            has_atts = 1 if atts else 0

            date_num = int(date_val) if date_val else 0
            if abs(date_num) > 10_000_000_000:
                apple_sec = date_num / 1_000_000_000
            else:
                apple_sec = float(date_num)
            date_unix = int(978307200 + apple_sec) if date_num else 0

            decoded = text_val or ""
            if not decoded or not decoded.strip():
                if attr_body:
                    decoded = parse_attributed_body(attr_body)
                else:
                    decoded = ""

            for a in atts:
                transcript = None
                if a.get("user_info"):
                    p = extract_attachment_user_info(a["user_info"])
                    transcript = p.get("audio-transcription")
                if not transcript and (a.get("filename") or a.get("guid")):
                    cached = get_cached_transcript(guid=a.get("guid"), filepath=a.get("filename"))
                    if cached:
                        transcript = cached.get("transcription")
                if transcript:
                    if decoded:
                        decoded = f"{decoded} {transcript}"
                    else:
                        decoded = transcript
                    break

            batch_msgs.append((
                m_id, guid, chat_id, handle_id, int(is_from_me or 0),
                date_num, date_unix, int(item_type or 0), has_atts, decoded
            ))

            for a in atts:
                fn = os.path.basename(a["filename"]) if a["filename"] else (a["transfer_name"] or "attachment")
                batch_atts.append((
                    a["attachment_id"],
                    m_id,
                    fn,
                    a["transfer_name"] or fn,
                    a["mime_type"] or "application/octet-stream",
                    a["uti"] or None,
                    a["total_bytes"],
                    a["filename"] or "",
                ))

        cur_idx.executemany("""
            INSERT INTO messages_idx (
                msg_id, guid, chat_id, handle_id, is_from_me,
                date, date_unix, item_type, has_attachments, text_decoded
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(msg_id) DO UPDATE SET
                guid = excluded.guid,
                chat_id = excluded.chat_id,
                handle_id = excluded.handle_id,
                is_from_me = excluded.is_from_me,
                date = excluded.date,
                date_unix = excluded.date_unix,
                item_type = excluded.item_type,
                has_attachments = excluded.has_attachments,
                text_decoded = excluded.text_decoded
        """, batch_msgs)

        if batch_atts:
            cur_idx.executemany("""
                INSERT INTO attachments_idx (
                    attachment_id, msg_id, filename, transfer_name,
                    mime_type, uti, total_bytes, path
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                ON CONFLICT(attachment_id, msg_id) DO UPDATE SET
                    filename = excluded.filename,
                    transfer_name = excluded.transfer_name,
                    mime_type = excluded.mime_type,
                    uti = excluded.uti,
                    total_bytes = excluded.total_bytes,
                    path = excluded.path
            """, batch_atts)

        last_id = rows[-1][0]
        cur_idx.execute("UPDATE meta SET last_indexed_msg_id = ?", (last_id,))
        conn_idx.commit()
        total_indexed += len(rows)
        sys.stderr.write(f"[Index] Indexed up to msg_id {last_id} ({total_indexed} rows in this run)...\n")

    cmap = get_contacts_map()
    if cmap:
        cur_idx.executemany(
            """INSERT INTO contacts_idx (handle, display_name)
               VALUES (?, ?)
               ON CONFLICT(handle) DO UPDATE SET display_name = excluded.display_name""",
            [(k, v) for k, v in cmap.items()]
        )

    now_iso = datetime.datetime.now(datetime.timezone.utc).isoformat()
    cur_idx.execute("""
        UPDATE meta SET 
            last_indexed_msg_id = ?,
            last_full_sync_at = ?,
            chat_db_inode = ?,
            chat_db_size = ?
    """, (last_id, now_iso, inode, size))
    conn_idx.commit()

    conn_chat.close()
    conn_idx.close()
    sys.stderr.write(f"[Index] Build complete: indexed {total_indexed} rows up to msg_id {last_id}.\n")

def sync_index(recheck_days=None):
    db_path = get_index_db_path()
    if not os.path.exists(db_path):
        build_index()
        return

    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        c = conn.cursor()
        c.execute("SELECT schema_version FROM meta LIMIT 1")
        row = c.fetchone()
        conn.close()
        if not row or row[0] != INDEX_SCHEMA_VERSION:
            sys.stderr.write("[Index] Schema version changed or missing. Rebuilding index.\n")
            build_index(force_rebuild=True)
            return
    except Exception as err:
        sys.stderr.write(f"[Index] Error verifying index schema ({err}). Rebuilding index.\n")
        build_index(force_rebuild=True)
        return

    build_index(batch_size=5000, force_rebuild=False)

    if recheck_days is None:
        recheck_days = get_recheck_days()

    if recheck_days > 0:
        conn_idx = get_index_db_connection()
        conn_chat = get_db_connection()
        cur_idx = conn_idx.cursor()
        cur_chat = conn_chat.cursor()

        now_dt = datetime.datetime.now(datetime.timezone.utc)
        threshold_dt = now_dt - datetime.timedelta(days=recheck_days)
        threshold_unix = int(threshold_dt.timestamp())

        cur_idx.execute("SELECT msg_id, text_decoded FROM messages_idx WHERE date_unix >= ?", (threshold_unix,))
        indexed_rows = {r[0]: r[1] for r in cur_idx.fetchall()}

        if indexed_rows:
            placeholders = ",".join(["?"] * len(indexed_rows))
            available_cols = message_column_names(cur_chat)
            attr_select = "m.attributedBody" if "attributedBody" in available_cols else "NULL AS attributed_body"
            cur_chat.execute(f"""
                SELECT m.ROWID, m.text, {attr_select}
                FROM message m
                WHERE m.ROWID IN ({placeholders})
            """, list(indexed_rows.keys()))
            chat_rows = {r[0]: (r[1], r[2]) for r in cur_chat.fetchall()}

            to_delete = [mid for mid in indexed_rows if mid not in chat_rows]
            if to_delete:
                del_ph = ",".join(["?"] * len(to_delete))
                cur_idx.execute(f"DELETE FROM messages_idx WHERE msg_id IN ({del_ph})", to_delete)
                cur_idx.execute(f"DELETE FROM attachments_idx WHERE msg_id IN ({del_ph})", to_delete)
                conn_idx.commit()
                sys.stderr.write(f"[Index] Removed {len(to_delete)} deleted messages from index.\n")

            updated_count = 0
            for mid, (raw_text, attr_body) in chat_rows.items():
                old_text = indexed_rows.get(mid) or ""
                new_text = raw_text or ""
                if not new_text or not new_text.strip():
                    if attr_body:
                        new_text = parse_attributed_body(attr_body)
                    else:
                        new_text = ""
                if new_text != old_text:
                    cur_idx.execute("UPDATE messages_idx SET text_decoded = ? WHERE msg_id = ?", (new_text, mid))
                    updated_count += 1

            if updated_count > 0:
                conn_idx.commit()
                sys.stderr.write(f"[Index] Refreshed {updated_count} edited messages in index.\n")

            att_cols = set()
            try:
                cur_chat.execute("PRAGMA table_info(attachment)")
                att_cols = {r[1] for r in cur_chat.fetchall()}
            except Exception:
                pass
            uti_select = "a.uti" if "uti" in att_cols else "NULL AS uti"
            cur_chat.execute(f"""
                SELECT maj.message_id, a.ROWID, a.filename, a.mime_type, a.transfer_name, a.total_bytes, {uti_select}
                FROM message_attachment_join maj
                JOIN attachment a ON maj.attachment_id = a.ROWID
                WHERE maj.message_id IN ({placeholders})
            """, list(indexed_rows.keys()))
            recheck_atts = cur_chat.fetchall()
            if recheck_atts:
                batch_atts = []
                for m_id, a_id, a_fn, a_mime, a_tf, a_bytes, a_uti in recheck_atts:
                    fn = os.path.basename(a_fn) if a_fn else (a_tf or "attachment")
                    batch_atts.append((
                        a_id, m_id, fn, a_tf or fn, a_mime or "application/octet-stream",
                        a_uti or None, a_bytes or 0, a_fn or ""
                    ))
                cur_idx.executemany("""
                    INSERT INTO attachments_idx (
                        attachment_id, msg_id, filename, transfer_name,
                        mime_type, uti, total_bytes, path
                    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                    ON CONFLICT(attachment_id, msg_id) DO UPDATE SET
                        filename = excluded.filename,
                        transfer_name = excluded.transfer_name,
                        mime_type = excluded.mime_type,
                        uti = excluded.uti,
                        total_bytes = excluded.total_bytes,
                        path = excluded.path
                """, batch_atts)
                conn_idx.commit()

        conn_chat.close()
        conn_idx.close()

def get_index_status():
    db_path = get_index_db_path()
    enabled = is_index_enabled()
    exists = os.path.exists(db_path)

    conn_chat = get_db_connection()
    cur_chat = conn_chat.cursor()
    cur_chat.execute("SELECT MAX(ROWID) FROM message")
    max_row = cur_chat.fetchone()
    chat_max_id = max_row[0] if (max_row and max_row[0]) else 0
    conn_chat.close()

    if not exists:
        return {
            "enabled": enabled,
            "index_db_path": db_path,
            "exists": False,
            "schema_version": None,
            "last_indexed_msg_id": 0,
            "chat_db_max_msg_id": chat_max_id,
            "lag": chat_max_id,
            "is_caught_up": False,
            "messages_count": 0,
            "attachments_count": 0,
            "contacts_count": 0,
            "file_size_bytes": 0,
            "last_full_sync_at": None,
        }

    try:
        conn_idx = get_index_db_connection(read_only=True)
        cur_idx = conn_idx.cursor()
        cur_idx.execute("SELECT schema_version, last_indexed_msg_id, last_full_sync_at FROM meta LIMIT 1")
        meta = cur_idx.fetchone()
        schema_version, last_id, last_sync = meta if meta else (None, 0, None)

        cur_idx.execute("SELECT COUNT(*) FROM messages_idx")
        messages_count = cur_idx.fetchone()[0]

        cur_idx.execute("SELECT COUNT(*) FROM attachments_idx")
        attachments_count = cur_idx.fetchone()[0]

        cur_idx.execute("SELECT COUNT(*) FROM contacts_idx")
        contacts_count = cur_idx.fetchone()[0]

        conn_idx.close()

        file_size = os.path.getsize(db_path)
        lag = max(0, chat_max_id - (last_id or 0))
        is_caught_up = (lag == 0)

        return {
            "enabled": enabled,
            "index_db_path": db_path,
            "exists": True,
            "schema_version": schema_version,
            "last_indexed_msg_id": last_id or 0,
            "chat_db_max_msg_id": chat_max_id,
            "lag": lag,
            "is_caught_up": is_caught_up,
            "messages_count": messages_count,
            "attachments_count": attachments_count,
            "contacts_count": contacts_count,
            "file_size_bytes": file_size,
            "last_full_sync_at": last_sync,
        }
    except Exception as err:
        return {
            "enabled": enabled,
            "index_db_path": db_path,
            "exists": True,
            "error": str(err),
            "schema_version": None,
            "last_indexed_msg_id": 0,
            "chat_db_max_msg_id": chat_max_id,
            "lag": chat_max_id,
            "is_caught_up": False,
            "messages_count": 0,
            "attachments_count": 0,
            "contacts_count": 0,
            "file_size_bytes": os.path.getsize(db_path) if os.path.exists(db_path) else 0,
            "last_full_sync_at": None,
        }

def cli_index_status(args):
    status = get_index_status()
    if getattr(args, "json", False):
        print(json.dumps(status, indent=2))
    else:
        status_label = "Enabled (Caught up)" if status.get("is_caught_up") else ("Enabled (Lagging)" if status.get("enabled") else "Disabled")
        size_kb = status.get("file_size_bytes", 0) / 1024
        print("iMessage Local Index Status:")
        print("----------------------------")
        print(f"Status: {status_label}")
        print(f"Index Database: {status.get('index_db_path')}")
        print(f"File Size: {size_kb:.1f} KB")
        print(f"Schema Version: {status.get('schema_version')}")
        print(f"Last Indexed Message ID: {status.get('last_indexed_msg_id')}")
        print(f"chat.db Max Message ID: {status.get('chat_db_max_msg_id')}")
        print(f"Lag: {status.get('lag')} messages behind")
        print(f"Messages Indexed: {status.get('messages_count')}")
        print(f"Attachments Indexed: {status.get('attachments_count')}")
        print(f"Contacts Indexed: {status.get('contacts_count')}")
        print(f"Last Sync: {status.get('last_full_sync_at')}")

def is_index_healthy_and_caught_up():
    if not is_index_enabled():
        return False
    status = get_index_status()
    if not status.get("exists"):
        sys.stderr.write("[Index] Warning: Index database does not exist. Falling back to live chat.db search.\n")
        return False
    if status.get("schema_version") != INDEX_SCHEMA_VERSION:
        sys.stderr.write(f"[Index] Warning: Index schema mismatch ({status.get('schema_version')} != {INDEX_SCHEMA_VERSION}). Falling back to live chat.db search.\n")
        return False
    if status.get("error"):
        sys.stderr.write(f"[Index] Warning: Index database corrupted or error ({status.get('error')}). Falling back to live chat.db search.\n")
        return False
    if not status.get("is_caught_up"):
        sys.stderr.write(f"[Index] Warning: Index is behind chat.db (lag: {status.get('lag')} rows). Falling back to live chat.db search.\n")
        return False
    return True

def format_fts5_query(query_str):
    q = (query_str or "").strip()
    if not q:
        return ""
    if q.startswith('"') and q.endswith('"') and len(q) > 1:
        inner = q[1:-1].replace('"', '""')
        return f'"{inner}"'
    tokens = q.split()
    sanitized = []
    for token in tokens:
        clean = token.replace('"', '').strip()
        if not clean:
            continue
        if clean.endswith('*'):
            clean_word = clean[:-1].strip()
            if clean_word:
                sanitized.append(f'"{clean_word}"*')
        else:
            sanitized.append(f'"{clean}"*')
    return " ".join(sanitized)

def populate_cached_decoded_text(rows):
    if not is_index_enabled() or not rows:
        return
    db_path = get_index_db_path()
    if not os.path.exists(db_path):
        return
    try:
        need_lookup = [r["msg_id"] for r in rows if not r.get("text") and r.get("attributed_body")]
        if not need_lookup:
            return
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        c = conn.cursor()
        placeholders = ",".join(["?"] * len(need_lookup))
        c.execute(f"SELECT msg_id, text_decoded FROM messages_idx WHERE msg_id IN ({placeholders})", need_lookup)
        text_map = {r[0]: r[1] for r in c.fetchall()}
        conn.close()
        for r in rows:
            if r["msg_id"] in text_map and text_map[r["msg_id"]]:
                r["text"] = text_map[r["msg_id"]]
                r["attributed_body"] = None
    except Exception:
        pass

def format_size(bytes_num):
    if not bytes_num: return "0 B"
    for unit in ['B', 'KB', 'MB', 'GB']:
        if abs(bytes_num) < 1024.0:
            return f"{bytes_num:.1f} {unit}"
        bytes_num /= 1024.0
    return f"{bytes_num:.1f} TB"

AUDIO_EXTENSIONS = {'.caf', '.m4a', '.wav', '.mp3', '.aac', '.ogg', '.aiff', '.flac'}
AUDIO_MIME_MAP = {
    '.caf': 'audio/x-caf',
    '.m4a': 'audio/mp4',
    '.mp4': 'audio/mp4',
    '.wav': 'audio/wav',
    '.mp3': 'audio/mpeg',
    '.aac': 'audio/aac',
    '.ogg': 'audio/ogg',
    '.aiff': 'audio/aiff',
    '.flac': 'audio/flac',
}

def get_caf_duration(path):
    """Parse CAF header for sample rate and valid frame count to compute exact duration."""
    if not path or not os.path.exists(path):
        return None
    try:
        with open(path, 'rb') as f:
            hdr = f.read(8)
            if len(hdr) < 8 or hdr[:4] != b'caff':
                return None
            sr = None
            while True:
                chunk_hdr = f.read(12)
                if len(chunk_hdr) < 12:
                    break
                ctype, csize = struct.unpack('>4sq', chunk_hdr)
                if ctype == b'desc':
                    desc_data = f.read(csize)
                    if len(desc_data) >= 8:
                        sr = struct.unpack('>d', desc_data[:8])[0]
                elif ctype == b'pakt':
                    pakt_data = f.read(min(csize, 24))
                    if len(pakt_data) >= 16 and sr and sr > 0:
                        pkts, valid_frames = struct.unpack('>qq', pakt_data[:16])
                        return round(valid_frames / sr, 2)
                    if csize > len(pakt_data):
                        f.seek(csize - len(pakt_data), 1)
                else:
                    if csize > 0:
                        f.seek(csize, 1)
    except Exception:
        pass
    return None

def get_audio_duration(path):
    """Returns duration in seconds for an audio file, using fast CAF parser or afinfo."""
    if not path or not os.path.exists(path):
        return None
    ext = os.path.splitext(path)[1].lower()
    if ext == '.caf':
        dur = get_caf_duration(path)
        if dur is not None:
            return dur
    try:
        afinfo_bin = '/usr/bin/afinfo'
        if os.path.exists(afinfo_bin):
            res = subprocess.run([afinfo_bin, path], capture_output=True, text=True, timeout=5)
            for line in res.stdout.splitlines():
                if 'estimated duration:' in line:
                    parts = line.split('estimated duration:')[1].split()
                    if parts:
                        return round(float(parts[0]), 2)
    except Exception:
        pass
    return None

def format_duration(seconds):
    """Format duration in seconds to compact string like '15s' or '1m 32s'."""
    if seconds is None:
        return None
    total_sec = int(round(seconds))
    mins = total_sec // 60
    secs = total_sec % 60
    if mins > 0:
        return f"{mins}m {secs}s"
    return f"{secs}s"

def build_voice_note_label(duration_formatted, transcription):
    """Build a clear label for voice notes instead of an empty message."""
    if transcription and duration_formatted:
        return f'[voice note, {duration_formatted}: "{transcription}"]'
    elif transcription:
        return f'[voice note: "{transcription}"]'
    elif duration_formatted:
        return f'[voice note, {duration_formatted}]'
    return '[voice note]'

def extract_attachment_user_info(user_info_blob):
    """Extract transcription, uti, and metadata from attachment user_info blob."""
    if not user_info_blob:
        return {}
    try:
        return plistlib.loads(user_info_blob)
    except Exception:
        return {}

def extract_sticker_metadata(user_info, attribution_info, emoji_desc, uti, filename, is_sticker_col, sticker_user_info=None):
    """
    Extract is_sticker (bool), sticker_pack (str | None), and sticker_description (str | None).
    """
    p_user = extract_attachment_user_info(user_info)
    p_attr = extract_attachment_user_info(attribution_info)
    p_stick = extract_attachment_user_info(sticker_user_info) if sticker_user_info else {}

    fn = (filename or "").lower()
    uti_lower = (uti or "").lower()

    col_flag = bool(is_sticker_col and int(is_sticker_col) > 0)
    path_flag = bool("stickercache" in fn or "/stickers/" in fn)
    uti_flag = bool("sticker" in uti_lower)

    plist_flag = bool(
        p_user.get("is-sticker")
        or p_user.get("sticker-pack-name")
        or p_user.get("sticker-pack-bundle-id")
        or p_attr.get("bundle-id")
        or p_attr.get("pack-name")
        or p_attr.get("sticker-pack-name")
        or p_stick
    )

    pack = (
        p_stick.get("sticker-pack-name")
        or p_stick.get("sticker-pack-bundle-id")
        or p_stick.get("pack-name")
        or p_stick.get("bundle-id")
        or p_attr.get("sticker-pack-name")
        or p_attr.get("pack-name")
        or p_attr.get("sticker-pack-bundle-id")
        or p_attr.get("bundle-id")
        or p_user.get("sticker-pack-name")
        or p_user.get("sticker-pack-bundle-id")
        or p_user.get("pack-name")
        or p_user.get("bundle-id")
    )
    if pack is not None and not isinstance(pack, str):
        pack = str(pack)

    desc = (
        emoji_desc
        or p_stick.get("sticker-description")
        or p_stick.get("accessibility-label")
        or p_stick.get("accessibilityLabel")
        or p_attr.get("accessibility-label")
        or p_attr.get("accessibilityLabel")
        or p_attr.get("sticker-description")
        or p_user.get("sticker-description")
        or p_user.get("accessibility-label")
        or p_user.get("accessibilityLabel")
    )
    if desc is not None and not isinstance(desc, str):
        desc = str(desc)

    is_sticker = bool(col_flag or path_flag or uti_flag or plist_flag or pack or desc)
    return is_sticker, pack, desc


def build_sticker_label(description=None, pack=None):
    """Build a clear label for stickers when synthesizing message text."""
    if description:
        return f'[sticker: "{description}"]'
    return '[sticker]'


def fetch_attachments_for_messages(cursor, msg_ids, transcribe=False):
    """
    Fetch and enrich all attachments for a list of message IDs.
    Returns a dict mapping msg_id to a list of attachment dicts.
    """
    if not msg_ids:
        return {}

    cursor.execute("PRAGMA table_info(attachment)")
    att_cols = {r[1] for r in cursor.fetchall()}

    is_sticker_sel = "a.is_sticker" if "is_sticker" in att_cols else "0 AS is_sticker"
    attr_info_sel = "a.attribution_info" if "attribution_info" in att_cols else "NULL AS attribution_info"
    emoji_desc_sel = "a.emoji_image_short_description" if "emoji_image_short_description" in att_cols else "NULL AS emoji_image_short_description"
    sticker_user_info_sel = "a.sticker_user_info" if "sticker_user_info" in att_cols else "NULL AS sticker_user_info"

    att_placeholders = ",".join(["?"] * len(msg_ids))
    att_query = f"""
    SELECT 
        maj.message_id,
        a.guid,
        a.filename,
        a.mime_type,
        a.transfer_name,
        a.total_bytes,
        a.user_info,
        a.uti,
        {is_sticker_sel},
        {attr_info_sel},
        {emoji_desc_sel},
        {sticker_user_info_sel}
    FROM message_attachment_join maj
    JOIN attachment a ON maj.attachment_id = a.ROWID
    WHERE maj.message_id IN ({att_placeholders})
    """
    cursor.execute(att_query, msg_ids)
    attachments_map = {}
    for (msg_id, a_guid, filename, mime_type, transfer_name, total_bytes, user_info, uti,
         is_sticker_col, attr_info, emoji_desc, sticker_user_info) in cursor.fetchall():
        if msg_id not in attachments_map:
            attachments_map[msg_id] = []
        
        full_path = os.path.expanduser(filename) if filename else None
        ext = os.path.splitext(full_path or transfer_name or "")[1].lower()
        
        p = extract_attachment_user_info(user_info)
        apple_transcription = p.get('audio-transcription') or None
        apple_language = p.get('transcription-language') or p.get('language') or None
        transcription = apple_transcription
        language = apple_language
        transcription_source = 'apple' if apple_transcription else None

        is_audio = (
            ext in AUDIO_EXTENSIONS
            or (uti and ('coreaudio' in uti.lower() or 'audio' in uti.lower()))
            or (mime_type and mime_type.startswith('audio/'))
            or transcription is not None
        )

        if transcription is None and is_audio and full_path:
            cached = get_cached_transcript(guid=a_guid, filepath=full_path)
            if cached and cached.get("transcription"):
                transcription = cached["transcription"]
                language = cached.get("language")
                transcription_source = cached.get("engine")
            elif transcribe:
                txt, lang, eng, segs, status = transcribe_audio_with_lock(
                    full_path, guid=a_guid, msg_id=msg_id
                )
                if status == "ok" and txt:
                    transcription = txt
                    language = lang
                    transcription_source = eng

        is_sticker, sticker_pack, sticker_description = extract_sticker_metadata(
            user_info, attr_info, emoji_desc, uti, full_path or transfer_name,
            is_sticker_col, sticker_user_info
        )

        resolved_mime = mime_type
        if not resolved_mime or resolved_mime == 'application/octet-stream':
            if ext in AUDIO_MIME_MAP:
                resolved_mime = AUDIO_MIME_MAP[ext]
            elif ext in ['.jpg', '.jpeg']:
                resolved_mime = 'image/jpeg'
            elif ext == '.png':
                resolved_mime = 'image/png'
            elif ext in ['.heic', '.heif']:
                resolved_mime = 'image/heic'
            elif ext == '.mov':
                resolved_mime = 'video/quicktime'
            elif ext == '.mp4':
                resolved_mime = 'video/mp4'
            elif is_audio:
                resolved_mime = 'audio/x-caf'
            else:
                resolved_mime = 'application/octet-stream'

        dur_sec = get_audio_duration(full_path) if is_audio and full_path else None
        dur_fmt = format_duration(dur_sec) if dur_sec is not None else None

        attachments_map[msg_id].append({
            'filename': full_path,
            'mime_type': resolved_mime,
            'transfer_name': transfer_name or (os.path.basename(full_path) if full_path else 'attachment'),
            'size': format_size(total_bytes),
            'is_audio': bool(is_audio),
            'duration_seconds': dur_sec,
            'duration_formatted': dur_fmt,
            'transcription': transcription,
            'language': language,
            'transcription_source': transcription_source,
            'uti': uti,
            'is_sticker': bool(is_sticker),
            'sticker_pack': sticker_pack,
            'sticker_description': sticker_description,
        })
    return attachments_map

def synthesize_message_text(raw_text, attr_body, is_audio_message, att_list):
    """
    Synthesizes message text, populating voice note transcripts and labels,
    and synthesizing raw Unicode replacement character \ufffc into readable sticker labels.
    Returns: (text: str, is_audio: bool, transcription: str | None)
    """
    msg_text = raw_text or ""
    if not msg_text or msg_text.strip() == "":
        msg_text = parse_attributed_body(attr_body)
    
    # Process sticker attachments
    sticker_atts = [a for a in att_list if a.get('is_sticker')]
    if sticker_atts:
        for s in sticker_atts:
            s_label = build_sticker_label(s.get('sticker_description'), s.get('sticker_pack'))
            if '\ufffc' in msg_text:
                msg_text = msg_text.replace('\ufffc', s_label, 1)
            elif not msg_text or msg_text.strip() == "" or msg_text == "<empty message>":
                msg_text = s_label
            else:
                msg_text = f"{msg_text.strip()} {s_label}".strip()
        if '\ufffc' in msg_text:
            msg_text = msg_text.replace('\ufffc', '[sticker]')

    audio_atts = [a for a in att_list if a.get('is_audio')]
    is_audio = bool(is_audio_message or audio_atts)
    
    transcription = None
    for a in audio_atts:
        if a.get('transcription'):
            transcription = a['transcription']
            break
            
    dur_fmt = None
    for a in audio_atts:
        if a.get('duration_formatted'):
            dur_fmt = a['duration_formatted']
            break

    if is_audio:
        voice_label = build_voice_note_label(dur_fmt, transcription)
        if not msg_text or msg_text.strip() == "" or msg_text == "<empty message>":
            msg_text = voice_label
        else:
            msg_text = f"{msg_text.strip()} {voice_label}".strip()
            
    if not msg_text or msg_text.strip() == "":
        msg_text = "<empty message>"

    return msg_text, is_audio, transcription

def normalize_handle(val):
    if not val: return ""
    clean = "".join([c for c in val if c.isalnum() or c == '@'])
    if clean.startswith('1') and len(clean) == 11 and clean.isdigit():
        clean = clean[1:]
    return clean.lower()

def get_contacts_map():
    if is_index_enabled():
        db_path = get_index_db_path()
        if os.path.exists(db_path):
            try:
                conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
                c = conn.cursor()
                c.execute("SELECT handle, display_name FROM contacts_idx")
                rows = c.fetchall()
                conn.close()
                if rows:
                    return {r[0]: r[1] for r in rows}
            except Exception:
                pass
    ab_paths = glob.glob(os.path.expanduser('~/Library/Application Support/AddressBook/**/*.abcddb'), recursive=True)
    cmap = {}
    for p in ab_paths:
        try:
            conn = sqlite3.connect(f"file:{p}?mode=ro", uri=True)
            c = conn.cursor()
            sql = """
            SELECT 
                r.ZFIRSTNAME, r.ZLASTNAME, r.ZORGANIZATION,
                p.ZFULLNUMBER, e.ZADDRESS
            FROM ZABCDRECORD r
            LEFT JOIN ZABCDPHONENUMBER p ON r.Z_PK = p.ZOWNER
            LEFT JOIN ZABCDEMAILADDRESS e ON r.Z_PK = e.ZOWNER
            """
            c.execute(sql)
            for fname, lname, org, phone, email in c.fetchall():
                full_name = " ".join(filter(None, [fname, lname])) or org or ""
                if not full_name: continue
                if phone:
                    cmap[normalize_handle(phone)] = full_name
                if email:
                    cmap[normalize_handle(email)] = full_name
            conn.close()
        except Exception:
            pass
    return cmap

def list_chats(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    query = """
    SELECT 
        c.ROWID, 
        COALESCE(c.display_name, ''), 
        c.chat_identifier,
        MAX(m.date) as last_msg_date
    FROM chat c
    LEFT JOIN chat_message_join cmj ON c.ROWID = cmj.chat_id
    LEFT JOIN message m ON cmj.message_id = m.ROWID
    GROUP BY c.ROWID
    ORDER BY last_msg_date DESC
    LIMIT ?
    """
    cursor.execute(query, (args.limit,))
    rows = cursor.fetchall()
    
    cmap = get_contacts_map()
    chats = []
    for rowid, display_name, identifier, last_msg_date in rows:
        cursor.execute("""
            SELECT h.id
            FROM chat_handle_join chj
            JOIN handle h ON chj.handle_id = h.ROWID
            WHERE chj.chat_id = ?
        """, (rowid,))
        handles = [r[0] for r in cursor.fetchall()]
        
        participants = []
        for h in handles:
            norm = normalize_handle(h)
            pname = cmap.get(norm, h)
            participants.append({'name': pname, 'handle': h})
            
        if display_name:
            name = display_name
        elif participants:
            name = ", ".join([p['name'] for p in participants])
        else:
            name = identifier or "<Direct Chat>"

        chats.append({
            'rowid': rowid,
            'chat_id': rowid,
            'display_name': display_name,
            'name': name,
            'identifier': identifier,
            'last_msg_date': last_msg_date,
            'participants': participants
        })
        
    if getattr(args, 'json', False):
        print(json.dumps(chats, indent=2))
    else:
        print(f"{'ID':<6} | {'Display Name / Participants':<35} | {'Identifier':<35}")
        print("-" * 85)
        for c in chats:
            print(f"{c['rowid']:<6} | {c['name']:<35} | {c['identifier']:<35}")
    conn.close()

def parse_attributed_body(blob):
    if not blob: return ""
    try:
        markers = [
            b'NSString' + bytes([1, 148, 132, 1]) + b'+',
            b'NSString' + bytes([1, 149, 132, 1]) + b'+',
            b'NSString' + bytes([1, 132, 1]) + b'+'
        ]
        for marker in markers:
            idx = blob.find(marker)
            if idx != -1:
                start = idx + len(marker)
                if start < len(blob):
                    flag = blob[start]
                    if flag == 0x81:
                        if start + 3 <= len(blob):
                            length = int.from_bytes(blob[start+1:start+3], byteorder='little')
                            if 0 < length <= len(blob) - (start + 3):
                                return blob[start + 3 : start + 3 + length].decode('utf-8', errors='ignore').strip('\x00\x01\ufffc')
                        if start + 2 <= len(blob):
                            length = blob[start+1]
                            if 0 < length <= len(blob) - (start + 2):
                                return blob[start + 2 : start + 2 + length].decode('utf-8', errors='ignore').strip('\x00\x01\ufffc')
                    elif flag == 0x82:
                        if start + 3 <= len(blob):
                            length = int.from_bytes(blob[start+1:start+3], byteorder='big')
                            if 0 < length <= len(blob) - (start + 3):
                                return blob[start + 3 : start + 3 + length].decode('utf-8', errors='ignore').strip('\x00\x01\ufffc')
                    else:
                        length = flag
                        if 0 < length <= len(blob) - (start + 1):
                            return blob[start + 1 : start + 1 + length].decode('utf-8', errors='ignore').strip('\x00\x01\ufffc')
    except: pass
    return ""

APPLE_EPOCH = datetime.datetime(2001, 1, 1, tzinfo=datetime.timezone.utc)

def format_apple_seconds(seconds):
    """Human timestamp (unchanged) plus ISO 8601 with the host's local UTC offset."""
    if seconds is None:
        return "", None
    dt_local = (APPLE_EPOCH + datetime.timedelta(seconds=float(seconds))).astimezone()
    human = dt_local.strftime("%Y-%m-%d %I:%M %p")
    iso = dt_local.replace(microsecond=0).isoformat()
    return human, iso

def format_apple_ns(date_ns):
    if not date_ns:
        return "", None
    return format_apple_seconds(int(date_ns) / 1_000_000_000)

def parse_edit_history(blob, date_edited_ns=0, message_date_ns=0):
    """
    Parses message_summary_info and date_edited to extract rewrite history.
    Returns: (is_edited: bool, edit_count: int, last_edited: str | None, edit_history: list)
    History entries keep `timestamp` and add `timestamp_iso`.
    """
    if not blob:
        if date_edited_ns and date_edited_ns > 0:
            last_ts, _last_iso = format_apple_ns(date_edited_ns)
            return True, 1, last_ts, []
        return False, 0, None, []

    try:
        data = plistlib.loads(blob)
    except Exception:
        if date_edited_ns and date_edited_ns > 0:
            last_ts, _last_iso = format_apple_ns(date_edited_ns)
            return True, 1, last_ts, []
        return False, 0, None, []

    ec = data.get('ec')
    if not ec or not isinstance(ec, dict):
        if date_edited_ns and date_edited_ns > 0:
            last_ts, _last_iso = format_apple_ns(date_edited_ns)
            return True, 1, last_ts, []
        return False, 0, None, []

    sorted_parts = sorted(ec.keys(), key=lambda k: int(k) if str(k).isdigit() else str(k))
    if not sorted_parts:
        return False, 0, None, []

    max_revisions = max((len(ec[k]) for k in sorted_parts if isinstance(ec[k], list)), default=0)
    if max_revisions <= 1:
        if date_edited_ns and date_edited_ns > 0:
            last_ts, _last_iso = format_apple_ns(date_edited_ns)
            return True, 1, last_ts, []
        return False, 0, None, []

    history = []
    for rev_idx in range(max_revisions):
        part_texts = []
        rev_date = None
        for p_key in sorted_parts:
            part_edits = ec[p_key]
            if not isinstance(part_edits, list) or not part_edits:
                continue
            item = part_edits[rev_idx] if rev_idx < len(part_edits) else part_edits[-1]
            if rev_date is None and item.get('d'):
                rev_date = item.get('d')
            t_str = parse_attributed_body(item.get('t'))
            if t_str:
                part_texts.append(t_str)

        ts_str = ''
        ts_iso = None
        if rev_date:
            ts_str, ts_iso = format_apple_seconds(rev_date)
        elif rev_idx == 0 and message_date_ns:
            ts_str, ts_iso = format_apple_ns(message_date_ns)

        label = "original" if rev_idx == 0 else f"edit_{rev_idx}"
        history.append({
            'revision': rev_idx,
            'label': label,
            'timestamp': ts_str,
            'timestamp_iso': ts_iso,
            'text': " ".join(part_texts)
        })

    edit_count = max_revisions - 1
    last_edited = history[-1]['timestamp'] if history and history[-1]['timestamp'] else None
    if not last_edited and date_edited_ns and date_edited_ns > 0:
        last_edited, _last_iso = format_apple_ns(date_edited_ns)

    return True, edit_count, last_edited, history

_REACTION_NAMES = {
    0: "love",
    1: "like",
    2: "dislike",
    3: "laugh",
    4: "emphasize",
    5: "question",
    6: "emoji",
}

_URL_RE = re.compile(r"https?://[^\s<>\"']+")


def classify_associated_type(assoc_type):
    """Tapback rows use 2000-2006 (added) and 3000-3006 (removed)."""
    if assoc_type is None:
        return None
    try:
        code = int(assoc_type)
    except (TypeError, ValueError):
        return None
    if 2000 <= code <= 2006:
        return code, _REACTION_NAMES[code - 2000], "added"
    if 3000 <= code <= 3006:
        return code, _REACTION_NAMES[code - 3000], "removed"
    return None


def target_guid_from_associated(raw):
    """associated_message_guid looks like 'p:0/<guid>' or 'bp:<guid>'."""
    if not raw or not isinstance(raw, str):
        return None
    value = raw.strip()
    if not value:
        return None
    if "/" in value:
        value = value.rsplit("/", 1)[-1]
    if value.startswith("bp:"):
        value = value[3:]
    return value or None


def message_column_names(cursor):
    cursor.execute("PRAGMA table_info(message)")
    return {row[1] for row in cursor.fetchall()}


