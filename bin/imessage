def message_select_list(available):
    def field(column, alias):
        if column in available:
            return f"m.{column} AS {alias}"
        return f"NULL AS {alias}"

    parts = [
        "m.ROWID AS msg_id",
        field("guid", "guid"),
        "c.ROWID AS chat_id",
        "c.display_name AS display_name",
        "c.chat_identifier AS chat_identifier",
        "m.date AS date_ns",
        "m.is_from_me AS is_from_me",
        "h.id AS handle",
        "m.text AS text",
        field("attributedBody", "attributed_body"),
        field("date_edited", "date_edited_ns"),
        field("message_summary_info", "summary_blob"),
        field("is_audio_message", "is_audio_message"),
        field("associated_message_type", "associated_message_type"),
        field("associated_message_guid", "associated_message_guid"),
        field("associated_message_emoji", "associated_message_emoji"),
        field("balloon_bundle_id", "balloon_bundle_id"),
        field("payload_data", "payload_data"),
        field("is_delivered", "is_delivered"),
        field("date_delivered", "date_delivered_ns"),
        field("is_read", "is_read"),
        field("date_read", "date_read_ns"),
        field("reply_to_guid", "reply_to_guid"),
        field("thread_originator_guid", "thread_originator_guid"),
        field("was_delivered_quietly", "was_delivered_quietly"),
        field("did_notify_recipient", "did_notify_recipient"),
        field("expressive_send_style_id", "expressive_send_style_id"),
        field("time_expressive_send_played", "time_expressive_send_played_ns"),
        field("schedule_type", "schedule_type"),
        field("schedule_state", "schedule_state"),
        field("is_played", "is_played"),
        field("date_played", "date_played_ns"),
        field("date_retracted", "date_retracted_ns"),
        field("is_time_sensitive", "is_time_sensitive"),
        field("is_kt_verified", "is_kt_verified"),
        field("sent_or_received_off_grid", "sent_or_received_off_grid"),
    ]
    return ",\n        ".join(parts)


MESSAGE_FROM = """
FROM message m
JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
JOIN chat c ON cmj.chat_id = c.ROWID
LEFT JOIN handle h ON m.handle_id = h.ROWID
"""


MESSAGE_FROM_LOOSE = """
FROM message m
LEFT JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
LEFT JOIN chat c ON cmj.chat_id = c.ROWID
LEFT JOIN handle h ON m.handle_id = h.ROWID
"""


def fetch_message_dicts(cursor, select_sql, tail_sql, params, from_sql=None):
    cursor.execute(f"SELECT {select_sql} {from_sql or MESSAGE_FROM} WHERE {tail_sql}", params)
    cols = [d[0] for d in cursor.description]
    return [dict(zip(cols, row)) for row in cursor.fetchall()]


def resolve_chat_ids(cursor, target):
    if target is None:
        return []
    target = str(target).strip()
    if not target:
        return []
    if target.isdigit():
        return [int(target)]
    cursor.execute(
        "SELECT ROWID FROM chat WHERE display_name LIKE ? OR chat_identifier LIKE ?",
        (f"%{target}%", f"%{target}%"),
    )
    return [r[0] for r in cursor.fetchall()]


def chat_placeholders(chat_ids):
    return ",".join(["?"] * len(chat_ids))


def sender_identity(is_from_me, handle, cmap, prefer_contact_name):
    """
    Outgoing chat.db rows store the other participant on handle_id.
    `handle` is the sender's own address and is empty for the account owner.
    `participant` preserves the other party's handle from that column.
    """
    counterpart = handle or ""
    if is_from_me:
        return "Me", "", counterpart
    if prefer_contact_name and cmap is not None:
        sender = cmap.get(normalize_handle(handle), handle or "Unknown")
    else:
        sender = handle or "Unknown"
    return sender, counterpart, counterpart


def last_edited_iso(history, date_edited_ns):
    if history:
        iso = history[-1].get("timestamp_iso")
        if iso:
            return iso
    if date_edited_ns:
        _human, iso = format_apple_ns(date_edited_ns)
        return iso
    return None


def _resolve_archive_value(objects, value, seen):
    if isinstance(value, plistlib.UID):
        idx = int(value)
        if idx in seen or idx < 0 or idx >= len(objects):
            return None
        seen = set(seen)
        seen.add(idx)
        return _resolve_archive_value(objects, objects[idx], seen)
    if isinstance(value, dict):
        if "NS.relative" in value or "NS.base" in value:
            rel = _resolve_archive_value(objects, value.get("NS.relative"), set(seen))
            base = _resolve_archive_value(objects, value.get("NS.base"), set(seen))
            if isinstance(rel, str) and rel:
                if isinstance(base, str) and base and not rel.startswith("http"):
                    return base.rstrip("/") + "/" + rel.lstrip("/")
                return rel
            return rel if isinstance(rel, str) else None
        out = {}
        for key, item in value.items():
            if key.startswith("$"):
                continue
            out[key] = _resolve_archive_value(objects, item, set(seen))
        return out
    if isinstance(value, list):
        return [_resolve_archive_value(objects, item, set(seen)) for item in value]
    if value == "$null":
        return None
    return value


def decode_payload_object(blob):
    if not blob:
        return None
    try:
        obj = plistlib.loads(blob)
    except Exception:
        return None
    if isinstance(obj, dict) and obj.get("$archiver") == "NSKeyedArchiver":
        objects = obj.get("$objects") or []
        root = (obj.get("$top") or {}).get("root")
        return _resolve_archive_value(objects, root, set())
    return obj


def _first_str(*values):
    for value in values:
        if isinstance(value, str) and value.strip():
            return value.strip()
    return None


def _find_link_dict(node):
    if isinstance(node, dict):
        if any(key in node for key in ("URL", "url", "title", "siteName", "summary", "originalURL")):
            return node
        for child in node.values():
            found = _find_link_dict(child)
            if found:
                return found
    elif isinstance(node, list):
        for child in node:
            found = _find_link_dict(child)
            if found:
                return found
    return None


def _artist_from_node(node):
    if not isinstance(node, dict):
        return None
    direct = _first_str(node.get("artist"), node.get("artistName"), node.get("albumArtist"))
    if direct:
        return direct
    for child in node.values():
        if isinstance(child, dict):
            found = _artist_from_node(child)
            if found:
                return found
    return None


def attachment_is_plugin_payload(att):
    blob = " ".join([
        str(att.get("transfer_name") or ""),
        str(att.get("filename") or ""),
        str(att.get("uti") or ""),
    ]).lower()
    return "pluginpayload" in blob


def extract_link_preview(payload_blob, message_text, balloon_bundle_id, attachments):
    """
    Pull URL, title, subtitle, artist, and site name out of payload_data.
    Accepts a plain binary plist or an NSKeyedArchiver LPLinkMetadata archive.
    The raw pluginPayloadAttachment stays on `attachments` for callers that need bytes.
    """
    decoded = decode_payload_object(payload_blob)
    meta = _find_link_dict(decoded) if decoded is not None else None
    url = title = subtitle = site_name = artist = None
    if isinstance(meta, dict):
        url = _first_str(meta.get("URL"), meta.get("url"), meta.get("originalURL"))
        title = _first_str(meta.get("title"))
        subtitle = _first_str(meta.get("summary"), meta.get("subtitle"))
        site_name = _first_str(meta.get("siteName"), meta.get("site_name"))
        artist = _artist_from_node(meta.get("specialization")) or _artist_from_node(meta)
        if artist and title and artist == title:
            artist = _artist_from_node(meta.get("specialization"))
    balloon = balloon_bundle_id or ""
    is_linkish = (
        "URLBalloon" in balloon
        or "RichLink" in balloon
        or "spotify" in balloon.lower()
        or any(attachment_is_plugin_payload(att) for att in attachments)
    )
    if not url and is_linkish and message_text:
        match = _URL_RE.search(message_text)
        if match:
            url = match.group(0)
    if artist is None and subtitle and site_name and "spotify" in site_name.lower():
        artist = subtitle
    if meta is None and not is_linkish:
        return None
    if not any([url, title, subtitle, site_name, artist]):
        return None
    return {
        "url": url,
        "title": title,
        "subtitle": subtitle,
        "artist": artist,
        "site_name": site_name,
    }


def lookup_message_guids(cursor, guids):
    cleaned = [g for g in dict.fromkeys(guids) if g]
    if not cleaned:
        return {}
    placeholders = ",".join(["?"] * len(cleaned))
    try:
        cursor.execute(
            f"SELECT ROWID, guid FROM message WHERE guid IN ({placeholders})",
            cleaned,
        )
    except sqlite3.OperationalError:
        return {}
    return {guid: rowid for rowid, guid in cursor.fetchall() if guid}


def build_reaction_record(row, cmap, prefer_contact_name, guid_to_id):
    _code, reaction_type, action = classify_associated_type(row.get("associated_message_type"))
    target_guid = target_guid_from_associated(row.get("associated_message_guid"))
    emoji = row.get("associated_message_emoji") or None
    if reaction_type != "emoji":
        emoji = None
    elif isinstance(emoji, str):
        emoji = emoji or None
    sender, handle, participant = sender_identity(
        bool(row.get("is_from_me")), row.get("handle"), cmap, prefer_contact_name
    )
    human, iso = format_apple_ns(row.get("date_ns"))
    return {
        "msg_id": row["msg_id"],
        "guid": row.get("guid"),
        "type": reaction_type,
        "action": action,
        "emoji": emoji,
        "sender": sender,
        "handle": handle,
        "participant": participant,
        "is_from_me": bool(row.get("is_from_me")),
        "target_msg_id": guid_to_id.get(target_guid) if target_guid else None,
        "target_guid": target_guid,
        "associated_message_guid": row.get("associated_message_guid"),
        "associated_message_type": int(row.get("associated_message_type") or 0),
        "timestamp": human,
        "timestamp_iso": iso,
    }


def base_message_fields(row, cmap, prefer_contact_name, attachments_map):
    is_from_me = bool(row.get("is_from_me"))
    sender, handle, participant = sender_identity(
        is_from_me, row.get("handle"), cmap, prefer_contact_name
    )
    human, iso = format_apple_ns(row.get("date_ns"))
    display_name = row.get("display_name") or ""
    chat_ident = row.get("chat_identifier") or ""
    chat = display_name if display_name else chat_ident
    att_list = attachments_map.get(row["msg_id"], [])
    msg_text, is_audio, transcription = synthesize_message_text(
        row.get("text"), row.get("attributed_body"), row.get("is_audio_message"), att_list
    )
    is_edited, edit_count, last_edited, edit_history = parse_edit_history(
        row.get("summary_blob"), row.get("date_edited_ns") or 0, row.get("date_ns") or 0
    )
    link_preview = extract_link_preview(
        row.get("payload_data"), msg_text, row.get("balloon_bundle_id"), att_list
    )
    is_delivered = bool(row.get("is_delivered") or (row.get("date_delivered_ns") and row.get("date_delivered_ns") > 0))
    is_read = bool(row.get("is_read") or (row.get("date_read_ns") and row.get("date_read_ns") > 0))
    if is_delivered:
        deliv_date_ns = row.get("date_delivered_ns") if (row.get("date_delivered_ns") and row.get("date_delivered_ns") > 0) else row.get("date_ns")
        deliv_human, deliv_iso = format_apple_ns(deliv_date_ns)
    else:
        deliv_human, deliv_iso = "", None
    read_human, read_iso = format_apple_ns(row.get("date_read_ns"))
    delivered_quietly = bool(row.get("was_delivered_quietly"))
    did_notify_recipient = bool(row.get("did_notify_recipient"))

    style_id = row.get("expressive_send_style_id")
    effect_name, effect_type = (None, None)
    if style_id:
        effect_name, effect_type = REVERSE_EFFECT_NAMES.get(style_id, (style_id, "unknown"))

    schedule_type = int(row.get("schedule_type") or 0)
    schedule_state = int(row.get("schedule_state") or 0)
    is_scheduled = bool(schedule_type > 0 or schedule_state > 0)

    is_played = bool(row.get("is_played") or (row.get("date_played_ns") and row.get("date_played_ns") > 0))
    played_human, played_iso = format_apple_ns(row.get("date_played_ns")) if is_played else ("", None)

    is_retracted = bool(row.get("date_retracted_ns") and row.get("date_retracted_ns") > 0)
    retracted_human, retracted_iso = format_apple_ns(row.get("date_retracted_ns")) if is_retracted else ("", None)

    is_time_sensitive = bool(row.get("is_time_sensitive"))
    is_kt_verified = bool(row.get("is_kt_verified"))
    off_grid = bool(row.get("sent_or_received_off_grid"))

    return {
        "kind": "message",
        "msg_id": row["msg_id"],
        "guid": row.get("guid"),
        "timestamp": human,
        "timestamp_iso": iso,
        "chat": chat,
        "chat_id": row.get("chat_id"),
        "sender": sender,
        "handle": handle,
        "participant": participant,
        "is_from_me": is_from_me,
        "text": msg_text,
        "reply_to": None,
        "is_delivered": is_delivered,
        "delivered_at": deliv_human or None,
        "delivered_at_iso": deliv_iso,
        "delivered_quietly": delivered_quietly,
        "was_delivered_quietly": delivered_quietly,
        "notifications_silenced": delivered_quietly,
        "silenced_notifications": delivered_quietly,
        "has_notifications_silenced": delivered_quietly,
        "did_notify_recipient": did_notify_recipient,
        "is_read": is_read,
        "read_at": read_human or None,
        "read_at_iso": read_iso,
        "effect": effect_name,
        "effect_type": effect_type,
        "expressive_send_style_id": style_id,
        "is_scheduled": is_scheduled,
        "schedule_type": schedule_type,
        "schedule_state": schedule_state,
        "is_audio_message": is_audio,
        "is_played": is_played,
        "played_at": played_human or None,
        "played_at_iso": played_iso,
        "is_retracted": is_retracted,
        "retracted_at": retracted_human or None,
        "retracted_at_iso": retracted_iso,
        "is_time_sensitive": is_time_sensitive,
        "is_kt_verified": is_kt_verified,
        "off_grid": off_grid,
        "transcription": transcription,
        "is_edited": is_edited,
        "has_edits": is_edited,
        "edit_count": edit_count,
        "last_edited": last_edited,
        "last_edited_iso": last_edited_iso(edit_history, row.get("date_edited_ns") or 0) if is_edited else None,
        "edit_history": edit_history,
        "attachments": att_list,
        "link_preview": link_preview,
        "balloon_bundle_id": row.get("balloon_bundle_id"),
        "reactions": [],
        "_date_apple_s": float((row.get("date_ns") or 0) / 1_000_000_000),
    }


def reaction_list_item(row, reaction, cmap, prefer_contact_name):
    """Structured tapback. text is null so the Loved/Liked quote is not repeated as a message."""
    item = base_message_fields(row, cmap, prefer_contact_name, {})
    item["kind"] = "reaction"
    item["text"] = None
    item["link_preview"] = None
    item["reactions"] = []
    item["reaction"] = reaction
    return item


def present_rows(cursor, rows, cmap, prefer_contact_name, reactions_mode, transcribe=False):
    if not rows:
        return []
    msg_ids = [row["msg_id"] for row in rows]
    attachments_map = fetch_attachments_for_messages(cursor, msg_ids, transcribe=transcribe)
    target_guids = []
    for row in rows:
        if classify_associated_type(row.get("associated_message_type")):
            guid = target_guid_from_associated(row.get("associated_message_guid"))
            if guid:
                target_guids.append(guid)
    guid_to_id = lookup_message_guids(cursor, target_guids)
    for row in rows:
        if row.get("guid"):
            guid_to_id.setdefault(row["guid"], row["msg_id"])

    by_id = {}
    by_guid = {}
    for row in rows:
        if classify_associated_type(row.get("associated_message_type")):
            continue
        item = base_message_fields(row, cmap, prefer_contact_name, attachments_map)
        by_id[item["msg_id"]] = item
        if item.get("guid"):
            by_guid[item["guid"]] = item

    missing_parent_guids = []
    for row in rows:
        if classify_associated_type(row.get("associated_message_type")):
            continue
        raw_reply = row.get("reply_to_guid") or row.get("thread_originator_guid")
        p_guid = target_guid_from_associated(raw_reply)
        if p_guid and p_guid not in by_guid and p_guid not in missing_parent_guids:
            missing_parent_guids.append(p_guid)

    resolved_parents = {}
    if missing_parent_guids and cursor is not None:
        try:
            available = message_column_names(cursor)
            select_sql = message_select_list(available)
            placeholders = ",".join(["?"] * len(missing_parent_guids))
            parent_rows = fetch_message_dicts(
                cursor,
                select_sql,
                f"m.guid IN ({placeholders})",
                missing_parent_guids,
                MESSAGE_FROM_LOOSE,
            )
            if parent_rows:
                populate_cached_decoded_text(parent_rows)
                parent_msg_ids = [r["msg_id"] for r in parent_rows]
                parent_atts = fetch_attachments_for_messages(cursor, parent_msg_ids, transcribe=transcribe)
                for pr in parent_rows:
                    p_item = base_message_fields(pr, cmap, prefer_contact_name, parent_atts)
                    if p_item.get("guid"):
                        resolved_parents[p_item["guid"]] = p_item
        except Exception as e:
            sys.stderr.write(f"[Warning] Failed to fetch reply parent messages: {e}\n")

    for row in rows:
        if classify_associated_type(row.get("associated_message_type")):
            continue
        raw_reply = row.get("reply_to_guid") or row.get("thread_originator_guid")
        if not raw_reply:
            continue
        p_guid = target_guid_from_associated(raw_reply)
        if not p_guid:
            continue
        item = by_id.get(row["msg_id"])
        if not item:
            continue
        parent = by_guid.get(p_guid) or resolved_parents.get(p_guid)
        if parent:
            item["reply_to"] = {
                "msg_id": parent.get("msg_id"),
                "guid": parent.get("guid"),
                "sender": parent.get("sender"),
                "text": parent.get("text"),
            }
        else:
            item["reply_to"] = {
                "msg_id": None,
                "guid": p_guid,
                "sender": None,
                "text": None,
            }

    if reactions_mode == "separate":
        items = []
        for row in rows:
            if classify_associated_type(row.get("associated_message_type")):
                reaction = build_reaction_record(row, cmap, prefer_contact_name, guid_to_id)
                items.append(reaction_list_item(row, reaction, cmap, prefer_contact_name))
            else:
                items.append(by_id[row["msg_id"]])
        return items

    attached_ids = set()
    built_reactions = {}
    for row in rows:
        if not classify_associated_type(row.get("associated_message_type")):
            continue
        reaction = build_reaction_record(row, cmap, prefer_contact_name, guid_to_id)
        built_reactions[row["msg_id"]] = reaction
        target = by_guid.get(reaction.get("target_guid")) if reaction.get("target_guid") else None
        if target is None and reaction.get("target_msg_id") in by_id:
            target = by_id[reaction["target_msg_id"]]
        if target is not None:
            target["reactions"].append(reaction)
            attached_ids.add(row["msg_id"])

    items = []
    for row in rows:
        if classify_associated_type(row.get("associated_message_type")):
            if row["msg_id"] in attached_ids:
                continue
            reaction = built_reactions[row["msg_id"]]
            items.append(reaction_list_item(row, reaction, cmap, prefer_contact_name))
        else:
            items.append(by_id[row["msg_id"]])
    return items


def annotate_batch(items, scanned_rows, since_input):
    emitted = {item["msg_id"] for item in items}
    ordered_rows = sorted(scanned_rows, key=lambda row: row["msg_id"])
    max_id = ordered_rows[-1]["msg_id"] if ordered_rows else since_input
    ordered_items = sorted(items, key=lambda item: item["msg_id"])
    idx = 0
    for item in ordered_items:
        skipped = 0
        while idx < len(ordered_rows) and ordered_rows[idx]["msg_id"] < item["msg_id"]:
            row = ordered_rows[idx]
            if row["msg_id"] not in emitted and classify_associated_type(row.get("associated_message_type")):
                skipped += 1
            idx += 1
        item["skipped_before"] = {"reaction": skipped}
        item["next_since_msg_id"] = max_id
        if idx < len(ordered_rows) and ordered_rows[idx]["msg_id"] == item["msg_id"]:
            idx += 1
    filtered = 0
    for row in ordered_rows:
        if row["msg_id"] not in emitted and classify_associated_type(row.get("associated_message_type")):
            filtered += 1
    return {"reaction": filtered}, max_id


def emit_read_result(args, items, filtered, next_since, has_more, text_header, text_lines):
    for item in items:
        item.pop("_date_apple_s", None)
    if getattr(args, "json", False):
        if getattr(args, "with_meta", False):
            print(json.dumps({
                "messages": items,
                "filtered": filtered,
                "next_since_msg_id": next_since,
                "has_more": bool(has_more),
            }, indent=2))
        else:
            print(json.dumps(items, indent=2))
        return
    print(text_header)
    print("=" * 85)
    for line in text_lines:
        print(line)


def format_item_line(item, prefix_chat=False):
    if item.get("kind") == "call":
        dir_label = "Incoming" if item.get("direction") == "incoming" else "Outgoing"
        dur_str = f" ({item.get('duration_seconds')}s)" if (item.get("duration_seconds") or 0) > 0 else ""
        status_label = "Missed" if item.get("missed") else f"Answered{dur_str}"
        contact_str = f" ({item.get('contact_name')})" if item.get("contact_name") else ""
        chat_prefix = f"[{item.get('chat')}] " if prefix_chat and item.get("chat") else ""
        return (
            f"[{item['timestamp']}] {chat_prefix}[Call: {item.get('call_type')}] "
            f"{dir_label} {status_label} - {item.get('handle')}{contact_str}"
        )
    if item.get("kind") == "reaction":
        reaction = item.get("reaction") or {}
        emoji = f" {reaction['emoji']}" if reaction.get("emoji") else ""
        target = reaction.get("target_msg_id")
        target_bit = f" -> #{target}" if target else ""
        return (
            f"[{item['timestamp']}] {item['sender']} reaction "
            f"{reaction.get('type')}{emoji} {reaction.get('action')}{target_bit}"
        )
    edit_marker = f" [Edited ({item['edit_count']}x)]" if item.get("is_edited") else ""
    msg_text = item.get("text") or ""
    if item.get("attachments"):
        att_strs = []
        for att in item["attachments"]:
            dur_str = f", duration: {att['duration_formatted']}" if att.get("duration_formatted") else ""
            path_str = f", path: {att['filename']}" if att.get("filename") else ""
            att_strs.append(
                f"[Attachment: {att['transfer_name']} ({att['mime_type']}, {att['size']}{dur_str}{path_str})]"
            )
        att_desc = " ".join(att_strs)
        if msg_text and not msg_text.startswith("[voice note") and msg_text != "<empty message>":
            msg_text = f"{msg_text} {att_desc}".strip()
        elif msg_text.startswith("[voice note"):
            msg_text = f"{msg_text} {att_desc}".strip()
        else:
            msg_text = att_desc or msg_text
    preview = item.get("link_preview")
    if preview:
        bits = [preview.get("title"), preview.get("artist") or preview.get("subtitle"), preview.get("site_name")]
        summary = " | ".join([b for b in bits if b])
        if summary:
            msg_text = f"{msg_text} [link: {summary}]".strip()
    if item.get("reactions"):
        bits = []
        for reaction in item["reactions"]:
            emoji = f" {reaction['emoji']}" if reaction.get("emoji") else ""
            bits.append(f"{reaction['type']}{emoji} {reaction['action']} by {reaction['sender']}")
        msg_text = f"{msg_text} [reactions: {'; '.join(bits)}]"
    reply_prefix = ""
    reply = item.get("reply_to")
    if reply:
        r_sender = reply.get("sender") or "someone"
        r_text = reply.get("text") or ""
        if r_text and r_text != "<empty message>":
            snippet = r_text.replace("\n", " ").strip()
            if len(snippet) > 80:
                snippet = snippet[:77] + "..."
            reply_prefix = f"[Replying to {r_sender}: \"{snippet}\"] "
        else:
            reply_prefix = f"[Replying to {r_sender}] "
    status_suffix = ""
    if item.get("is_from_me"):
        if item.get("is_read"):
            read_str = f" at {item['read_at']}" if item.get("read_at") else ""
            status_suffix = f" [Read{read_str}]"
        elif item.get("delivered_quietly") or item.get("notifications_silenced"):
            status_suffix = " [Delivered quietly / Notifications silenced]"
        elif item.get("is_delivered"):
            deliv_str = f" at {item['delivered_at']}" if item.get("delivered_at") else ""
            status_suffix = f" [Delivered{deliv_str}]"
    chat_bit = f" [{item['chat']}]" if prefix_chat else ""
    return f"[{item['timestamp']}]{edit_marker}{chat_bit} {item['sender']}: {reply_prefix}{msg_text}{status_suffix}"


def reaction_predicate(available):
    if "associated_message_type" not in available:
        return "0"
    return (
        "(COALESCE(m.associated_message_type, 0) BETWEEN 2000 AND 2006 "
        "OR COALESCE(m.associated_message_type, 0) BETWEEN 3000 AND 3006)"
    )


def finish_no_chat(conn, args, target):
    if getattr(args, "json", False):
        if getattr(args, "with_meta", False):
            since = getattr(args, "since_msg_id", None)
            print(json.dumps({
                "messages": [],
                "filtered": {"reaction": 0},
                "next_since_msg_id": since,
                "has_more": False,
            }, indent=2))
        else:
            print(json.dumps([]))
        conn.close()
        return
    print(f"ERROR: No chat found matching '{target}'", file=sys.stderr)
    conn.close()
    sys.exit(1)


def presentation_options(args):
    if getattr(args, "include_filtered", False):
        return "separate"
    mode = getattr(args, "reactions", None) or "attach"
    if mode not in ("attach", "separate"):
        return "attach"
    return mode


def fetch_reactions_for_messages(cursor, select_sql, chat_ids, message_rows, available):
    if "associated_message_type" not in available:
        return []
    guids = [row.get("guid") for row in message_rows if row.get("guid")]
    if not guids:
        return []
    placeholders = chat_placeholders(chat_ids)
    guid_clauses = []
    params = list(chat_ids)
    for guid in guids:
        guid_clauses.append(
            "(m.associated_message_guid = ? OR m.associated_message_guid = ? OR m.associated_message_guid LIKE ?)"
        )
        params.extend([guid, f"bp:{guid}", f"p:%/{guid}"])
    where = (
        f"c.ROWID IN ({placeholders}) AND {reaction_predicate(available)} "
        f"AND ({' OR '.join(guid_clauses)})"
    )
    return fetch_message_dicts(cursor, select_sql, where, params)


def dedupe_rows(rows):
    seen = set()
    ordered = []
    for row in sorted(rows, key=lambda item: item["msg_id"]):
        if row["msg_id"] in seen:
            continue
        seen.add(row["msg_id"])
        ordered.append(row)
    return ordered


def add_read_presentation_args(parser, *, with_limit=False, with_days=False, default_limit=5):
    if with_days:
        parser.add_argument("--days", type=int, default=14, help="Days of history to fetch (default 14)")
    if with_limit:
        parser.add_argument("--limit", type=int, default=default_limit, help=f"Maximum rows to return (default {default_limit})")
    parser.add_argument(
        "--since-msg-id",
        "--since-message-id",
        "--since-id",
        "--after-id",
        "--after-msg-id",
        dest="since_msg_id",
        type=int,
        default=None,
        help="Only rows in this chat with ROWID strictly greater than this id (polling cursor)",
    )
    parser.add_argument(
        "--reactions",
        choices=["attach", "separate"],
        default="attach",
        help="Attach tapbacks to the message they target, or list them as structured records",
    )
    parser.add_argument(
        "--include-filtered",
        action="store_true",
        help="Keep filtered rows (tapbacks) inline as structured records so ids are visible",
    )
    parser.add_argument(
        "--include-calls",
        action="store_true",
        default=False,
        help="Merge phone and FaceTime calls with chat participants into the timeline in chronological order",
    )
    parser.add_argument(
        "--with-meta",
        action="store_true",
        help="Wrap JSON as {messages, filtered, next_since_msg_id, has_more}",
    )
    parser.add_argument(
        "--transcribe",
        action="store_true",
        default=False,
        help="Trigger on-demand local transcription for voice notes missing transcripts",
    )
    parser.add_argument("--json", action="store_true", help="Output results in JSON format")

def call_record_columns(cursor):
    try:
        cursor.execute("PRAGMA table_info(ZCALLRECORD)")
        return {row[1].upper() for row in cursor.fetchall()}
    except Exception:
        return set()

def map_call_type(call_type, service_provider=None):
    if call_type == 1:
        return "phone"
    elif call_type == 8:
        return "facetime_video"
    elif call_type == 16:
        return "facetime_audio"
    elif call_type == 0:
        if service_provider == "com.apple.Telephony":
            return "phone"
        return "unknown"
    elif call_type is None:
        if service_provider == "com.apple.Telephony":
            return "phone"
        elif service_provider == "com.apple.FaceTime":
            return "facetime_video"
        return "unknown"
    else:
        return call_type

def parse_date_boundary(val):
    if val is None:
        return None
    val_str = str(val).strip()
    if not val_str:
        return None
    try:
        num = float(val_str)
        if num > 1_000_000_000:
            return num - 978307200.0
        return num
    except ValueError:
        pass
    try:
        dt = datetime.datetime.fromisoformat(val_str.replace("Z", "+00:00"))
        if dt.tzinfo is None:
            dt = dt.astimezone()
        return (dt - APPLE_EPOCH).total_seconds()
    except Exception:
        pass
    return None

def fetch_call_records(conn, handles=None, since=None, until=None, call_type_filter=None, limit=30, cmap=None):
    cursor = conn.cursor()
    available = call_record_columns(cursor)
    if not available:
        return []

    pk_col = "Z_PK" if "Z_PK" in available else "ROWID"
    uid_col = "ZUNIQUE_ID" if "ZUNIQUE_ID" in available else "NULL"
    addr_col = "ZADDRESS" if "ZADDRESS" in available else "NULL"
    date_col = "ZDATE" if "ZDATE" in available else "NULL"
    dur_col = "ZDURATION" if "ZDURATION" in available else "0.0"
    orig_col = "ZORIGINATED" if "ZORIGINATED" in available else "0"
    ans_col = "ZANSWERED" if "ZANSWERED" in available else "0"
    type_col = "ZCALLTYPE" if "ZCALLTYPE" in available else "NULL"
    prov_col = "ZSERVICE_PROVIDER" if "ZSERVICE_PROVIDER" in available else "NULL"
    name_col = "ZNAME" if "ZNAME" in available else "NULL"

    sql_select = f"""
        SELECT 
            {pk_col} AS pk,
            {uid_col} AS unique_id,
            {addr_col} AS address,
            {date_col} AS date_s,
            {dur_col} AS duration,
            {orig_col} AS originated,
            {ans_col} AS answered,
            {type_col} AS call_type,
            {prov_col} AS service_provider,
            {name_col} AS name
        FROM ZCALLRECORD
    """

    where_clauses = []
    params = []
    since_s = parse_date_boundary(since)
    if since_s is not None and "ZDATE" in available:
        where_clauses.append("ZDATE > ?")
        params.append(since_s)

    until_s = parse_date_boundary(until)
    if until_s is not None and "ZDATE" in available:
        where_clauses.append("ZDATE < ?")
        params.append(until_s)

    where_sql = f"WHERE {' AND '.join(where_clauses)}" if where_clauses else ""
    order_sql = "ORDER BY ZDATE DESC" if "ZDATE" in available else ""
    query = f"{sql_select} {where_sql} {order_sql}"

    cursor.execute(query, params)
    rows = cursor.fetchall()

    norm_target_handles = None
    if handles:
        norm_target_handles = {normalize_handle(h) for h in handles if normalize_handle(h)}

    if cmap is None:
        cmap = get_contacts_map()

    calls = []
    for r in rows:
        pk, uid, raw_addr, date_s, duration, orig, ans, ctype, prov, cname = r
        if raw_addr and isinstance(raw_addr, bytes):
            raw_addr = raw_addr.decode('utf-8', errors='ignore')
        raw_addr = str(raw_addr) if raw_addr is not None else ""
        norm_addr = normalize_handle(raw_addr)

        if norm_target_handles is not None:
            matched = False
            if norm_addr in norm_target_handles:
                matched = True
            elif raw_addr and raw_addr.lower() in norm_target_handles:
                matched = True
            elif raw_addr:
                for th in norm_target_handles:
                    if th and (th in norm_addr or norm_addr in th):
                        matched = True
                        break
            if not matched:
                continue

        mapped_type = map_call_type(ctype, prov)
        if call_type_filter:
            ctf = str(call_type_filter).lower().strip()
            if ctf == "facetime":
                if mapped_type not in ("facetime_video", "facetime_audio"):
                    continue
            elif str(mapped_type).lower() != ctf:
                continue

        is_orig = bool(orig == 1)
        direction = "outgoing" if is_orig else "incoming"
        is_ans = bool(ans == 1)
        is_missed = bool(not is_orig and not is_ans)

        dur_sec = round(float(duration or 0.0), 2)
        human_ts, iso_ts = format_apple_seconds(date_s)

        contact_name = cmap.get(norm_addr)
        if not contact_name and cname:
            contact_name = str(cname)

        calls.append({
            "id": uid or (str(pk) if pk is not None else ""),
            "handle": raw_addr,
            "contact_name": contact_name,
            "direction": direction,
            "answered": is_ans,
            "missed": is_missed,
            "duration_seconds": dur_sec,
            "call_type": mapped_type,
            "timestamp": human_ts,
            "timestamp_iso": iso_ts,
            "_date_apple_s": float(date_s or 0.0),
        })

        if limit and len(calls) >= limit:
            break

    return calls

def get_calls_for_chat_ids(imsg_cursor, chat_ids, since_date_s=None, until_date_s=None, cmap=None):
    call_conn, err = get_call_history_connection()
    if not call_conn:
        return []
    handles = set()
    try:
        placeholders = ",".join("?" * len(chat_ids))
        imsg_cursor.execute(f"""
            SELECT h.id FROM chat_handle_join chj
            JOIN handle h ON chj.handle_id = h.ROWID
            WHERE chj.chat_id IN ({placeholders})
        """, chat_ids)
        for r in imsg_cursor.fetchall():
            if r[0]:
                handles.add(r[0])
        imsg_cursor.execute(f"""
            SELECT chat_identifier FROM chat WHERE ROWID IN ({placeholders})
        """, chat_ids)
        for r in imsg_cursor.fetchall():
            if r[0] and not r[0].startswith("chat"):
                handles.add(r[0])
    except Exception:
        pass

    if not handles:
        call_conn.close()
        return []

    calls = fetch_call_records(
        call_conn,
        handles=list(handles),
        since=since_date_s,
        until=until_date_s,
        limit=100,
        cmap=cmap
    )
    call_conn.close()
    return calls

def merge_calls_into_timeline(items, calls):
    if not calls:
        return items
    call_items = []
    for call in calls:
        call_item = {
            "kind": "call",
            "id": call["id"],
            "handle": call["handle"],
            "contact_name": call.get("contact_name"),
            "sender": call.get("contact_name") or call.get("handle") if call.get("direction") == "incoming" else "Me",
            "direction": call["direction"],
            "answered": call["answered"],
            "missed": call["missed"],
            "duration_seconds": call["duration_seconds"],
            "call_type": call["call_type"],
            "timestamp": call["timestamp"],
            "timestamp_iso": call["timestamp_iso"],
            "text": None,
            "_date_apple_s": call.get("_date_apple_s", 0.0),
        }
        call_items.append(call_item)

    combined = items + call_items
    combined.sort(key=lambda x: x.get("_date_apple_s", 0.0))
    return combined

def get_call_history(args):
    call_conn, err = get_call_history_connection()
    if err:
        if getattr(args, "json", False):
            print(json.dumps({
                "available": False,
                "error": err,
                "calls": []
            }, indent=2))
        else:
            print(f"ERROR: {err}", file=sys.stderr)
        return

    handles = set()
    cmap = get_contacts_map()

    chat_arg = getattr(args, "chat", None)
    if chat_arg:
        try:
            imsg_conn = get_db_connection()
            c_imsg = imsg_conn.cursor()
            chat_ids = resolve_chat_ids(c_imsg, chat_arg)
            if chat_ids:
                placeholders = ",".join("?" * len(chat_ids))
                c_imsg.execute(f"""
                    SELECT h.id FROM chat_handle_join chj
                    JOIN handle h ON chj.handle_id = h.ROWID
                    WHERE chj.chat_id IN ({placeholders})
                """, chat_ids)
                for r in c_imsg.fetchall():
                    if r[0]:
                        handles.add(r[0])
                c_imsg.execute(f"""
                    SELECT chat_identifier FROM chat WHERE ROWID IN ({placeholders})
                """, chat_ids)
                for r in c_imsg.fetchall():
                    if r[0] and not r[0].startswith("chat"):
                        handles.add(r[0])
            imsg_conn.close()
        except Exception:
            pass

    handle_arg = getattr(args, "handle", None)
    if handle_arg:
        handles.add(handle_arg)
        norm_arg = normalize_handle(handle_arg)
        if norm_arg:
            handles.add(norm_arg)
        arg_lower = handle_arg.strip().lower()
        for norm_h, cname in cmap.items():
            if cname and cname.strip().lower() == arg_lower:
                handles.add(norm_h)

    limit = getattr(args, "limit", 30) or 30
    calls = fetch_call_records(
        call_conn,
        handles=list(handles) if (chat_arg or handle_arg) else None,
        since=getattr(args, "since", None),
        until=getattr(args, "until", None),
        call_type_filter=getattr(args, "call_type", None),
        limit=limit,
        cmap=cmap
    )
    call_conn.close()

    clean_calls = []
    for c in calls:
        rec = {k: v for k, v in c.items() if not k.startswith("_")}
        clean_calls.append(rec)

    if getattr(args, "json", False):
        print(json.dumps(clean_calls, indent=2))
        return

    header = f"CALL HISTORY ({len(clean_calls)} calls found):"
    print(header)
    print("=" * 85)
    for c in clean_calls:
        dir_label = "Incoming" if c["direction"] == "incoming" else "Outgoing"
        dur_label = f" ({c['duration_seconds']}s)" if c['duration_seconds'] > 0 else ""
        status_label = "Missed" if c["missed"] else f"Answered{dur_label}"
        name_str = f" ({c['contact_name']})" if c['contact_name'] else ""
        print(f"[{c['timestamp']}] [{c['call_type']}] {dir_label} {status_label} - {c['handle']}{name_str}")

def read_messages(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    target = args.chat
    chat_ids = resolve_chat_ids(cursor, target)
    if not chat_ids:
        finish_no_chat(conn, args, target)
        return

    available = message_column_names(cursor)
    select_sql = message_select_list(available)
    placeholders = chat_placeholders(chat_ids)
    now = datetime.datetime.now(datetime.timezone.utc)
    threshold_dt = now - datetime.timedelta(days=args.days)
    threshold_ns = int((threshold_dt - APPLE_EPOCH).total_seconds() * 1_000_000_000)
    where = f"c.ROWID IN ({placeholders}) AND m.date >= ?"
    params = [*chat_ids, threshold_ns]
    since = getattr(args, "since_msg_id", None)
    if since is not None:
        where += " AND m.ROWID > ?"
        params.append(since)
    where += " ORDER BY m.ROWID ASC"
    rows = fetch_message_dicts(cursor, select_sql, where, params)
    populate_cached_decoded_text(rows)
    mode = presentation_options(args)
    items = present_rows(cursor, rows, None, False, mode, transcribe=getattr(args, "transcribe", False))
    filtered, next_since = annotate_batch(items, rows, since)
    if getattr(args, "include_calls", False):
        cmap = get_contacts_map()
        calls = get_calls_for_chat_ids(cursor, chat_ids, since_date_s=threshold_ns / 1_000_000_000, cmap=cmap)
        items = merge_calls_into_timeline(items, calls)
    header = f"READING MESSAGES FROM THE LAST {args.days} DAYS FOR '{target}' ({len(items)} shown):"
    lines = [format_item_line(item, prefix_chat=True) for item in items]
    emit_read_result(args, items, filtered, next_since, False, header, lines)
    conn.close()

def search_messages(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    query_str = args.query
    limit = args.limit or 30
    order = getattr(args, "order", None) or "recent"
    if order not in ("recent", "relevance"):
        order = "recent"
    available = message_column_names(cursor)
    select_sql = message_select_list(available)
    since = getattr(args, "since_msg_id", None)
    chat_filter = getattr(args, "chat", None)

    use_index = is_index_healthy_and_caught_up()
    matching_ids = None

    if use_index:
        try:
            fts_query = format_fts5_query(query_str)
            if not fts_query:
                matching_ids = []
            else:
                conn_idx = get_index_db_connection(read_only=True)
                cur_idx = conn_idx.cursor()
                where_clauses = ["messages_fts MATCH ?"]
                params = [fts_query]

                if since is not None:
                    where_clauses.append("idx.msg_id > ?")
                    params.append(since)

                if chat_filter:
                    chat_ids = resolve_chat_ids(cursor, chat_filter)
                    if chat_ids:
                        placeholders = ",".join(["?"] * len(chat_ids))
                        where_clauses.append(f"idx.chat_id IN ({placeholders})")
                        params.extend(chat_ids)
                    else:
                        where_clauses.append("1 = 0")

                order_sql = "bm25(messages_fts) ASC, idx.date DESC" if order == "relevance" else "idx.date DESC, idx.msg_id DESC"
                sql = f"""
                    SELECT idx.msg_id
                    FROM messages_fts fts
                    JOIN messages_idx idx ON fts.rowid = idx.msg_id
                    WHERE {' AND '.join(where_clauses)}
                    ORDER BY {order_sql}
                    LIMIT ?
                """
                params.append(int(limit) + 1)
                cur_idx.execute(sql, params)
                matching_ids = [r[0] for r in cur_idx.fetchall()]
                conn_idx.close()
        except Exception as err:
            sys.stderr.write(f"[Index] Warning: FTS query failed ({err}). Falling back to live chat.db search.\n")
            use_index = False
            matching_ids = None

    if matching_ids is not None:
        has_more = len(matching_ids) > limit
        if has_more:
            matching_ids = matching_ids[:limit]

        if not matching_ids:
            rows = []
        else:
            placeholders = ",".join(["?"] * len(matching_ids))
            fetched = fetch_message_dicts(cursor, select_sql, f"m.ROWID IN ({placeholders})", matching_ids)
            row_map = {r["msg_id"]: r for r in fetched}
            rows = [row_map[mid] for mid in matching_ids if mid in row_map]
    else:
        cached_att_matches = []
        try:
            t_conn = get_transcripts_db_connection(read_only=True)
            if t_conn:
                tc = t_conn.cursor()
                tc.execute("SELECT attachment_path, attachment_guid FROM transcripts WHERE transcription LIKE ?", (f"%{query_str}%",))
                for ap, ag in tc.fetchall():
                    if ap: cached_att_matches.append(ap)
                    if ag: cached_att_matches.append(ag)
                t_conn.close()
        except Exception:
            pass

        cached_cond = ""
        cached_params = []
        if cached_att_matches:
            c_holders = ",".join(["?"] * len(cached_att_matches))
            cached_cond = f" OR a.filename IN ({c_holders}) OR a.guid IN ({c_holders})"
            cached_params = cached_att_matches + cached_att_matches

        where = f"""(
            m.text LIKE ?
            OR (m.text IS NULL AND m.attributedBody LIKE ?)
            OR EXISTS (
                SELECT 1 FROM message_attachment_join maj
                JOIN attachment a ON maj.attachment_id = a.ROWID
                WHERE maj.message_id = m.ROWID AND (a.user_info LIKE ?{cached_cond})
            )
        )"""
        params = [f"%{query_str}%", f"%{query_str}%", f"%{query_str}%"] + cached_params
        if since is not None:
            where += " AND m.ROWID > ?"
            params.append(since)
        if chat_filter:
            chat_ids = resolve_chat_ids(cursor, chat_filter)
            if chat_ids:
                placeholders = chat_placeholders(chat_ids)
                where += f" AND c.ROWID IN ({placeholders})"
                params.extend(chat_ids)
            else:
                where += " AND 1 = 0"

        where += " ORDER BY m.date DESC LIMIT ?"
        params.append(int(limit) + 1)
        rows = fetch_message_dicts(cursor, select_sql, where, params)
        has_more = len(rows) > limit
        if has_more:
            rows = rows[:limit]

    populate_cached_decoded_text(rows)
    mode = presentation_options(args)
    items = present_rows(cursor, rows, None, False, mode, transcribe=getattr(args, "transcribe", False))
    filtered, next_since = annotate_batch(items, rows, since)
    header = f"SEARCH RESULTS FOR '{query_str}' ({len(items)} matching messages found):"
    lines = []
    for item in items:
        line = format_item_line(item)
        lines.append(f"{line} [Chat {item.get('chat_id')}: {item.get('chat')}]")
    emit_read_result(args, items, filtered, next_since, has_more, header, lines)
    conn.close()

def search_contacts(args):
    query = (args.query or "").lower()
    if is_index_enabled():
        db_path = get_index_db_path()
        if os.path.exists(db_path):
            try:
                conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
                c = conn.cursor()
                if query:
                    c.execute("""
                        SELECT handle, display_name FROM contacts_idx
                        WHERE LOWER(handle) LIKE ? OR LOWER(display_name) LIKE ?
                    """, (f"%{query}%", f"%{query}%"))
                else:
                    c.execute("SELECT handle, display_name FROM contacts_idx LIMIT 100")
                rows = c.fetchall()
                conn.close()
                if rows:
                    contacts = []
                    for h, name in rows:
                        contacts.append({
                            'name': name or "Unknown",
                            'organization': "",
                            'phone': h if '@' not in h else "",
                            'email': h if '@' in h else ""
                        })
                    if getattr(args, 'json', False):
                        print(json.dumps(contacts, indent=2))
                    else:
                        print(f"{'Name':<30} | {'Phone / Email':<30}")
                        print("-" * 65)
                        for c_item in contacts:
                            target = c_item['phone'] or c_item['email']
                            print(f"{c_item['name']:<30} | {target:<30}")
                    return
            except Exception:
                pass
    ab_paths = glob.glob(os.path.expanduser('~/Library/Application Support/AddressBook/**/*.abcddb'), recursive=True)
    
    contacts = []
    for p in ab_paths:
        try:
            conn = sqlite3.connect(f"file:{p}?mode=ro", uri=True)
            c = conn.cursor()
            sql = """
            SELECT 
                r.ZFIRSTNAME, r.ZLASTNAME, r.ZORGANIZATION,
                p.ZFULLNUMBER, e.ZADDRESS
            FROM ZABCDRECORD r
            LEFT JOIN ZABCDPHONENUMBER p ON r.Z_PK = p.ZOWNER
            LEFT JOIN ZABCDEMAILADDRESS e ON r.Z_PK = e.ZOWNER
            """
            c.execute(sql)
            for fname, lname, org, phone, email in c.fetchall():
                full_name = " ".join(filter(None, [fname, lname]))
                search_target = " ".join(filter(None, [full_name, org, phone, email])).lower()
                if not query or query in search_target:
                    contacts.append({
                        'name': full_name or org or "Unknown",
                        'organization': org or "",
                        'phone': phone or "",
                        'email': email or ""
                    })
            conn.close()
        except Exception:
            pass

    # Deduplicate
    unique = []
    seen = set()
    for c in contacts:
        key = (c['name'], c['phone'], c['email'])
        if key not in seen:
            seen.add(key)
            unique.append(c)

    if getattr(args, 'json', False):
        print(json.dumps(unique, indent=2))
    else:
        print(f"CONTACT RESULTS ({len(unique)} contacts found):")
        print(f"{'Name':<25} | {'Organization':<20} | {'Phone':<18} | {'Email':<25}")
        print("-" * 95)
        for c in unique[:50]:
            print(f"{c['name']:<25} | {c['organization']:<20} | {c['phone']:<18} | {c['email']:<25}")

def get_members(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    target = args.chat
    
    chat_ids = []
    if target.isdigit():
        chat_ids = [int(target)]
    else:
        cursor.execute(
            "SELECT ROWID FROM chat WHERE display_name LIKE ? OR chat_identifier LIKE ?", 
            (f"%{target}%", f"%{target}%")
        )
        chat_ids = [r[0] for r in cursor.fetchall()]
        
    if not chat_ids:
        if getattr(args, 'json', False):
            print(json.dumps([]))
            conn.close()
            return
        print(f"ERROR: No chat found matching '{target}'", file=sys.stderr)
        conn.close()
        sys.exit(1)
        
    placeholders = ",".join(["?"] * len(chat_ids))
    query = f"""
    SELECT 
        c.ROWID,
        COALESCE(c.display_name, ''),
        c.chat_identifier,
        h.id,
        h.service
    FROM chat c
    JOIN chat_handle_join chj ON c.ROWID = chj.chat_id
    JOIN handle h ON chj.handle_id = h.ROWID
    WHERE c.ROWID IN ({placeholders})
    """
    cursor.execute(query, chat_ids)
    rows = cursor.fetchall()
    
    members = []
    for rowid, display_name, chat_ident, handle_id, service in rows:
        name = display_name if display_name else chat_ident
        members.append({
            'chat_id': rowid,
            'display_name': name,
            'handle': handle_id,
            'service': service
        })

    if getattr(args, 'json', False):
        print(json.dumps(members, indent=2))
    else:
        print(f"MEMBERS FOR CHAT '{target}' ({len(members)} members):")
        print(f"{'Chat ID':<8} | {'Chat Name':<25} | {'Handle / Phone':<30} | {'Service':<10}")
        print("-" * 80)
        for m in members:
            print(f"{m['chat_id']:<8} | {m['display_name']:<25} | {m['handle']:<30} | {m['service']:<10}")
    conn.close()

def resolve_attachment_for_message(message_id, image_only=False):
    """Resolve an attachment filepath from chat.db by message ROWID."""
    try:
        conn = sqlite3.connect(f"file:{get_db_path()}?mode=ro", uri=True)
        c = conn.cursor()
        c.execute("""
            SELECT a.filename, a.mime_type, a.transfer_name, a.total_bytes, a.ROWID
            FROM attachment a
            JOIN message_attachment_join maj ON a.ROWID = maj.attachment_id
            WHERE maj.message_id = ?
            ORDER BY a.ROWID ASC
        """, (message_id,))
        rows = c.fetchall()
        conn.close()
    except Exception as e:
        return None, None, f"Database error querying attachments for message #{message_id}: {e}"

    if not rows:
        return None, None, f"No attachments found for message #{message_id}"

    image_exts = ('.jpg', '.jpeg', '.png', '.heic', '.heif', '.gif', '.webp', '.tiff', '.bmp')
    for row in rows:
        fn, mime, tname, size, rowid = row
        if fn:
            p = os.path.abspath(os.path.expanduser(fn))
            ext = os.path.splitext(p)[1].lower()
            is_img = (mime and mime.startswith('image/')) or ext in image_exts
            if not image_only or is_img:
                return p, mime, None

    if not image_only and rows[0][0]:
        return os.path.abspath(os.path.expanduser(rows[0][0])), rows[0][1], None

    return None, None, f"No image attachment found for message #{message_id}"


def resolve_attachment_sticker_info(filepath, message_id=None):
    """Resolve is_sticker, sticker_pack, sticker_description for an attachment file or message_id."""
    is_sticker = False
    sticker_pack = None
    sticker_desc = None
    if filepath and ("stickercache" in filepath.lower() or "/stickers/" in filepath.lower()):
        is_sticker = True

    try:
        conn = sqlite3.connect(f"file:{get_db_path()}?mode=ro", uri=True)
        c = conn.cursor()
        c.execute("PRAGMA table_info(attachment)")
        att_cols = {r[1] for r in c.fetchall()}

        is_sticker_sel = "a.is_sticker" if "is_sticker" in att_cols else "0 AS is_sticker"
        attr_info_sel = "a.attribution_info" if "attribution_info" in att_cols else "NULL AS attribution_info"
        emoji_desc_sel = "a.emoji_image_short_description" if "emoji_image_short_description" in att_cols else "NULL AS emoji_image_short_description"
        sticker_user_info_sel = "a.sticker_user_info" if "sticker_user_info" in att_cols else "NULL AS sticker_user_info"

        row = None
        if message_id:
            c.execute(f"""
                SELECT a.user_info, {attr_info_sel}, {emoji_desc_sel}, {is_sticker_sel}, a.uti, {sticker_user_info_sel}, a.filename
                FROM attachment a
                JOIN message_attachment_join maj ON a.ROWID = maj.attachment_id
                WHERE maj.message_id = ?
                ORDER BY a.ROWID ASC LIMIT 1
            """, (message_id,))
            row = c.fetchone()

        if not row and filepath:
            basename = os.path.basename(filepath)
            normpath = filepath.replace(os.path.expanduser('~'), '~')
            c.execute(f"""
                SELECT a.user_info, {attr_info_sel}, {emoji_desc_sel}, {is_sticker_sel}, a.uti, {sticker_user_info_sel}, a.filename
                FROM attachment a
                WHERE a.filename = ? OR a.filename = ? OR a.filename LIKE ?
                ORDER BY (CASE WHEN a.filename = ? OR a.filename = ? THEN 0 ELSE 1 END), a.ROWID DESC LIMIT 1
            """, (filepath, normpath, f"%{basename}", filepath, normpath))
            row = c.fetchone()

        if row:
            u_info, attr_info, emoji_desc, is_stk, uti_val, stk_u_info, a_fn = row
            stk_flag, pack, desc = extract_sticker_metadata(
                u_info, attr_info, emoji_desc, uti_val, filepath or a_fn, is_stk, stk_u_info
            )
            is_sticker = is_sticker or stk_flag
            if pack:
                sticker_pack = pack
            if desc:
                sticker_desc = desc

        conn.close()
    except Exception:
        pass

    return is_sticker, sticker_pack, sticker_desc


def download_image(args):
    """Download and extract an image attachment with optional format conversion to JPEG or PNG."""
    filepath = getattr(args, 'path', None)
    message_id = getattr(args, 'message_id', None)
    output_path = getattr(args, 'output_path', None)
    include_base64 = getattr(args, 'include_base64', True)
    format_arg = getattr(args, 'format', 'auto') or 'auto'

    if not filepath and message_id:
        filepath, _, err = resolve_attachment_for_message(message_id, image_only=True)
        if err or not filepath:
            err_res = {
                "success": False,
                "message": err or f"No image found for message #{message_id}",
                "message_id": message_id,
                "file_path": None,
                "mime_type": None,
                "size_bytes": 0,
                "base64": None,
                "is_sticker": False,
                "sticker_pack": None,
                "sticker_description": None
            }
            if getattr(args, 'json', False):
                print(json.dumps(err_res, indent=2))
            else:
                print(f"ERROR: {err_res['message']}", file=sys.stderr)
            sys.exit(1)

    if not filepath:
        err_res = {
            "success": False,
            "message": "Either --path or --message-id must be provided",
            "message_id": message_id,
            "file_path": None,
            "mime_type": None,
            "size_bytes": 0,
            "base64": None,
            "is_sticker": False,
            "sticker_pack": None,
            "sticker_description": None
        }
        if getattr(args, 'json', False):
            print(json.dumps(err_res, indent=2))
        else:
            print("ERROR: Either --path or --message-id must be provided", file=sys.stderr)
        sys.exit(1)

    filepath = os.path.abspath(os.path.expanduser(filepath))
    if not os.path.exists(filepath):
        err_res = {
            "success": False,
            "message": f"Attachment file not found at '{filepath}'",
            "message_id": message_id,
            "file_path": filepath,
            "mime_type": None,
            "size_bytes": 0,
            "base64": None,
            "is_sticker": False,
            "sticker_pack": None,
            "sticker_description": None
        }
        if getattr(args, 'json', False):
            print(json.dumps(err_res, indent=2))
        else:
            print(f"ERROR: Attachment file not found at '{filepath}'", file=sys.stderr)
        sys.exit(1)

    is_sticker, sticker_pack, sticker_description = resolve_attachment_sticker_info(filepath, message_id)

    target_path = filepath
    mime = "application/octet-stream"
    ext = os.path.splitext(filepath)[1].lower()
    parent_name = os.path.basename(os.path.dirname(filepath)) or "file"
    file_base = os.path.splitext(os.path.basename(filepath))[0]

    if ext in ['.heic', '.heif']:
        conv_format = "png" if (is_sticker or format_arg == "png") else "jpeg"
        conv_ext = "png" if conv_format == "png" else "jpg"
        conv_mime = "image/png" if conv_format == "png" else "image/jpeg"
        converted_path = f"/tmp/imessage_conv_{parent_name}_{file_base}.{conv_ext}"
        subprocess.run(['sips', '-s', 'format', conv_format, filepath, '--out', converted_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if os.path.exists(converted_path):
            target_path = converted_path
            mime = conv_mime
    elif ext in ['.jpg', '.jpeg']:
        mime = "image/jpeg"
    elif ext == '.png':
        mime = "image/png"
    elif ext == '.gif':
        mime = "image/gif"
    elif ext == '.webp':
        mime = "image/webp"
    elif ext == '.tiff':
        mime = "image/tiff"
    elif ext == '.bmp':
        mime = "image/bmp"

    final_path = target_path
    if output_path:
        out_abs = os.path.abspath(os.path.expanduser(output_path))
        os.makedirs(os.path.dirname(out_abs), exist_ok=True)
        import shutil
        shutil.copy2(target_path, out_abs)
        final_path = out_abs

    size_bytes = os.path.getsize(final_path)
    b64_str = None
    if include_base64:
        with open(final_path, 'rb') as f:
            b64_str = base64.b64encode(f.read()).decode('utf-8')

    res = {
        "success": True,
        "message": "Image downloaded successfully",
        "message_id": message_id,
        "file_path": final_path,
        "mime_type": mime,
        "size_bytes": size_bytes,
        "base64": b64_str,
        "is_sticker": bool(is_sticker),
        "sticker_pack": sticker_pack,
        "sticker_description": sticker_description
    }

    if getattr(args, 'json', False):
        print(json.dumps(res, indent=2))
    else:
        stk_str = " (sticker)" if is_sticker else ""
        print(f"Image downloaded: {final_path} ({size_bytes} bytes, {mime}){stk_str}")


def get_attachment_payload(args):
    filepath = getattr(args, 'path_flag', None) or getattr(args, 'path', None)
    message_id = getattr(args, 'message_id', None)
    if not filepath and message_id:
        filepath, _, err = resolve_attachment_for_message(message_id, image_only=False)
        if err or not filepath:
            print(f"ERROR: {err or 'Attachment not found'}", file=sys.stderr)
            sys.exit(1)

    if not filepath:
        print("ERROR: Missing required argument 'path' or '--message-id'", file=sys.stderr)
        sys.exit(1)

    filepath = os.path.abspath(os.path.expanduser(filepath))
    if not os.path.exists(filepath):
        print(f"ERROR: Attachment file not found at '{filepath}'", file=sys.stderr)
        sys.exit(1)
        
    is_sticker, sticker_pack, sticker_description = resolve_attachment_sticker_info(filepath, message_id)

    target_path = filepath
    mime = "application/octet-stream"
    ext = os.path.splitext(filepath)[1].lower()
    parent_name = os.path.basename(os.path.dirname(filepath)) or "file"
    file_base = os.path.splitext(os.path.basename(filepath))[0]
    
    if ext in ['.heic', '.heif']:
        conv_format = "png" if is_sticker else "jpeg"
        conv_ext = "png" if conv_format == "png" else "jpg"
        conv_mime = "image/png" if conv_format == "png" else "image/jpeg"
        conv_path = f"/tmp/imessage_conv_{parent_name}_{file_base}.{conv_ext}"
        subprocess.run(['sips', '-s', 'format', conv_format, filepath, '--out', conv_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if os.path.exists(conv_path):
            target_path = conv_path
            mime = conv_mime
    elif ext == '.caf':
        m4a_path = f"/tmp/imessage_conv_{parent_name}_{file_base}.m4a"
        afconvert_bin = '/usr/bin/afconvert'
        if os.path.exists(afconvert_bin):
            subprocess.run([afconvert_bin, '-f', 'm4af', '-d', 'aac', filepath, m4a_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if os.path.exists(m4a_path):
                target_path = m4a_path
                mime = "audio/mp4"
            else:
                mime = "audio/x-caf"
        else:
            mime = "audio/x-caf"
    elif ext in ['.m4a', '.mp4']:
        mime = "audio/mp4"
    elif ext == '.wav':
        mime = "audio/wav"
    elif ext == '.mp3':
        mime = "audio/mpeg"
    elif ext == '.aac':
        mime = "audio/aac"
    elif ext in ['.jpg', '.jpeg']:
        mime = "image/jpeg"
    elif ext == '.png':
        mime = "image/png"
    elif ext == '.gif':
        mime = "image/gif"
    elif ext == '.pdf':
        mime = "application/pdf"
    elif ext == '.txt':
        mime = "text/plain"

    is_audio = ext in AUDIO_EXTENSIONS or mime.startswith('audio/')
    dur_sec = get_audio_duration(filepath) if is_audio else None
    dur_fmt = format_duration(dur_sec) if dur_sec is not None else None

    transcription = None
    language = None
    transcription_source = None
    transcription_status = "not_audio" if not is_audio else "ok"
    segments = None

    if is_audio:
        apple_transcription = None
        apple_language = None
        attachment_guid = None
        try:
            conn = sqlite3.connect(f"file:{get_db_path()}?mode=ro", uri=True)
            c = conn.cursor()
            basename = os.path.basename(filepath)
            normpath = filepath.replace(os.path.expanduser('~'), '~')
            c.execute("""
                SELECT guid, user_info, attribution_info
                FROM attachment
                WHERE filename = ? OR filename = ? OR filename LIKE ?
                ORDER BY (CASE WHEN filename = ? OR filename = ? THEN 0 ELSE 1 END), ROWID DESC LIMIT 1
            """, (filepath, normpath, f"%{basename}", filepath, normpath))
            row = c.fetchone()
            if row:
                attachment_guid = row[0]
                if row[1]:
                    p = extract_attachment_user_info(row[1])
                    apple_transcription = p.get('audio-transcription') or None
                    apple_language = p.get('transcription-language') or p.get('language') or None
            conn.close()
        except Exception:
            pass

        if apple_transcription:
            transcription = apple_transcription
            language = apple_language
            transcription_source = "apple"
            transcription_status = "ok"
        else:
            st = None
            try:
                st = os.stat(filepath)
            except Exception:
                pass
            f_size = st.st_size if st else None
            f_mtime = st.st_mtime if st else None
            cached = get_cached_transcript(guid=attachment_guid, filepath=filepath, file_size=f_size, file_mtime=f_mtime)
            if cached and cached.get("transcription"):
                transcription = cached["transcription"]
                language = cached.get("language")
                transcription_source = cached.get("engine")
                transcription_status = "ok"
                segments = cached.get("segments")
            elif getattr(args, "transcribe", True):
                txt, lang, eng, segs, status = transcribe_audio_with_lock(
                    filepath, guid=attachment_guid, msg_id=message_id,
                    with_segments=getattr(args, "with_segments", False)
                )
                transcription = txt
                language = lang
                transcription_source = eng
                transcription_status = status
                segments = segs
            else:
                transcription = None
                language = None
                transcription_source = None
                transcription_status = "ok"

    with open(target_path, 'rb') as f:
        data = f.read()

    payload = {
        'path': filepath,
        'converted_path': target_path if target_path != filepath else None,
        'mime_type': mime,
        'size_bytes': len(data),
        'base64': base64.b64encode(data).decode('utf-8'),
        'is_audio': bool(is_audio),
        'duration_seconds': dur_sec,
        'duration_formatted': dur_fmt,
        'transcription': transcription,
        'language': language,
        'transcription_source': transcription_source,
        'transcription_status': transcription_status,
        'is_sticker': bool(is_sticker),
        'sticker_pack': sticker_pack,
        'sticker_description': sticker_description
    }
    if getattr(args, "with_segments", False):
        payload['segments'] = segments or []
    
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"File: {filepath}")
        if payload['converted_path']:
            print(f"Converted: {payload['converted_path']}")
        print(f"MIME: {mime} ({len(data)} bytes)")
        if dur_fmt:
            print(f"Duration: {dur_fmt} ({dur_sec}s)")
        if transcription:
            print(f"Transcription: {transcription}")
        print(f"Base64 string length: {len(payload['base64'])} characters")

IMSG_UNCERTAIN_MARKERS = ('may_have_completed', 'still_in_flight')
ATTACHMENT_STAGING_DIR = os.path.expanduser("~/Library/Messages/Attachments/imessage-mcp")


def _resolve_chat(recipient):
    """Resolve recipient to (chat_rowid, chat_identifier, chat_guid) via chat.db; falls back to (None, recipient, None)."""
    try:
        conn = sqlite3.connect(f"file:{get_db_path()}?mode=ro", uri=True)
        c = conn.cursor()
        cols = {row[1] for row in c.execute("PRAGMA table_info(chat)").fetchall()}
        has_guid = "guid" in cols
        select_clause = "ROWID, chat_identifier, guid" if has_guid else "ROWID, chat_identifier, NULL"
        if recipient.isdigit():
            c.execute(f"SELECT {select_clause} FROM chat WHERE ROWID = ?", (int(recipient),))
        else:
            c.execute(f"SELECT {select_clause} FROM chat WHERE display_name LIKE ? OR chat_identifier = ?", (f"%{recipient}%", recipient))
        row = c.fetchone()
        conn.close()
        if row and row[1]:
            return row[0], row[1], (row[2] if len(row) > 2 else None)
    except Exception:
        pass
    return None, recipient, None


def _send_via_imsg_rich(chat_guid, recipient, message, attachment_path, effect):
    """Attempt sending with expressive effect via imsg send-rich. Returns (status, detail)."""
    imsg_bin = os.environ.get('IMSG_BIN') or shutil.which('imsg') or '/opt/homebrew/bin/imsg'
    if not os.path.exists(imsg_bin):
        return 'unavailable', 'imsg CLI not installed'

    effect_arg = effect
    if effect in REVERSE_EFFECT_NAMES:
        effect_arg = REVERSE_EFFECT_NAMES[effect][0]
    if effect_arg == "invisible_ink":
        effect_arg = "invisibleink"

    target_chat = chat_guid or (f"iMessage;-;{recipient}" if not recipient.startswith("iMessage;") else recipient)

    cmd = [imsg_bin, 'send-rich', '--chat', target_chat, '--effect', effect_arg]
    if message:
        cmd += ['--text', message]
    if attachment_path:
        cmd += ['--file', attachment_path]

    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        return 'uncertain', 'imsg send-rich timed out after 180s; outcome unknown, not retrying'

    detail = (res.stderr or res.stdout or '').strip()
    if res.returncode == 0:
        return 'sent', detail
    return 'unavailable', detail or f'imsg send-rich exited with code {res.returncode}'


def _send_via_imsg(chat_rowid, recipient, message, attachment_path):
    """Send through the imsg CLI. Returns (status, detail) where status is 'sent', 'uncertain', or 'unavailable'."""
    imsg_bin = os.environ.get('IMSG_BIN') or shutil.which('imsg') or '/opt/homebrew/bin/imsg'
    if not os.path.exists(imsg_bin):
        return 'unavailable', 'imsg CLI not installed'

    cmd = [imsg_bin, 'send']
    if chat_rowid is not None:
        cmd += ['--chat-id', str(chat_rowid)]
    else:
        cmd += ['--to', recipient]
    if message:
        cmd += ['--text', message]
    if attachment_path:
        cmd += ['--file', attachment_path]

    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        return 'uncertain', 'imsg send timed out after 180s; outcome unknown, not retrying'

    detail = (res.stderr or res.stdout or '').strip()
    if res.returncode == 0:
        return 'sent', detail
    # imsg reports delivery disposition on failed mutations; anything that may
    # have reached Messages must not be retried on another transport.
    if any(marker in detail for marker in IMSG_UNCERTAIN_MARKERS):
        return 'uncertain', detail
    return 'unavailable', detail or f'imsg exited with code {res.returncode}'


def _stage_attachment(attachment_path):
    """Copy the file into Messages' own attachments dir; its sandbox blocks reads from /tmp, Desktop, etc."""
    os.makedirs(ATTACHMENT_STAGING_DIR, exist_ok=True)
    staged = os.path.join(ATTACHMENT_STAGING_DIR, f"{int(time.time())}_{os.path.basename(attachment_path)}")
    shutil.copy2(attachment_path, staged)
    return staged


def _send_via_applescript(target_ident, recipient, message, attachment_path):
    """Fallback: native AppleScript send. Attachment and text arrive as separate bubbles."""
    script = """on run argv
    set chatIdent to item 1 of argv
    set rawRecipient to item 2 of argv
    set messageText to item 3 of argv
    set filePath to item 4 of argv
    tell application "Messages"
        try
            set targetChat to first chat whose id contains chatIdent or guid contains chatIdent
            if filePath is not "" then send POSIX file filePath to targetChat
            if messageText is not "" then send messageText to targetChat
            return
        on error
        end try
        try
            if filePath is not "" then send POSIX file filePath to buddy chatIdent
            if messageText is not "" then send messageText to buddy chatIdent
            return
        on error
        end try
        if filePath is not "" then send POSIX file filePath to buddy rawRecipient
        if messageText is not "" then send messageText to buddy rawRecipient
    end tell
end run"""
    staged_path = _stage_attachment(attachment_path) if attachment_path else ''
    res = subprocess.run(
        ['osascript', '-e', script, target_ident, recipient, message or '', staged_path],
        capture_output=True, text=True
    )
    if res.returncode != 0:
        print(f"ERROR: AppleScript send failed: {res.stderr or res.stdout}", file=sys.stderr)
        sys.exit(1)


def _resolve_cli_attachment(attachment):
    if not attachment:
        return None
    raw = attachment.strip()
    if raw.startswith(('http://', 'https://')):
        import urllib.request, urllib.parse, tempfile
        temp_dir = os.path.join(tempfile.gettempdir(), 'imessage-attachments')
        os.makedirs(temp_dir, exist_ok=True)
        url_path = urllib.parse.urlparse(raw).path
        ext = os.path.splitext(url_path)[1] or '.bin'
        temp_path = os.path.join(temp_dir, f"cli_url_{int(time.time())}_{os.urandom(4).hex()}{ext}")
        try:
            req = urllib.request.Request(raw, headers={'User-Agent': 'imessage-mcp-server'})
            with urllib.request.urlopen(req, timeout=30) as resp, open(temp_path, 'wb') as out_f:
                out_f.write(resp.read())
            return temp_path
        except Exception as e:
            print(f"ERROR: Failed to download attachment from URL '{raw}': {e}", file=sys.stderr)
            sys.exit(1)
    if raw.startswith('data:'):
        import tempfile, re
        m = re.match(r'^data:([^;,]+)?(?:;charset=[^;,]+)?(?:;base64)?,(.*)$', raw, re.DOTALL)
        if m:
            try:
                raw_data = base64.b64decode(m.group(2))
                mime = (m.group(1) or '').lower()
                ext = '.jpg' if 'jpeg' in mime or 'jpg' in mime else '.png' if 'png' in mime else '.pdf' if 'pdf' in mime else '.bin'
                temp_dir = os.path.join(tempfile.gettempdir(), 'imessage-attachments')
                os.makedirs(temp_dir, exist_ok=True)
                temp_path = os.path.join(temp_dir, f"cli_b64_{int(time.time())}_{os.urandom(4).hex()}{ext}")
                with open(temp_path, 'wb') as f:
                    f.write(raw_data)
                return temp_path
            except Exception as e:
                print(f"ERROR: Failed to decode base64 data URI attachment: {e}", file=sys.stderr)
                sys.exit(1)
    attachment_path = os.path.abspath(os.path.expanduser(raw))
    if not os.path.exists(attachment_path):
        print(f"ERROR: Attachment file not found at '{attachment_path}'", file=sys.stderr)
        sys.exit(1)
    return attachment_path


def send_message(args):
    recipient = args.recipient
    message = args.message or ''
    attachment = args.attachment
    effect = getattr(args, "effect", None)

    attachment_path = _resolve_cli_attachment(attachment)

    if not message and not attachment_path:
        print("ERROR: Nothing to send: provide --message and/or --attachment", file=sys.stderr)
        sys.exit(1)

    chat_rowid, target_ident, chat_guid = _resolve_chat(recipient)

    if effect:
        status, detail = _send_via_imsg_rich(chat_guid, target_ident or recipient, message, attachment_path, effect)
        if status == 'sent':
            print(f"Message sent to '{recipient}' ({target_ident}) with effect '{effect}' via imsg send-rich successfully!")
            return
        if status == 'uncertain':
            print(f"ERROR: imsg send-rich outcome uncertain, not retrying to avoid double-send: {detail}", file=sys.stderr)
            sys.exit(1)
        print(f"imsg send-rich with effect '{effect}' unavailable ({detail}), falling back to standard send without effect", file=sys.stderr)

    status, detail = _send_via_imsg(chat_rowid, recipient, message, attachment_path)
    if status == 'sent':
        print(f"Message sent to '{recipient}' ({target_ident}) via imsg successfully!")
        return
    if status == 'uncertain':
        print(f"ERROR: imsg send outcome uncertain, not retrying to avoid double-send: {detail}", file=sys.stderr)
        sys.exit(1)

    print(f"imsg unavailable ({detail}), falling back to AppleScript", file=sys.stderr)
    _send_via_applescript(target_ident, recipient, message, attachment_path)
    print(f"Message sent to '{recipient}' ({target_ident}) via AppleScript successfully!")


def get_schedule_file():
    env_path = os.environ.get("IMESSAGE_SCHEDULE_PATH")
    if env_path:
        return os.path.abspath(os.path.expanduser(env_path))
    return os.path.expanduser("~/.imessage-mcp/scheduled.json")


def read_scheduled_file():
    p = get_schedule_file()
    if not os.path.exists(p):
        return []
    try:
        with open(p, "r", encoding="utf-8") as f:
            data = json.load(f)
            return data if isinstance(data, list) else []
    except Exception:
        return []


def write_scheduled_file(messages):
    p = get_schedule_file()
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w", encoding="utf-8") as f:
        json.dump(messages, f, indent=2)


def schedule_cli(args):
    action = getattr(args, "action", None) or "status"
    messages = read_scheduled_file()

    if action == "list":
        filter_status = getattr(args, "status", None) or "all"
        filtered = [m for m in messages if filter_status == "all" or m.get("status") == filter_status]
        if getattr(args, "json", False):
            print(json.dumps(filtered, indent=2))
        else:
            print(f"SCHEDULED MESSAGES ({len(filtered)} items, filter: {filter_status}):")
            print(f"{'ID':<24} | {'Status':<10} | {'Scheduled For':<24} | {'Recipient':<25}")
            print("-" * 90)
            for m in filtered:
                print(f"{m.get('id', ''):<24} | {m.get('status', ''):<10} | {m.get('scheduled_for', m.get('target_time', '')):<24} | {m.get('recipient', ''):<25}")

    elif action == "status":
        pending_list = [m for m in messages if m.get("status") == "pending"]
        sent_list = [m for m in messages if m.get("status") == "sent"]
        canceled_list = [m for m in messages if m.get("status") == "canceled"]
        failed_list = [m for m in messages if m.get("status") == "failed"]
        sorted_pending = sorted(pending_list, key=lambda x: x.get("target_time", ""))
        next_item = sorted_pending[0] if sorted_pending else None

        res = {
            "total": len(messages),
            "pending": len(pending_list),
            "sent": len(sent_list),
            "canceled": len(canceled_list),
            "failed": len(failed_list),
            "next_scheduled": {
                "id": next_item["id"],
                "recipient": next_item["recipient"],
                "scheduled_for": next_item.get("scheduled_for", next_item.get("target_time")),
                "effect": next_item.get("effect"),
            } if next_item else None
        }
        if getattr(args, "json", False):
            print(json.dumps(res, indent=2))
        else:
            print("Scheduled Messages Status:")
            print(f"  Total:    {res['total']}")
            print(f"  Pending:  {res['pending']}")
            print(f"  Sent:     {res['sent']}")
            print(f"  Canceled: {res['canceled']}")
            print(f"  Failed:   {res['failed']}")
            if next_item:
                print(f"  Next:     {next_item['id']} for {next_item['recipient']} at {next_item.get('scheduled_for')}")

    elif action == "cancel":
        schedule_id = getattr(args, "id", None)
        found = False
        for m in messages:
            if m.get("id") == schedule_id:
                m["status"] = "canceled"
                found = True
                break
        if found:
            write_scheduled_file(messages)
            res = {"success": True, "canceled": True, "id": schedule_id}
            if getattr(args, "json", False):
                print(json.dumps(res, indent=2))
            else:
                print(f"Scheduled message {schedule_id} canceled successfully.")
        else:
            res = {"success": False, "canceled": False, "error": f"Scheduled message {schedule_id} not found", "id": schedule_id}
            if getattr(args, "json", False):
                print(json.dumps(res, indent=2))
            else:
                print(f"ERROR: Scheduled message {schedule_id} not found", file=sys.stderr)
            sys.exit(1)

    elif action in ("run-pending", "run"):
        now_dt = datetime.datetime.now(datetime.timezone.utc)
        now_iso = now_dt.isoformat()
        dispatched = []
        for m in messages:
            if m.get("status") == "pending":
                target_str = m.get("target_time") or m.get("scheduled_for")
                try:
                    target_dt = datetime.datetime.fromisoformat(target_str.replace("Z", "+00:00"))
                    if target_dt <= now_dt:
                        try:
                            class SendArgs:
                                pass
                            s_args = SendArgs()
                            s_args.recipient = m.get("recipient")
                            s_args.message = m.get("message")
                            s_args.attachment = m.get("attachment")
                            s_args.effect = m.get("effect")
                            send_message(s_args)
                            m["status"] = "sent"
                            m["sent_at"] = now_iso
                            m.pop("error", None)
                            dispatched.append(m)
                        except Exception as e:
                            m["status"] = "failed"
                            m["error"] = str(e)
                            dispatched.append(m)
                except Exception as ex:
                    m["status"] = "failed"
                    m["error"] = f"Invalid target_time: {ex}"
                    dispatched.append(m)

        if dispatched:
            write_scheduled_file(messages)

        if getattr(args, "json", False):
            print(json.dumps(dispatched, indent=2))
        else:
            print(f"Processed {len(dispatched)} due scheduled messages.")
            for d in dispatched:
                print(f"  {d.get('id')}: {d.get('status')} to {d.get('recipient')}")


def get_recent_messages(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    target = args.chat
    limit = getattr(args, "limit", 5) or 5
    chat_ids = resolve_chat_ids(cursor, target)
    if not chat_ids:
        finish_no_chat(conn, args, target)
        return

    available = message_column_names(cursor)
    select_sql = message_select_list(available)
    placeholders = chat_placeholders(chat_ids)
    since = getattr(args, "since_msg_id", None)
    mode = presentation_options(args)
    has_more = False
    if since is not None:
        # One range read: chat_message_join.chat_id plus message.ROWID > cursor.
        # Limit counts raw rows (including tapbacks) so the cursor cannot skip them.
        where = f"c.ROWID IN ({placeholders}) AND m.ROWID > ? ORDER BY m.ROWID ASC LIMIT ?"
        params = [*chat_ids, since, int(limit) + 1]
        rows = fetch_message_dicts(cursor, select_sql, where, params)
        has_more = len(rows) > limit
        if has_more:
            rows = rows[:limit]
    else:
        predicate = reaction_predicate(available)
        # Newest N visible messages. has_more stays false here: this is not a forward page.
        # since_msg_id is what pages forward, and only that path counts raw rows against limit.
        where = f"c.ROWID IN ({placeholders}) AND NOT ({predicate}) ORDER BY m.ROWID DESC LIMIT ?"
        params = [*chat_ids, int(limit)]
        rows = fetch_message_dicts(cursor, select_sql, where, params)
        has_more = False
        rows.reverse()
        if rows:
            rows = dedupe_rows(rows + fetch_reactions_for_messages(
                cursor, select_sql, chat_ids, rows, available
            ))
    populate_cached_decoded_text(rows)
    cmap = get_contacts_map()
    items = present_rows(cursor, rows, cmap, True, mode, transcribe=getattr(args, "transcribe", False))
    filtered, next_since = annotate_batch(items, rows, since)
    if getattr(args, "include_calls", False):
        min_date_s = None
        if since is not None:
            cursor.execute("SELECT date FROM message WHERE ROWID = ?", (since,))
            r = cursor.fetchone()
            if r and r[0]:
                min_date_s = int(r[0]) / 1_000_000_000
        elif rows:
            min_ns = min(r.get("date_ns") or r.get("date") or 0 for r in rows if (r.get("date_ns") or r.get("date")))
            if min_ns:
                min_date_s = min_ns / 1_000_000_000
        calls = get_calls_for_chat_ids(cursor, chat_ids, since_date_s=min_date_s, cmap=cmap)
        items = merge_calls_into_timeline(items, calls)
    header = f"LAST {len(items)} RECENT MESSAGES FOR '{target}':"
    lines = [format_item_line(item) for item in items]
    emit_read_result(args, items, filtered, next_since, has_more, header, lines)
    conn.close()
def get_edit_history(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    msg_id = args.message_id
    available = message_column_names(cursor)
    select_sql = message_select_list(available)
    rows = fetch_message_dicts(cursor, select_sql, "m.ROWID = ? LIMIT 1", (msg_id,), MESSAGE_FROM_LOOSE)
    if not rows:
        if getattr(args, 'json', False):
            print(json.dumps({'error': f'Message #{msg_id} not found'}))
        else:
            print(f"ERROR: Message #{msg_id} not found", file=sys.stderr)
        conn.close()
        sys.exit(1)

    row = rows[0]
    cmap = get_contacts_map()
    attachments_map = fetch_attachments_for_messages(cursor, [row["msg_id"]])
    item = base_message_fields(row, cmap, True, attachments_map)
    history = item["edit_history"]
    if not history:
        history = [{
            'revision': 0,
            'label': 'original',
            'timestamp': item['timestamp'],
            'timestamp_iso': item['timestamp_iso'],
            'text': item['text']
        }]

    result = {
        'msg_id': item['msg_id'],
        'guid': item['guid'],
        'chat_id': item['chat_id'],
        'chat': item['chat'] or 'Unknown',
        'sender': item['sender'],
        'handle': item['handle'],
        'participant': item['participant'],
        'is_from_me': item['is_from_me'],
        'timestamp': item['timestamp'],
        'timestamp_iso': item['timestamp_iso'],
        'is_audio_message': item['is_audio_message'],
        'transcription': item['transcription'],
        'is_edited': item['is_edited'],
        'has_edits': item['has_edits'],
        'edit_count': item['edit_count'],
        'last_edited': item['last_edited'],
        'last_edited_iso': item['last_edited_iso'],
        'current_text': item['text'],
        'edit_history': history,
        'attachments': item['attachments'],
        'link_preview': item['link_preview'],
    }

    if getattr(args, 'json', False):
        print(json.dumps(result, indent=2))
    else:
        if item['is_edited']:
            print(f"EDIT HISTORY FOR MESSAGE #{item['msg_id']} ({item['edit_count']} edits, last edited: {item['last_edited']}):")
            print("=" * 85)
            print(f"Chat: {result['chat']} (ID: {item['chat_id']}) | Sender: {item['sender']} | Current: {item['text']}")
            print("-" * 85)
            for h in history:
                label_display = "[Original]" if h['revision'] == 0 else f"[Edit {h['revision']}]"
                print(f"{label_display:<12} {h['timestamp']}: {h['text']}")
        else:
            print(f"Message #{item['msg_id']} has no edit history (original message only).")
            print("=" * 85)
            print(f"Chat: {result['chat']} | Sender: {item['sender']} | Date: {item['timestamp']}")
            print(f"Text: {item['text']}")
    conn.close()

def edit_message(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    msg_id = args.message_id
    new_text = args.text
    if not new_text or not new_text.strip():
        if getattr(args, 'json', False):
            print(json.dumps({'error': 'Replacement text cannot be empty', 'success': False}))
        else:
            print("ERROR: Replacement text cannot be empty", file=sys.stderr)
        conn.close()
        sys.exit(1)

    query = """
    SELECT 
        m.ROWID,
        m.guid,
        m.date,
        m.is_from_me,
        c.guid,
        c.chat_identifier,
        COALESCE(c.display_name, ''),
        m.text,
        m.message_summary_info
    FROM message m
    JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
    JOIN chat c ON cmj.chat_id = c.ROWID
    WHERE m.ROWID = ?
    LIMIT 1
    """
    cursor.execute(query, (msg_id,))
    row = cursor.fetchone()
    if not row:
        err_msg = f"Message #{msg_id} not found"
        if getattr(args, 'json', False):
            print(json.dumps({'error': err_msg, 'success': False}))
        else:
            print(f"ERROR: {err_msg}", file=sys.stderr)
        conn.close()
        sys.exit(1)

    row_id, message_guid, date_ns, is_from_me, chat_guid, chat_ident, display_name, current_text, summary_blob = row

    if not is_from_me:
        err_msg = f"Cannot edit message #{msg_id}: only outgoing messages sent by you can be edited (this is an incoming message)."
        if getattr(args, 'json', False):
            print(json.dumps({'error': err_msg, 'success': False}))
        else:
            print(f"ERROR: {err_msg}", file=sys.stderr)
        conn.close()
        sys.exit(1)

    # Apple 15-minute edit window check
    apple_epoch = datetime.datetime(2001, 1, 1, tzinfo=datetime.timezone.utc)
    sec = (date_ns or 0) / 1_000_000_000
    msg_dt = apple_epoch + datetime.timedelta(seconds=sec)
    now_dt = datetime.datetime.now(datetime.timezone.utc)
    elapsed_seconds = (now_dt - msg_dt).total_seconds()

    if elapsed_seconds > 900:
        elapsed_mins = int(elapsed_seconds / 60)
        err_msg = f"Cannot edit message #{msg_id}: iMessage only permits editing messages within 15 minutes of sending. This message was sent {elapsed_mins} minutes ago ({msg_dt.astimezone().strftime('%Y-%m-%d %I:%M %p')})."
        if getattr(args, 'json', False):
            print(json.dumps({'error': err_msg, 'success': False}))
        else:
            print(f"ERROR: {err_msg}", file=sys.stderr)
        conn.close()
        sys.exit(1)

    # Edit count check (Apple limits to 5 edits)
    is_ed, count, last_ts, hist = parse_edit_history(summary_blob, 0, date_ns)
    if count >= 5:
        err_msg = f"Cannot edit message #{msg_id}: maximum edit limit of 5 revisions reached."
        if getattr(args, 'json', False):
            print(json.dumps({'error': err_msg, 'success': False}))
        else:
            print(f"ERROR: {err_msg}", file=sys.stderr)
        conn.close()
        sys.exit(1)

    conn.close()

    # Dispatch via imsg
    imsg_bin = os.environ.get('IMSG_BIN') or shutil.which('imsg') or '/opt/homebrew/bin/imsg'
    if not os.path.exists(imsg_bin):
        err_msg = "imsg CLI tool not found at /opt/homebrew/bin/imsg. Install imsg or build the dylib bridge to edit messages."
        if getattr(args, 'json', False):
            print(json.dumps({'error': err_msg, 'success': False}))
        else:
            print(f"ERROR: {err_msg}", file=sys.stderr)
        sys.exit(1)

    target_chat = chat_guid or chat_ident
    cmd = [
        imsg_bin, 'edit',
        '--chat', target_chat,
        '--message', message_guid,
        '--new-text', new_text,
        '--json'
    ]

    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        err_msg = "imsg edit timed out after 30 seconds."
        if getattr(args, 'json', False):
            print(json.dumps({'error': err_msg, 'success': False}))
        else:
            print(f"ERROR: {err_msg}", file=sys.stderr)
        sys.exit(1)

    stdout_str = (res.stdout or '').strip()
    stderr_str = (res.stderr or '').strip()

    if res.returncode == 0:
        if getattr(args, 'json', False):
            try:
                parsed = json.loads(stdout_str)
                print(json.dumps(parsed, indent=2))
            except Exception:
                print(json.dumps({
                    'success': True,
                    'msg_id': msg_id,
                    'message_guid': message_guid,
                    'new_text': new_text,
                    'output': stdout_str
                }, indent=2))
        else:
            print(f"Message #{msg_id} edited successfully to: '{new_text}'")
        return

    # Handle error from imsg
    err_detail = stderr_str or stdout_str or f"imsg exited with code {res.returncode}"
    is_sip_blocked = 'SIP' in err_detail or 'bridge' in err_detail or 'not_started' in err_detail

    if getattr(args, 'json', False):
        if is_sip_blocked:
            print(json.dumps({
                'success': False,
                'bridge_available': False,
                'msg_id': msg_id,
                'message_guid': message_guid,
                'chat': chat_ident,
                'display_name': display_name or "",
                'original_text': current_text or "",
                'suggested_text': new_text,
                'error': "Messages edit bridge is unavailable because System Integrity Protection (SIP) is enabled on the host Mac. Apple does not support message editing via AppleScript.",
                'fallback_recommendation': "Instruct the user to edit the message manually on their device using suggested_text, or call imessage_send_message to send a follow-up correction."
            }, indent=2))
            return
        else:
            print(json.dumps({'error': err_detail, 'success': False}, indent=2))
            sys.exit(1)
    else:
        if is_sip_blocked:
            print("NOTICE: Messages edit bridge is unavailable because System Integrity Protection (SIP) is enabled on this Mac. Apple does not support message editing via AppleScript.", file=sys.stderr)
            print(f"Suggested text for manual edit: '{new_text}'", file=sys.stderr)
        else:
            print(f"ERROR: Failed to edit message #{msg_id}: {err_detail}", file=sys.stderr)
        sys.exit(1)

def search_group_chats(args):
    raw_participants = args.participants
    if isinstance(raw_participants, str):
        query_participants = [p.strip() for p in raw_participants.split(',') if p.strip()]
    elif isinstance(raw_participants, list):
        query_participants = raw_participants
    else:
        query_participants = []

    conn = get_db_connection()
    cursor = conn.cursor()
    cmap = get_contacts_map()

    cursor.execute("SELECT ROWID, COALESCE(display_name, ''), chat_identifier FROM chat")
    chats = cursor.fetchall()

    matching_chats = []
    for rowid, display_name, identifier in chats:
        cursor.execute("""
            SELECT h.id
            FROM chat_handle_join chj
            JOIN handle h ON chj.handle_id = h.ROWID
            WHERE chj.chat_id = ?
        """, (rowid,))
        handles = [r[0] for r in cursor.fetchall()]

        participants = []
        participant_search_space = []
        for h in handles:
            norm = normalize_handle(h)
            pname = cmap.get(norm, h)
            participants.append({'name': pname, 'handle': h})
            participant_search_space.append(f"{pname} {h}".lower())

        # Check if ALL requested queries match at least one participant in this chat
        all_matched = True
        for q in query_participants:
            q_lower = q.lower()
            found = any(q_lower in search_str for search_str in participant_search_space)
            if not found:
                all_matched = False
                break

        if all_matched and (handles or display_name):
            name = display_name if display_name else ", ".join([p['name'] for p in participants])
            matching_chats.append({
                'rowid': rowid,
                'display_name': display_name,
                'name': name,
                'identifier': identifier,
                'participants': participants
            })

    if getattr(args, 'json', False):
        print(json.dumps(matching_chats, indent=2))
    else:
        print(f"SEARCH GROUP CHATS MATCHING {query_participants} ({len(matching_chats)} chats found):")
        print("=" * 85)
        for c in matching_chats:
            print(f"[{c['rowid']}] {c['name']} ({c['identifier']})")
    conn.close()

def classify_change_row(assoc_type, is_from_me, text, attributed_body, item_type,
                        group_action_type, has_attachments):
    """Classify a new message row for the watcher.

    Returns "reaction", "message_out", "message_in", or None when the row is a
    system/group event or an empty row (no text, no attributedBody text, and no
    attachments) that must not be reported as a message.
    """
    try:
        if assoc_type and int(assoc_type) > 0:
            return "reaction"
    except (TypeError, ValueError):
        pass
    try:
        if item_type is not None and int(item_type) != 0:
            return None
    except (TypeError, ValueError):
        return None
    try:
        if group_action_type is not None and int(group_action_type) != 0:
            return None
    except (TypeError, ValueError):
        return None

    def has_visible_text(val):
        return bool(val) and bool(str(val).strip().strip("\x00\x01\ufffc").strip())

    has_text = has_visible_text(text) or has_visible_text(parse_attributed_body(attributed_body))
    if not has_text and not has_attachments:
        return None
    return "message_out" if is_from_me else "message_in"


def get_changes(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    available = message_column_names(cursor)

    cursor.execute("SELECT MAX(ROWID) FROM message")
    row = cursor.fetchone()
    max_msg_id = int(row[0]) if row and row[0] is not None else 0

    chat_handles_map = {}
    try:
        cursor.execute("""
            SELECT chj.chat_id, h.id
            FROM chat_handle_join chj
            JOIN handle h ON chj.handle_id = h.ROWID
        """)
        for cid, hid in cursor.fetchall():
            if hid:
                chat_handles_map.setdefault(cid, []).append(hid)
    except Exception:
        pass

    def build_identifiers(cid, c_ident, disp_name):
        res = []
        if cid is not None:
            res.append(str(cid))
        if c_ident:
            res.append(str(c_ident))
            norm = normalize_handle(c_ident)
            if norm:
                res.append(norm)
        if disp_name:
            res.append(str(disp_name))
        for h in chat_handles_map.get(cid, []):
            if h:
                res.append(str(h))
                norm_h = normalize_handle(h)
                if norm_h:
                    res.append(norm_h)
        return list(dict.fromkeys(filter(None, res)))

    since_id = args.since_id
    new_messages = []

    def opt_col(column, alias):
        return f"m.{column} AS {alias}" if column in available else f"NULL AS {alias}"

    if since_id is not None and since_id > 0:
        cursor.execute(f"""
            SELECT m.ROWID AS msg_id, m.guid AS guid, cmj.chat_id AS chat_id,
                   c.chat_identifier AS chat_identifier, c.display_name AS display_name,
                   m.is_from_me AS is_from_me,
                   {opt_col("associated_message_type", "associated_message_type")},
                   {opt_col("associated_message_guid", "associated_message_guid")},
                   m.date AS date_ns,
                   m.text AS text,
                   {opt_col("attributedBody", "attributed_body")},
                   {opt_col("item_type", "item_type")},
                   {opt_col("group_action_type", "group_action_type")},
                   {opt_col("cache_has_attachments", "cache_has_attachments")},
                   {opt_col("was_delivered_quietly", "was_delivered_quietly")},
                   {opt_col("expressive_send_style_id", "expressive_send_style_id")}
            {MESSAGE_FROM_LOOSE}
            WHERE m.ROWID > ?
            ORDER BY m.ROWID ASC
        """, (since_id,))
        rows = cursor.fetchall()

        with_attachments = set()
        with_audio_attachments = set()
        row_ids = [r[0] for r in rows]
        if row_ids:
            try:
                placeholders = ",".join(["?"] * len(row_ids))
                cursor.execute(
                    f"SELECT DISTINCT message_id FROM message_attachment_join WHERE message_id IN ({placeholders})",
                    row_ids,
                )
                with_attachments = {int(x[0]) for x in cursor.fetchall()}
                if with_attachments:
                    att_holders = ",".join(["?"] * len(with_attachments))
                    cursor.execute(f"""
                        SELECT DISTINCT maj.message_id
                        FROM message_attachment_join maj
                        JOIN attachment a ON maj.attachment_id = a.ROWID
                        WHERE maj.message_id IN ({att_holders})
                          AND (
                            a.mime_type LIKE 'audio/%'
                            OR a.uti LIKE '%audio%'
                            OR a.uti LIKE '%coreaudio%'
                            OR a.filename LIKE '%.caf'
                            OR a.filename LIKE '%.m4a'
                            OR a.filename LIKE '%.wav'
                            OR a.filename LIKE '%.mp3'
                          )
                    """, list(with_attachments))
                    with_audio_attachments = {int(x[0]) for x in cursor.fetchall()}
            except Exception:
                pass

        for r in rows:
            (m_id, guid, chat_id, chat_ident, display_name, is_from_me, assoc_type, assoc_guid, date_ns,
             text, attr_body, item_type, group_action_type, cache_has_attachments,
             was_deliv_quietly, style_id) = r
            event = classify_change_row(
                assoc_type=assoc_type,
                is_from_me=is_from_me,
                text=text,
                attributed_body=attr_body,
                item_type=item_type,
                group_action_type=group_action_type,
                has_attachments=bool(cache_has_attachments) or int(m_id) in with_attachments,
            )
            if event is None:
                # System, group-event, or empty rows ('<empty message>') never wake a webhook.
                continue

            _human, iso = format_apple_ns(date_ns)
            identifiers = build_identifiers(chat_id, chat_ident, display_name)
            effect_name, effect_type = (None, None)
            if style_id:
                effect_name, effect_type = REVERSE_EFFECT_NAMES.get(style_id, (style_id, "unknown"))

            msg_item = {
                "msg_id": m_id,
                "guid": guid,
                "chat_id": chat_id,
                "chat_identifiers": identifiers,
                "event": event,
                "is_from_me": bool(is_from_me),
                "occurred_at_iso": iso or datetime.datetime.now(datetime.timezone.utc).isoformat(),
                "has_attachments": bool(cache_has_attachments) or int(m_id) in with_attachments,
                "has_audio_attachments": int(m_id) in with_audio_attachments,
            }
            if was_deliv_quietly:
                msg_item["delivered_quietly"] = True
                msg_item["was_delivered_quietly"] = True
                msg_item["notifications_silenced"] = True
                msg_item["silenced_notifications"] = True
            if effect_name:
                msg_item["effect"] = effect_name
                msg_item["effect_type"] = effect_type

            new_messages.append(msg_item)

    receipt_events = []
    current_receipt_state = {}

    has_receipt_cols = any(col in available for col in ("is_delivered", "date_delivered", "is_read", "date_read"))
    if has_receipt_cols:
        deliv_col = "m.is_delivered" if "is_delivered" in available else "0"
        deliv_date_col = "m.date_delivered" if "date_delivered" in available else "0"
        read_col = "m.is_read" if "is_read" in available else "0"
        read_date_col = "m.date_read" if "date_read" in available else "0"

        cursor.execute(f"""
            SELECT m.ROWID AS msg_id, cmj.chat_id AS chat_id,
                   c.chat_identifier AS chat_identifier, c.display_name AS display_name,
                   {deliv_col} AS is_delivered,
                   {deliv_date_col} AS date_delivered_ns,
                   {read_col} AS is_read,
                   {read_date_col} AS date_read_ns,
                   m.date AS date_ns,
                   {opt_col("was_delivered_quietly", "was_delivered_quietly")},
                   {opt_col("did_notify_recipient", "did_notify_recipient")},
                   {opt_col("expressive_send_style_id", "expressive_send_style_id")}
            {MESSAGE_FROM_LOOSE}
            WHERE m.is_from_me = 1
            ORDER BY m.ROWID DESC
            LIMIT ?
        """, (args.lookback,))

        prev_receipt_state = {}
        if args.receipt_state:
            try:
                prev_receipt_state = json.loads(args.receipt_state)
            except Exception:
                pass

        for r in cursor.fetchall():
            (m_id, chat_id, chat_ident, display_name, is_deliv, date_deliv_ns, is_rd, date_rd_ns, date_ns,
             was_deliv_quietly, did_notify, style_id) = r
            curr_delivered = bool(is_deliv or (date_deliv_ns and date_deliv_ns > 0))
            curr_read = bool(is_rd or (date_rd_ns and date_rd_ns > 0))
            current_receipt_state[str(m_id)] = {
                "delivered": curr_delivered,
                "read": curr_read,
            }

            if prev_receipt_state and str(m_id) in prev_receipt_state:
                prev = prev_receipt_state[str(m_id)]
                identifiers = build_identifiers(chat_id, chat_ident, display_name)
                effect_name, effect_type = (None, None)
                if style_id:
                    effect_name, effect_type = REVERSE_EFFECT_NAMES.get(style_id, (style_id, "unknown"))

                if not prev.get("delivered") and curr_delivered:
                    _h, deliv_iso = format_apple_ns(date_deliv_ns) if date_deliv_ns else format_apple_ns(date_ns)
                    rec_event = {
                        "event": "delivered",
                        "chat_id": chat_id,
                        "chat_identifiers": identifiers,
                        "msg_id": m_id,
                        "occurred_at_iso": deliv_iso or datetime.datetime.now(datetime.timezone.utc).isoformat(),
                    }
                    if was_deliv_quietly:
                        rec_event["delivered_quietly"] = True
                        rec_event["was_delivered_quietly"] = True
                        rec_event["notifications_silenced"] = True
                        rec_event["silenced_notifications"] = True
                    if did_notify:
                        rec_event["did_notify_recipient"] = True
                    if effect_name:
                        rec_event["effect"] = effect_name
                        rec_event["effect_type"] = effect_type

                    receipt_events.append(rec_event)

                if not prev.get("read") and curr_read:
                    _h, read_iso = format_apple_ns(date_rd_ns) if date_rd_ns else format_apple_ns(date_ns)
                    rec_event = {
                        "event": "read_receipt",
                        "chat_id": chat_id,
                        "chat_identifiers": identifiers,
                        "msg_id": m_id,
                        "occurred_at_iso": read_iso or datetime.datetime.now(datetime.timezone.utc).isoformat(),
                    }
                    if was_deliv_quietly:
                        rec_event["delivered_quietly"] = True
                        rec_event["was_delivered_quietly"] = True
                        rec_event["notifications_silenced"] = True
                        rec_event["silenced_notifications"] = True
                    if did_notify:
                        rec_event["did_notify_recipient"] = True
                    if effect_name:
                        rec_event["effect"] = effect_name
                        rec_event["effect_type"] = effect_type

                    receipt_events.append(rec_event)

    conn.close()

    result = {
        "max_msg_id": max_msg_id,
        "new_messages": new_messages,
        "receipt_events": receipt_events,
        "receipt_state": current_receipt_state,
    }

    if getattr(args, "json", False):
        print(json.dumps(result, indent=2))
    else:
        print(f"Max Message ID: {max_msg_id}")
        print(f"New Messages: {len(new_messages)}")
        print(f"Receipt Events: {len(receipt_events)}")

def cmd_transcribe_status(args):
    w_bin = find_whisper_bin()
    w_model = find_whisper_model()
    models_dir = get_transcribe_models_dir()
    installed_models = []
    if os.path.exists(models_dir):
        for f in sorted(os.listdir(models_dir)):
            if f.endswith(".bin"):
                fp = os.path.join(models_dir, f)
                installed_models.append({
                    "name": f,
                    "path": fp,
                    "size_bytes": os.path.getsize(fp),
                    "size_formatted": format_size(os.path.getsize(fp)),
                })

    apple_helper = os.path.join(os.path.dirname(__file__), "apple-speech-transcribe.swift")
    apple_available = os.path.exists(apple_helper) and os.path.exists("/usr/bin/swift")

    total_cached = 0
    engine_counts = {}
    lang_counts = {}
    db_path = get_transcripts_db_path()
    try:
        conn = get_transcripts_db_connection(read_only=True)
        if conn:
            c = conn.cursor()
            ensure_transcripts_table(conn)
            c.execute("SELECT COUNT(*) FROM transcripts")
            r = c.fetchone()
            if r: total_cached = r[0]
            c.execute("SELECT engine, COUNT(*) FROM transcripts GROUP BY engine")
            for eng, cnt in c.fetchall():
                engine_counts[eng or "unknown"] = cnt
            c.execute("SELECT language, COUNT(*) FROM transcripts GROUP BY language")
            for lng, cnt in c.fetchall():
                lang_counts[lng or "unknown"] = cnt
            conn.close()
    except Exception:
        pass

    active_engine = os.environ.get("TRANSCRIBE_ENGINE", "whisper").strip().lower()
    status_info = {
        "active_engine": active_engine,
        "whisper_bin": w_bin,
        "whisper_available": bool(w_bin and w_model),
        "active_model_path": w_model,
        "models_dir": models_dir,
        "installed_models": installed_models,
        "apple_speech_available": apple_available,
        "cache_db_path": db_path,
        "total_cached_transcripts": total_cached,
        "transcripts_by_engine": engine_counts,
        "transcripts_by_language": lang_counts,
    }
    if getattr(args, "json", False):
        print(json.dumps(status_info, indent=2))
    else:
        print("iMessage Voice Note Transcription Status:")
        print("------------------------------------------")
        print(f"Active Engine:             {active_engine}")
        print(f"Whisper Binary:            {w_bin or 'Not found'}")
        print(f"Whisper Model:             {w_model or 'Not found'}")
        print(f"Apple Speech Helper:       {'Available' if apple_available else 'Not found'}")
        print(f"Models Directory:          {models_dir} ({len(installed_models)} models installed)")
        for m in installed_models:
            print(f"  - {m['name']} ({m['size_formatted']})")
        print(f"Cache Database:            {db_path}")
        print(f"Total Cached Transcripts:  {total_cached}")
        if engine_counts:
            print(f"By Engine:                 {', '.join(f'{k}: {v}' for k, v in engine_counts.items())}")
        if lang_counts:
            print(f"By Language:               {', '.join(f'{k}: {v}' for k, v in lang_counts.items())}")

def cmd_transcribe_download_model(args):
    model_name = getattr(args, "model", None) or os.environ.get("TRANSCRIBE_MODEL", DEFAULT_TRANSCRIBE_MODEL)
    clean_name = model_name.lower().replace("ggml-", "").replace(".bin", "")
    force = getattr(args, "force", False)
    models_dir = get_transcribe_models_dir()
    ok = download_whisper_model(model_name=clean_name, dest_dir=models_dir, force=force)
    target_path = os.path.join(models_dir, f"ggml-{clean_name}.bin")
    size = os.path.getsize(target_path) if os.path.exists(target_path) else 0
    res = {
        "success": ok,
        "model": clean_name,
        "path": target_path if ok else None,
        "size_bytes": size,
        "size_formatted": format_size(size) if ok else None,
    }
    if getattr(args, "json", False):
        print(json.dumps(res, indent=2))
    else:
        if ok:
            print(f"Model '{clean_name}' ready at: {target_path} ({format_size(size)})")
        else:
            print(f"ERROR: Failed to download model '{clean_name}'", file=sys.stderr)
            sys.exit(1)

def cmd_transcribe_clear_cache(args):
    cleared_count = 0
    db_path = get_transcripts_db_path()
    try:
        conn = get_transcripts_db_connection(read_only=False)
        if conn:
            c = conn.cursor()
            ensure_transcripts_table(conn)
            c.execute("SELECT COUNT(*) FROM transcripts")
            r = c.fetchone()
            if r: cleared_count = r[0]
            c.execute("DELETE FROM transcripts")
            conn.commit()
            conn.close()
    except Exception as e:
        sys.stderr.write(f"[Transcribe] Error clearing cache: {e}\n")

    res = {
        "success": True,
        "cleared": True,
        "deleted_count": cleared_count,
        "cache_db_path": db_path,
    }
    if getattr(args, "json", False):
        print(json.dumps(res, indent=2))
    else:
        print(f"Cleared {cleared_count} cached transcripts from {db_path}.")

def cmd_transcribe_backfill(args):
    conn = get_db_connection()
    cursor = conn.cursor()

    since_str = getattr(args, "since", None)
    min_date_ns = None
    if since_str:
        try:
            ts = float(since_str)
            if ts > 10_000_000_000:
                min_date_ns = int(ts)
            elif ts > 1_000_000_000:
                min_date_ns = int((ts - 978307200) * 1_000_000_000)
            else:
                min_date_ns = int(ts * 1_000_000_000)
        except ValueError:
            try:
                dt = datetime.datetime.fromisoformat(since_str.replace("Z", "+00:00"))
                if dt.tzinfo is None:
                    dt = dt.replace(tzinfo=datetime.timezone.utc)
                apple_epoch = datetime.datetime(2001, 1, 1, tzinfo=datetime.timezone.utc)
                diff_sec = (dt - apple_epoch).total_seconds()
                min_date_ns = int(diff_sec * 1_000_000_000)
            except Exception as ex:
                sys.stderr.write(f"[Transcribe] Invalid --since date '{since_str}': {ex}\n")
                sys.exit(1)

    chat_target = getattr(args, "chat", None)
    chat_ids = None
    if chat_target:
        chat_ids = resolve_chat_ids(cursor, chat_target)
        if not chat_ids:
            finish_no_chat(conn, args, chat_target)
            return

    query = """
        SELECT m.ROWID, m.date, a.ROWID, a.guid, a.filename, a.user_info, a.mime_type, a.uti
        FROM message m
        JOIN message_attachment_join maj ON m.ROWID = maj.message_id
        JOIN attachment a ON maj.attachment_id = a.ROWID
    """
    where_clauses = []
    params = []
    if chat_ids:
        placeholders = chat_placeholders(chat_ids)
        query += f" JOIN chat_message_join cmj ON m.ROWID = cmj.message_id"
        where_clauses.append(f"cmj.chat_id IN ({placeholders})")
        params.extend(chat_ids)
    if min_date_ns is not None:
        where_clauses.append("m.date >= ?")
        params.append(min_date_ns)

    if where_clauses:
        query += " WHERE " + " AND ".join(where_clauses)
    query += " ORDER BY m.date ASC"

    cursor.execute(query, params)
    rows = cursor.fetchall()
    conn.close()

    total_candidates = len(rows)
    processed = 0
    transcribed = 0
    skipped_apple = 0
    skipped_cached = 0
    skipped_not_audio = 0
    missing_files = 0
    failed = 0

    limit = getattr(args, "limit", None)
    results = []

    for m_id, m_date, a_id, a_guid, a_fn, a_uinfo, a_mime, a_uti in rows:
        if limit is not None and transcribed >= limit:
            break

        full_path = None
        if a_fn:
            full_path = os.path.expanduser(a_fn) if a_fn.startswith('~') else a_fn
        ext = os.path.splitext(full_path)[1].lower() if full_path else ''
        is_audio = (
            ext in AUDIO_EXTENSIONS
            or (a_uti and ('coreaudio' in a_uti.lower() or 'audio' in a_uti.lower()))
            or (a_mime and a_mime.startswith('audio/'))
        )
        if not is_audio:
            skipped_not_audio += 1
            continue

        if a_uinfo:
            p = extract_attachment_user_info(a_uinfo)
            if p.get("audio-transcription"):
                skipped_apple += 1
                continue

        cached = get_cached_transcript(guid=a_guid, filepath=full_path)
        if cached and cached.get("transcription"):
            skipped_cached += 1
            continue

        if not full_path or not os.path.exists(full_path):
            missing_files += 1
            continue

        processed += 1
        txt, lang, eng, segs, status = transcribe_audio_with_lock(
            full_path, guid=a_guid, msg_id=m_id
        )
        if status == "ok" and txt:
            transcribed += 1
            results.append({
                "msg_id": m_id,
                "attachment_id": a_id,
                "guid": a_guid,
                "language": lang,
                "engine": eng,
                "status": "ok"
            })
        else:
            failed += 1
            results.append({
                "msg_id": m_id,
                "attachment_id": a_id,
                "guid": a_guid,
                "status": status
            })

    summary = {
        "total_candidates": total_candidates,
        "processed": processed,
        "transcribed": transcribed,
        "skipped_apple": skipped_apple,
        "skipped_cached": skipped_cached,
        "skipped_not_audio": skipped_not_audio,
        "missing_files": missing_files,
        "failed": failed,
    }
    if getattr(args, "json", False):
        summary["items"] = results
        print(json.dumps(summary, indent=2))
    else:
        print("Backfill complete:")
        print(f"  Transcribed:    {transcribed}")
        print(f"  Skipped Apple:  {skipped_apple}")
        print(f"  Skipped Cached: {skipped_cached}")
        print(f"  Missing Files:  {missing_files}")
        print(f"  Failed:         {failed}")

def main():
    parser = argparse.ArgumentParser(description="iMessage CLI tool for macOS")
    subparsers = parser.add_subparsers(dest="command", required=True)
    
    list_parser = subparsers.add_parser("list", help="List active iMessage chats")
    list_parser.add_argument("--limit", type=int, default=30, help="Number of chats to list (default 30)")
    list_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    list_parser.set_defaults(func=list_chats)
    
    read_parser = subparsers.add_parser("read", help="Read recent messages from a chat")
    read_parser.add_argument("chat", help="Numeric chat ROWID (list/chat_id), display name, phone number, or email")
    add_read_presentation_args(read_parser, with_days=True)
    read_parser.set_defaults(func=read_messages)

    recent_parser = subparsers.add_parser("recent", help="Get recent messages preview")
    recent_parser.add_argument("chat", help="Numeric chat ROWID (list/chat_id), display name, phone number, or email")
    add_read_presentation_args(recent_parser, with_limit=True)
    recent_parser.set_defaults(func=get_recent_messages)

    search_parser = subparsers.add_parser("search", help="Search message history")
    search_parser.add_argument("query", help="Search keyword or phrase")
    add_read_presentation_args(search_parser, with_limit=True, default_limit=30)
    search_parser.add_argument("--order", choices=["recent", "relevance"], default="recent", help="Sort order for search results (recent or relevance)")
    search_parser.add_argument("--chat", default=None, help="Filter search to a specific chat ROWID or identifier")
    search_parser.set_defaults(func=search_messages)

    index_parser = subparsers.add_parser("index", help="Manage local sidecar index")
    index_sub = index_parser.add_subparsers(dest="index_action", required=True)

    build_p = index_sub.add_parser("build", help="Build index database from chat.db")
    build_p.add_argument("--batch-size", type=int, default=5000, help="Batch size for indexing (default: 5000)")
    build_p.set_defaults(func=lambda a: build_index(batch_size=a.batch_size, force_rebuild=False))

    rebuild_p = index_sub.add_parser("rebuild", help="Delete and rebuild index database")
    rebuild_p.add_argument("--batch-size", type=int, default=5000, help="Batch size for indexing (default: 5000)")
    rebuild_p.set_defaults(func=lambda a: build_index(batch_size=a.batch_size, force_rebuild=True))

    status_p = index_sub.add_parser("status", help="Show index status, row counts, lag, and file size")
    status_p.add_argument("--json", action="store_true", help="Output status in JSON format")
    status_p.set_defaults(func=cli_index_status)

    sync_p = index_sub.add_parser("sync", help="Incrementally sync new rows and recheck recent edits/deletes")
    sync_p.add_argument("--recheck-days", type=int, default=None, help="Days of history to re-check for edits and deletes")
    sync_p.set_defaults(func=lambda a: sync_index(recheck_days=a.recheck_days))

    search_group_parser = subparsers.add_parser("search-group", help="Search group chats by participant names/handles")
    search_group_parser.add_argument("participants", nargs="+", help="Participant names or phone numbers")
    search_group_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    search_group_parser.set_defaults(func=search_group_chats)

    contacts_parser = subparsers.add_parser("contacts", help="Search macOS contacts")
    contacts_parser.add_argument("query", nargs="?", default="", help="Name, phone number, or email search query")
    contacts_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    contacts_parser.set_defaults(func=search_contacts)

    members_parser = subparsers.add_parser("members", help="Get members of a group chat")
    members_parser.add_argument("chat", help="Chat ID or chat identifier")
    members_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    members_parser.set_defaults(func=get_members)

    attachment_parser = subparsers.add_parser("attachment", help="Get base64/multimodal attachment payload")
    attachment_parser.add_argument("path", nargs="?", default=None, help="POSIX path to attachment file")
    attachment_parser.add_argument("--path", dest="path_flag", default=None, help="POSIX path to attachment file")
    attachment_parser.add_argument("--message-id", type=int, default=None, help="Message ROWID containing attachment")
    attachment_parser.add_argument("--with-segments", action="store_true", default=False, help="Include segment timestamps in transcript output")
    attachment_parser.add_argument("--no-transcribe", dest="transcribe", action="store_false", default=True, help="Disable on-demand transcription if not already cached")
    attachment_parser.add_argument("--transcribe", dest="transcribe", action="store_true", default=True, help="Enable on-demand transcription (default: True)")
    attachment_parser.add_argument("--json", action="store_true", help="Output JSON with base64 data")
    attachment_parser.set_defaults(func=get_attachment_payload)

    download_image_parser = subparsers.add_parser("download-image", help="Download and extract image attachment (converts HEIC to PNG for stickers, JPEG for photos)")
    download_image_parser.add_argument("--path", default=None, help="POSIX path to attachment file")
    download_image_parser.add_argument("--message-id", type=int, default=None, help="Message ROWID containing attachment")
    download_image_parser.add_argument("--output-path", default=None, help="Destination POSIX path to write or copy the image")
    download_image_parser.add_argument("--format", choices=["auto", "jpeg", "jpg", "png"], default="auto", help="Output format for converted images (default: auto; stickers convert to png)")
    download_image_parser.add_argument("--include-base64", action="store_true", default=True, help="Include base64 payload")
    download_image_parser.add_argument("--no-base64", dest="include_base64", action="store_false", help="Omit base64 payload")
    download_image_parser.add_argument("--json", action="store_true", help="Output JSON")
    download_image_parser.set_defaults(func=download_image)

    download_image_alias = subparsers.add_parser("download_image", help="Alias for download-image")
    download_image_alias.add_argument("--path", default=None, help="POSIX path to attachment file")
    download_image_alias.add_argument("--message-id", type=int, default=None, help="Message ROWID containing attachment")
    download_image_alias.add_argument("--output-path", default=None, help="Destination POSIX path to write or copy the image")
    download_image_alias.add_argument("--format", choices=["auto", "jpeg", "jpg", "png"], default="auto", help="Output format for converted images (default: auto; stickers convert to png)")
    download_image_alias.add_argument("--include-base64", action="store_true", default=True, help="Include base64 payload")
    download_image_alias.add_argument("--no-base64", dest="include_base64", action="store_false", help="Omit base64 payload")
    download_image_alias.add_argument("--json", action="store_true", help="Output JSON")
    download_image_alias.set_defaults(func=download_image)

    send_parser = subparsers.add_parser("send", help="Send an iMessage")
    send_parser.add_argument("recipient", help="Recipient identifier")
    send_parser.add_argument("--message", "-m", help="Message text body")
    send_parser.add_argument("--attachment", "-a", help="POSIX path, HTTPS URL, or base64 data URI to attachment file")
    send_parser.add_argument("--effect", help="Apple expressive send effect style (e.g. balloons, confetti, lasers, slam, loud, gentle, invisible_ink)")
    send_parser.set_defaults(func=send_message)

    edits_parser = subparsers.add_parser("edits", help="View edit and rewrite history for a message")
    edits_parser.add_argument("message_id", type=int, help="Message ROWID")
    edits_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    edits_parser.set_defaults(func=get_edit_history)

    edit_parser = subparsers.add_parser("edit", help="Edit a previously sent iMessage")
    edit_parser.add_argument("message_id", type=int, help="Message ROWID to edit")
    edit_parser.add_argument("--text", "-t", required=True, help="New replacement message text")
    edit_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    edit_parser.set_defaults(func=edit_message)

    calls_parser = subparsers.add_parser("calls", help="Get call and FaceTime history")
    calls_parser.add_argument("--handle", "--contact", "--recipient", "--phone", "--email", dest="handle", default=None, help="Filter by phone number, email address, or contact name")
    calls_parser.add_argument("--chat", default=None, help="Numeric chat ROWID (resolve participants to handles)")
    calls_parser.add_argument("--since", default=None, help="Filter calls after this timestamp (Apple epoch seconds, Unix timestamp, or ISO 8601)")
    calls_parser.add_argument("--until", default=None, help="Filter calls before this timestamp")
    calls_parser.add_argument("--call-type", "--type", dest="call_type", default=None, help="Filter by call type (phone, facetime_video, facetime_audio, unknown)")
    calls_parser.add_argument("--limit", type=int, default=30, help="Maximum number of calls to return (default: 30)")
    calls_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    calls_parser.set_defaults(func=get_call_history)

    changes_parser = subparsers.add_parser("changes", help="Check for new messages and receipt events")
    changes_parser.add_argument("--since-id", type=int, default=None, help="Message ROWID cursor to check after")
    changes_parser.add_argument("--lookback", type=int, default=50, help="Number of recent outgoing messages to check for receipt status")
    changes_parser.add_argument("--receipt-state", type=str, default=None, help="JSON string of prior outgoing receipt states")
    changes_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    changes_parser.set_defaults(func=get_changes)

    check_changes_parser = subparsers.add_parser("check-changes", help="Alias of changes")
    check_changes_parser.add_argument("--since-id", type=int, default=None, help="Message ROWID cursor to check after")
    check_changes_parser.add_argument("--lookback", type=int, default=50, help="Number of recent outgoing messages to check for receipt status")
    check_changes_parser.add_argument("--receipt-state", type=str, default=None, help="JSON string of prior outgoing receipt states")
    check_changes_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    check_changes_parser.set_defaults(func=get_changes)

    schedule_parser = subparsers.add_parser("schedule", help="Inspect and manage scheduled messages")
    schedule_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    schedule_parser.set_defaults(func=schedule_cli, action="status")
    schedule_sub = schedule_parser.add_subparsers(dest="action")

    sched_list_p = schedule_sub.add_parser("list", help="List scheduled messages")
    sched_list_p.add_argument("--status", choices=["all", "pending", "sent", "canceled", "failed"], default="all", help="Filter by message status")
    sched_list_p.add_argument("--json", action="store_true", help="Output results in JSON format")
    sched_list_p.set_defaults(func=schedule_cli)

    sched_status_p = schedule_sub.add_parser("status", help="Get summary statistics of scheduled messages")
    sched_status_p.add_argument("--json", action="store_true", help="Output results in JSON format")
    sched_status_p.set_defaults(func=schedule_cli)

    sched_cancel_p = schedule_sub.add_parser("cancel", help="Cancel a pending scheduled message")
    sched_cancel_p.add_argument("id", help="Schedule ID to cancel (e.g. sched_...)")
    sched_cancel_p.add_argument("--json", action="store_true", help="Output results in JSON format")
    sched_cancel_p.set_defaults(func=schedule_cli)

    sched_run_p = schedule_sub.add_parser("run-pending", help="Run due scheduled messages")
    sched_run_p.add_argument("--json", action="store_true", help="Output results in JSON format")
    sched_run_p.set_defaults(func=schedule_cli)

    sched_run_alias = schedule_sub.add_parser("run", help="Alias for run-pending")
    sched_run_alias.add_argument("--json", action="store_true", help="Output results in JSON format")
    sched_run_alias.set_defaults(func=schedule_cli)

    transcribe_parser = subparsers.add_parser("transcribe", help="Voice note transcription tools and cache management")
    transcribe_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    transcribe_parser.set_defaults(func=cmd_transcribe_status)
    transcribe_sub = transcribe_parser.add_subparsers(dest="transcribe_action")

    trans_status_p = transcribe_sub.add_parser("status", help="Show transcription engine status, models, and cache statistics")
    trans_status_p.add_argument("--json", action="store_true", help="Output results in JSON format")
    trans_status_p.set_defaults(func=cmd_transcribe_status)

    trans_dl_p = transcribe_sub.add_parser("download-model", help="Download and verify whisper.cpp model")
    trans_dl_p.add_argument("--model", default=None, help="Model name (e.g. large-v3-turbo-q5_0, small, tiny)")
    trans_dl_p.add_argument("--force", action="store_true", help="Force re-download even if model file exists")
    trans_dl_p.add_argument("--json", action="store_true", help="Output results in JSON format")
    trans_dl_p.set_defaults(func=cmd_transcribe_download_model)

    trans_clear_p = transcribe_sub.add_parser("clear-cache", help="Clear local transcription cache")
    trans_clear_p.add_argument("--json", action="store_true", help="Output results in JSON format")
    trans_clear_p.set_defaults(func=cmd_transcribe_clear_cache)

    trans_backfill_p = transcribe_sub.add_parser("backfill", help="Transcribe historical voice notes in the background")
    trans_backfill_p.add_argument("--since", default=None, help="Process messages sent after this date (ISO 8601, YYYY-MM-DD, or Unix timestamp)")
    trans_backfill_p.add_argument("--chat", default=None, help="Filter to specific chat ID, phone, or email")
    trans_backfill_p.add_argument("--limit", type=int, default=None, help="Maximum number of voice notes to process")
    trans_backfill_p.add_argument("--json", action="store_true", help="Output results in JSON format")
    trans_backfill_p.set_defaults(func=cmd_transcribe_backfill)
    
    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
