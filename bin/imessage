#!/usr/bin/env python3
import argparse
import sqlite3
import datetime
import os
import sys
import subprocess
import glob
import json
import base64
import contextlib
import tempfile
import shutil

DB_PATH = os.environ.get("IMESSAGE_DB_PATH") or os.path.expanduser("~/Library/Messages/chat.db")
CONTACTS_GLOB = os.path.expanduser('~/Library/Application Support/AddressBook/**/*.abcddb')

# Messages.app holds write locks on chat.db while syncing. Without a busy
# timeout, concurrent reads fail instantly with "database is locked".
DB_TIMEOUT_SECONDS = float(os.environ.get("IMESSAGE_DB_TIMEOUT", "15"))


class CliError(Exception):
    """Recoverable, user-facing error. Carries a stable exit code."""

    def __init__(self, message, exit_code=1):
        super().__init__(message)
        self.exit_code = exit_code


# Connections opened during this invocation, closed unconditionally at exit so
# an exception mid-query can never leave a sqlite handle dangling.
_OPEN_CONNECTIONS = []


def close_all_connections():
    while _OPEN_CONNECTIONS:
        conn = _OPEN_CONNECTIONS.pop()
        try:
            conn.close()
        except Exception:
            pass


def get_db_connection():
    if not os.path.exists(DB_PATH):
        raise CliError(
            f"iMessage database not found at {DB_PATH}. "
            "This tool must run on a macOS host signed into iMessage, and the process "
            "needs Full Disk Access (System Settings > Privacy & Security > Full Disk Access)."
        )
    try:
        conn = sqlite3.connect(
            f"file:{DB_PATH}?mode=ro", uri=True, timeout=DB_TIMEOUT_SECONDS
        )
        conn.execute(f"PRAGMA busy_timeout = {int(DB_TIMEOUT_SECONDS * 1000)}")
        _OPEN_CONNECTIONS.append(conn)
        return conn
    except sqlite3.OperationalError as e:
        msg = str(e)
        if "unable to open" in msg.lower() or "authorization" in msg.lower():
            raise CliError(
                f"Could not open {DB_PATH}: {msg}. This is almost always missing Full Disk "
                "Access for the process running the server (Terminal, or sshd-keygen-wrapper over SSH)."
            )
        raise CliError(f"Could not open database in read-only mode: {msg}")
    except Exception as e:
        raise CliError(f"Could not open database in read-only mode: {e}")


@contextlib.contextmanager
def db_cursor():
    """Always close the connection, even when a query raises.

    Every command previously called conn.close() only on the success path, so
    any exception mid-query leaked the sqlite handle for the process lifetime.
    """
    conn = get_db_connection()
    try:
        yield conn.cursor()
    finally:
        try:
            conn.close()
        except Exception:
            pass

def format_size(bytes_num):
    if not bytes_num: return "0 B"
    for unit in ['B', 'KB', 'MB', 'GB']:
        if abs(bytes_num) < 1024.0:
            return f"{bytes_num:.1f} {unit}"
        bytes_num /= 1024.0
    return f"{bytes_num:.1f} TB"

def normalize_handle(val):
    if not val: return ""
    clean = "".join([c for c in val if c.isalnum() or c == '@'])
    if clean.startswith('1') and len(clean) == 11 and clean.isdigit():
        clean = clean[1:]
    return clean.lower()

def get_contacts_map():
    """Best-effort contact name resolution.

    Contact lookup is an enrichment, never a hard dependency: if AddressBook
    is missing or unreadable the caller still gets raw handles back.
    """
    try:
        ab_paths = glob.glob(CONTACTS_GLOB, recursive=True)
    except OSError:
        return {}
    cmap = {}
    for p in ab_paths:
        try:
            conn = sqlite3.connect(f"file:{p}?mode=ro", uri=True)
            c = conn.cursor()
            sql = """
            SELECT 
                r.ZFIRSTNAME, r.ZLASTNAME, r.ZORGANIZATION,
                p.ZFULLNUMBER, e.ZADDRESS
            FROM ZABCDRECORD r
            LEFT JOIN ZABCDPHONENUMBER p ON r.Z_PK = p.ZOWNER
            LEFT JOIN ZABCDEMAILADDRESS e ON r.Z_PK = e.ZOWNER
            """
            c.execute(sql)
            for fname, lname, org, phone, email in c.fetchall():
                full_name = " ".join(filter(None, [fname, lname])) or org or ""
                if not full_name: continue
                if phone:
                    cmap[normalize_handle(phone)] = full_name
                if email:
                    cmap[normalize_handle(email)] = full_name
            conn.close()
        except Exception:
            pass
    return cmap

def list_chats(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    query = """
    SELECT 
        c.ROWID, 
        COALESCE(c.display_name, ''), 
        c.chat_identifier,
        MAX(m.date) as last_msg_date
    FROM chat c
    LEFT JOIN chat_message_join cmj ON c.ROWID = cmj.chat_id
    LEFT JOIN message m ON cmj.message_id = m.ROWID
    GROUP BY c.ROWID
    ORDER BY last_msg_date DESC
    LIMIT ?
    """
    cursor.execute(query, (args.limit,))
    rows = cursor.fetchall()
    
    cmap = get_contacts_map()
    chats = []
    for rowid, display_name, identifier, last_msg_date in rows:
        cursor.execute("""
            SELECT h.id
            FROM chat_handle_join chj
            JOIN handle h ON chj.handle_id = h.ROWID
            WHERE chj.chat_id = ?
        """, (rowid,))
        handles = [r[0] for r in cursor.fetchall()]
        
        participants = []
        for h in handles:
            norm = normalize_handle(h)
            pname = cmap.get(norm, h)
            participants.append({'name': pname, 'handle': h})
            
        if display_name:
            name = display_name
        elif participants:
            name = ", ".join([p['name'] for p in participants])
        else:
            name = identifier or "<Direct Chat>"

        chats.append({
            'rowid': rowid,
            'display_name': display_name,
            'name': name,
            'identifier': identifier,
            'last_msg_date': last_msg_date,
            'participants': participants
        })
        
    if getattr(args, 'json', False):
        print(json.dumps(chats, indent=2))
    else:
        print(f"{'ID':<6} | {'Display Name / Participants':<35} | {'Identifier':<35}")
        print("-" * 85)
        for c in chats:
            print(f"{c['rowid']:<6} | {c['name']:<35} | {c['identifier']:<35}")
    conn.close()

def parse_attributed_body(blob):
    if not blob: return ""
    try:
        markers = [
            b'NSString' + bytes([1, 148, 132, 1]) + b'+',
            b'NSString' + bytes([1, 149, 132, 1]) + b'+',
            b'NSString' + bytes([1, 132, 1]) + b'+'
        ]
        for marker in markers:
            idx = blob.find(marker)
            if idx != -1:
                start = idx + len(marker)
                if start < len(blob):
                    length = blob[start]
                    if length == 0x81:
                        if start + 2 < len(blob):
                            length = blob[start+1]
                            start += 1
                    elif length == 0x82:
                        if start + 3 < len(blob):
                            length = int.from_bytes(blob[start+1:start+3], byteorder='big')
                            start += 2
                    if 0 < length < len(blob) - start:
                        return blob[start + 1 : start + 1 + length].decode('utf-8', errors='ignore')
    except: pass
    return ""

def read_messages(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    target = args.chat
    
    chat_ids = []
    if target.isdigit():
        chat_ids = [int(target)]
    else:
        cursor.execute(
            "SELECT ROWID FROM chat WHERE display_name LIKE ? OR chat_identifier LIKE ?", 
            (f"%{target}%", f"%{target}%")
        )
        chat_ids = [r[0] for r in cursor.fetchall()]
        
    if not chat_ids:
        if getattr(args, 'json', False):
            print(json.dumps([]))
            conn.close()
            return
        raise CliError(f"No chat found matching '{target}'. Use imessage_list_chats to discover valid chat identifiers.")
        
    placeholders = ",".join(["?"] * len(chat_ids))
    apple_epoch = datetime.datetime(2001, 1, 1, tzinfo=datetime.timezone.utc)
    now = datetime.datetime.now(datetime.timezone.utc)
    threshold_dt = now - datetime.timedelta(days=args.days)
    threshold_ns = int((threshold_dt - apple_epoch).total_seconds() * 1_000_000_000)
    
    query = f"""
    SELECT 
        m.ROWID,
        c.display_name,
        c.chat_identifier,
        m.date,
        m.is_from_me,
        h.id,
        m.text,
        m.attributedBody
    FROM message m
    JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
    JOIN chat c ON cmj.chat_id = c.ROWID
    LEFT JOIN handle h ON m.handle_id = h.ROWID
    WHERE c.ROWID IN ({placeholders}) AND m.date >= ?
    ORDER BY m.date ASC
    """
    cursor.execute(query, (*chat_ids, threshold_ns))
    rows = cursor.fetchall()
    
    msg_ids = [r[0] for r in rows]
    attachments_map = {}
    if msg_ids:
        att_placeholders = ",".join(["?"] * len(msg_ids))
        att_query = f"""
        SELECT 
            maj.message_id,
            a.filename,
            a.mime_type,
            a.transfer_name,
            a.total_bytes
        FROM message_attachment_join maj
        JOIN attachment a ON maj.attachment_id = a.ROWID
        WHERE maj.message_id IN ({att_placeholders})
        """
        cursor.execute(att_query, msg_ids)
        for msg_id, filename, mime_type, transfer_name, total_bytes in cursor.fetchall():
            if msg_id not in attachments_map:
                attachments_map[msg_id] = []
            attachments_map[msg_id].append({
                'filename': os.path.expanduser(filename) if filename else None,
                'mime_type': mime_type or 'application/octet-stream',
                'transfer_name': transfer_name or 'attachment',
                'size': format_size(total_bytes)
            })

    messages = []
    for msg_id, display_name, chat_ident, date_ns, is_from_me, handle, text, attr_body in rows:
        sec = date_ns / 1_000_000_000
        dt_utc = apple_epoch + datetime.timedelta(seconds=sec)
        dt_local = dt_utc.astimezone()
        ts = dt_local.strftime("%Y-%m-%d %I:%M %p")
        sender = "Me" if is_from_me else (handle or "Unknown")
        chat = display_name if display_name else chat_ident
        msg_text = text or ""
        if not msg_text or msg_text.strip() == "":
            msg_text = parse_attributed_body(attr_body)
        att_list = attachments_map.get(msg_id, [])
        messages.append({
            'msg_id': msg_id,
            'timestamp': ts,
            'chat': chat,
            'sender': sender,
            'is_from_me': bool(is_from_me),
            'text': msg_text or "<empty message>",
            'attachments': att_list
        })

    if getattr(args, 'json', False):
        print(json.dumps(messages, indent=2))
    else:
        print(f"READING MESSAGES FROM THE LAST {args.days} DAYS FOR '{target}' ({len(rows)} messages found):")
        print("=" * 85)
        for m in messages:
            msg_text = m['text']
            if m['attachments']:
                att_strs = []
                for att in m['attachments']:
                    path_str = f", path: {att['filename']}" if att['filename'] else ""
                    att_strs.append(f"[Attachment: {att['transfer_name']} ({att['mime_type']}, {att['size']}{path_str})]")
                att_desc = " ".join(att_strs)
                msg_text = f"{msg_text} {att_desc}".strip() if msg_text != "<empty message>" else att_desc
            print(f"[{m['timestamp']}] [{m['chat']}] {m['sender']}: {msg_text}")
    conn.close()

def search_messages(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    query_str = args.query
    limit = args.limit
    
    query = """
    SELECT 
        m.ROWID,
        c.ROWID as chat_id,
        c.display_name,
        c.chat_identifier,
        m.date,
        m.is_from_me,
        h.id,
        m.text,
        m.attributedBody
    FROM message m
    JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
    JOIN chat c ON cmj.chat_id = c.ROWID
    LEFT JOIN handle h ON m.handle_id = h.ROWID
    WHERE m.text LIKE ? OR (m.text IS NULL AND m.attributedBody LIKE ?)
    ORDER BY m.date DESC
    LIMIT ?
    """
    cursor.execute(query, (f"%{query_str}%", f"%{query_str}%", limit))
    rows = cursor.fetchall()
    
    apple_epoch = datetime.datetime(2001, 1, 1, tzinfo=datetime.timezone.utc)
    results = []
    for msg_id, chat_id, display_name, chat_ident, date_ns, is_from_me, handle, text, attr_body in rows:
        sec = date_ns / 1_000_000_000
        dt_utc = apple_epoch + datetime.timedelta(seconds=sec)
        dt_local = dt_utc.astimezone()
        ts = dt_local.strftime("%Y-%m-%d %I:%M %p")
        sender = "Me" if is_from_me else (handle or "Unknown")
        chat = display_name if display_name else chat_ident
        msg_text = text or parse_attributed_body(attr_body) or "<empty message>"
        results.append({
            'msg_id': msg_id,
            'chat_id': chat_id,
            'chat': chat,
            'timestamp': ts,
            'sender': sender,
            'is_from_me': bool(is_from_me),
            'text': msg_text
        })

    if getattr(args, 'json', False):
        print(json.dumps(results, indent=2))
    else:
        print(f"SEARCH RESULTS FOR '{query_str}' ({len(results)} matching messages found):")
        print("=" * 85)
        for r in results:
            print(f"[{r['timestamp']}] [Chat {r['chat_id']}: {r['chat']}] {r['sender']}: {r['text']}")
    conn.close()

def search_contacts(args):
    query = (args.query or "").lower()
    try:
        ab_paths = glob.glob(CONTACTS_GLOB, recursive=True)
    except OSError:
        ab_paths = []
    
    contacts = []
    for p in ab_paths:
        try:
            conn = sqlite3.connect(f"file:{p}?mode=ro", uri=True)
            c = conn.cursor()
            sql = """
            SELECT 
                r.ZFIRSTNAME, r.ZLASTNAME, r.ZORGANIZATION,
                p.ZFULLNUMBER, e.ZADDRESS
            FROM ZABCDRECORD r
            LEFT JOIN ZABCDPHONENUMBER p ON r.Z_PK = p.ZOWNER
            LEFT JOIN ZABCDEMAILADDRESS e ON r.Z_PK = e.ZOWNER
            """
            c.execute(sql)
            for fname, lname, org, phone, email in c.fetchall():
                full_name = " ".join(filter(None, [fname, lname]))
                search_target = " ".join(filter(None, [full_name, org, phone, email])).lower()
                if not query or query in search_target:
                    contacts.append({
                        'name': full_name or org or "Unknown",
                        'organization': org or "",
                        'phone': phone or "",
                        'email': email or ""
                    })
            conn.close()
        except Exception:
            pass

    # Deduplicate
    unique = []
    seen = set()
    for c in contacts:
        key = (c['name'], c['phone'], c['email'])
        if key not in seen:
            seen.add(key)
            unique.append(c)

    if getattr(args, 'json', False):
        print(json.dumps(unique, indent=2))
    else:
        print(f"CONTACT RESULTS ({len(unique)} contacts found):")
        print(f"{'Name':<25} | {'Organization':<20} | {'Phone':<18} | {'Email':<25}")
        print("-" * 95)
        for c in unique[:50]:
            print(f"{c['name']:<25} | {c['organization']:<20} | {c['phone']:<18} | {c['email']:<25}")

def get_members(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    target = args.chat
    
    chat_ids = []
    if target.isdigit():
        chat_ids = [int(target)]
    else:
        cursor.execute(
            "SELECT ROWID FROM chat WHERE display_name LIKE ? OR chat_identifier LIKE ?", 
            (f"%{target}%", f"%{target}%")
        )
        chat_ids = [r[0] for r in cursor.fetchall()]
        
    if not chat_ids:
        if getattr(args, 'json', False):
            print(json.dumps([]))
            conn.close()
            return
        raise CliError(f"No chat found matching '{target}'. Use imessage_list_chats to discover valid chat identifiers.")
        
    placeholders = ",".join(["?"] * len(chat_ids))
    query = f"""
    SELECT 
        c.ROWID,
        COALESCE(c.display_name, ''),
        c.chat_identifier,
        h.id,
        h.service
    FROM chat c
    JOIN chat_handle_join chj ON c.ROWID = chj.chat_id
    JOIN handle h ON chj.handle_id = h.ROWID
    WHERE c.ROWID IN ({placeholders})
    """
    cursor.execute(query, chat_ids)
    rows = cursor.fetchall()
    
    members = []
    for rowid, display_name, chat_ident, handle_id, service in rows:
        name = display_name if display_name else chat_ident
        members.append({
            'chat_id': rowid,
            'display_name': name,
            'handle': handle_id,
            'service': service
        })

    if getattr(args, 'json', False):
        print(json.dumps(members, indent=2))
    else:
        print(f"MEMBERS FOR CHAT '{target}' ({len(members)} members):")
        print(f"{'Chat ID':<8} | {'Chat Name':<25} | {'Handle / Phone':<30} | {'Service':<10}")
        print("-" * 80)
        for m in members:
            print(f"{m['chat_id']:<8} | {m['display_name']:<25} | {m['handle']:<30} | {m['service']:<10}")
    conn.close()

def get_attachment_payload(args):
    filepath = os.path.abspath(os.path.expanduser(args.path))
    if not os.path.exists(filepath):
        raise CliError(f"Attachment file not found at '{filepath}'")
    if os.path.isdir(filepath):
        raise CliError(f"'{filepath}' is a directory, not an attachment file.")
    if not os.access(filepath, os.R_OK):
        raise CliError(
            f"Attachment '{filepath}' is not readable. The server process likely needs Full Disk Access."
        )

    # Guard against base64-ing a multi-GB file into memory and blowing past
    # the parent process' output buffer.
    max_bytes = int(os.environ.get("IMESSAGE_MAX_ATTACHMENT_BYTES", str(64 * 1024 * 1024)))
    actual_size = os.path.getsize(filepath)
    if actual_size > max_bytes:
        raise CliError(
            f"Attachment is {format_size(actual_size)}, exceeding the {format_size(max_bytes)} limit. "
            "Raise IMESSAGE_MAX_ATTACHMENT_BYTES to allow larger payloads."
        )
        
    target_path = filepath
    mime = "application/octet-stream"
    ext = os.path.splitext(filepath)[1].lower()
    
    if ext in ['.heic', '.heif']:
        # Convert into a private temp dir; the previous predictable /tmp path
        # was world-writable and collided across concurrent conversions.
        try:
            tmp_dir = tempfile.mkdtemp(prefix="imessage_conv_")
            jpg_path = os.path.join(tmp_dir, os.path.basename(filepath) + ".jpg")
            subprocess.run(
                ['sips', '-s', 'format', 'jpeg', filepath, '--out', jpg_path],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=60,
                check=False,
            )
            if os.path.exists(jpg_path):
                target_path = jpg_path
                mime = "image/jpeg"
            else:
                mime = "image/heic"
        except (subprocess.TimeoutExpired, OSError):
            # Conversion is best-effort: fall back to the original bytes.
            mime = "image/heic"
    elif ext in ['.jpg', '.jpeg']:
        mime = "image/jpeg"
    elif ext == '.png':
        mime = "image/png"
    elif ext == '.gif':
        mime = "image/gif"
    elif ext == '.pdf':
        mime = "application/pdf"
    elif ext == '.txt':
        mime = "text/plain"

    try:
        with open(target_path, 'rb') as f:
            data = f.read()
    except OSError as e:
        raise CliError(f"Could not read attachment '{target_path}': {e}")

    payload = {
        'path': filepath,
        'converted_path': target_path if target_path != filepath else None,
        'mime_type': mime,
        'size_bytes': len(data),
        'base64': base64.b64encode(data).decode('utf-8')
    }
    
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"File: {filepath}")
        print(f"MIME: {mime} ({len(data)} bytes)")
        print(f"Base64 string length: {len(payload['base64'])} characters")

def send_message(args):
    recipient = args.recipient
    message = args.message
    attachment = args.attachment

    if not message and not attachment:
        raise CliError("Nothing to send: provide --message and/or --attachment.")

    # Resolve recipient against chat.db (group chats, display names, or numeric ROWIDs).
    # Resolution is best-effort: if chat.db is unreadable we still attempt the
    # send using the raw recipient rather than failing outright.
    target_ident = recipient
    try:
        with db_cursor() as c:
            if recipient.isdigit():
                c.execute("SELECT chat_identifier FROM chat WHERE ROWID = ?", (int(recipient),))
                row = c.fetchone()
                if row and row[0]:
                    target_ident = row[0]
            else:
                c.execute(
                    "SELECT chat_identifier FROM chat WHERE display_name LIKE ? OR chat_identifier = ?",
                    (f"%{recipient}%", recipient),
                )
                row = c.fetchone()
                if row and row[0]:
                    target_ident = row[0]
    except Exception:
        pass

    if attachment:
        attachment_path = os.path.abspath(os.path.expanduser(attachment))
        if not os.path.exists(attachment_path):
            raise CliError(f"Attachment file not found at '{attachment_path}'")
        if not os.path.isfile(attachment_path):
            raise CliError(f"Attachment '{attachment_path}' is not a regular file.")

        if shutil.which('swift') is None:
            raise CliError(
                "The 'swift' toolchain is required to send attachments but was not found. "
                "Install Xcode Command Line Tools: xcode-select --install"
            )

        # Read the path from argv inside Swift instead of interpolating it into
        # the source. Interpolating broke on any path containing a quote or
        # backslash and allowed arbitrary Swift to be injected via a filename.
        swift_script = """import Cocoa
let args = CommandLine.arguments
guard args.count > 1 else { exit(2) }
let url = URL(fileURLWithPath: args[1])
let pb = NSPasteboard.general
pb.clearContents()
if !pb.writeObjects([url as NSURL]) { exit(3) }
"""
        try:
            res = subprocess.run(
                ['swift', '-', attachment_path],
                input=swift_script,
                text=True,
                capture_output=True,
                timeout=60,
            )
        except subprocess.TimeoutExpired:
            raise CliError("Timed out copying the attachment to the pasteboard (swift took over 60s).")
        if res.returncode != 0:
            raise CliError(
                f"Could not place attachment on the pasteboard (swift exit {res.returncode}): "
                f"{(res.stderr or '').strip()}"
            )
        
        msg_str = (message or '').replace('\\', '\\\\').replace('"', '\\"')
        type_code = f'keystroke "{msg_str}"' if msg_str else ''

        applescript_att = f'''open location "imessage://{target_ident}"
delay 0.8
tell application "System Events"
    tell process "Messages"
        keystroke "v" using {{command down}}
        delay 0.5
        {type_code}
        delay 0.3
        key code 36
    end tell
end tell'''
        try:
            res = subprocess.run(
                ['osascript', '-e', applescript_att], capture_output=True, text=True, timeout=120
            )
        except subprocess.TimeoutExpired:
            raise CliError(
                "Timed out driving Messages.app (120s). The Mac may be showing a permission prompt, "
                "the screen may be locked, or Messages.app may be unresponsive. An active GUI session is required."
            )
        if res.returncode != 0:
            detail = (res.stderr or res.stdout or "").strip()
            if "not allowed assistive access" in detail or "-1719" in detail or "-25211" in detail:
                raise CliError(
                    "Accessibility permission denied. Grant Accessibility and Automation rights to the "
                    "process running this server (System Settings > Privacy & Security > Accessibility). "
                    f"Detail: {detail}"
                )
            raise CliError(f"Could not paste/send attachment: {detail}")
        print(f"Attachment '{attachment_path}' sent to '{recipient}' ({target_ident}) successfully!")

    elif message:
        applescript_msg = """on run argv
    set chatIdent to item 1 of argv
    set rawRecipient to item 2 of argv
    set messageText to item 3 of argv
    tell application "Messages"
        try
            set targetChat to first chat whose id contains chatIdent or guid contains chatIdent
            send messageText to targetChat
            return
        on error
        end try
        try
            send messageText to buddy chatIdent
            return
        on error
        end try
        send messageText to buddy rawRecipient
    end tell
end run"""
        try:
            res = subprocess.run(
                ['osascript', '-e', applescript_msg, target_ident, recipient, message],
                capture_output=True,
                text=True,
                timeout=90,
            )
        except subprocess.TimeoutExpired:
            raise CliError(
                "Timed out sending via Messages.app (90s). The Mac may be showing a permission prompt "
                "or Messages.app may be unresponsive."
            )
        if res.returncode != 0:
            detail = (res.stderr or res.stdout or "").strip()
            if "not authorized" in detail.lower() or "-1743" in detail:
                raise CliError(
                    "Automation permission denied. Allow this process to control Messages under "
                    f"System Settings > Privacy & Security > Automation. Detail: {detail}"
                )
            raise CliError(f"Could not send text message: {detail}")
        print(f"Message sent to '{recipient}' ({target_ident}) successfully!")

def get_recent_messages(args):
    conn = get_db_connection()
    cursor = conn.cursor()
    target = args.chat
    limit = getattr(args, 'limit', 5) or 5
    
    chat_ids = []
    if target.isdigit():
        chat_ids = [int(target)]
    else:
        cursor.execute(
            "SELECT ROWID FROM chat WHERE display_name LIKE ? OR chat_identifier LIKE ?", 
            (f"%{target}%", f"%{target}%")
        )
        chat_ids = [r[0] for r in cursor.fetchall()]
        
    if not chat_ids:
        if getattr(args, 'json', False):
            print(json.dumps([]))
            conn.close()
            return
        raise CliError(f"No chat found matching '{target}'. Use imessage_list_chats to discover valid chat identifiers.")
        
    placeholders = ",".join(["?"] * len(chat_ids))
    apple_epoch = datetime.datetime(2001, 1, 1, tzinfo=datetime.timezone.utc)
    
    query = f"""
    SELECT 
        m.ROWID,
        c.display_name,
        c.chat_identifier,
        m.date,
        m.is_from_me,
        h.id,
        m.text,
        m.attributedBody
    FROM message m
    JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
    JOIN chat c ON cmj.chat_id = c.ROWID
    LEFT JOIN handle h ON m.handle_id = h.ROWID
    WHERE c.ROWID IN ({placeholders})
    ORDER BY m.date DESC
    LIMIT ?
    """
    cursor.execute(query, (*chat_ids, limit))
    rows = cursor.fetchall()
    rows.reverse()
    
    cmap = get_contacts_map()
    messages = []
    for msg_id, display_name, chat_ident, date_ns, is_from_me, handle, text, attr_body in rows:
        sec = date_ns / 1_000_000_000
        dt_utc = apple_epoch + datetime.timedelta(seconds=sec)
        dt_local = dt_utc.astimezone()
        ts = dt_local.strftime("%Y-%m-%d %I:%M %p")
        
        sender_name = "Me"
        if not is_from_me:
            norm = normalize_handle(handle)
            sender_name = cmap.get(norm, handle or "Unknown")

        chat = display_name if display_name else chat_ident
        msg_text = text or ""
        if not msg_text or msg_text.strip() == "":
            msg_text = parse_attributed_body(attr_body)
            
        messages.append({
            'msg_id': msg_id,
            'timestamp': ts,
            'chat': chat,
            'sender': sender_name,
            'handle': handle or "",
            'is_from_me': bool(is_from_me),
            'text': msg_text or "<empty message>"
        })

    if getattr(args, 'json', False):
        print(json.dumps(messages, indent=2))
    else:
        print(f"LAST {len(messages)} RECENT MESSAGES FOR '{target}':")
        print("=" * 85)
        for m in messages:
            print(f"[{m['timestamp']}] {m['sender']}: {m['text']}")
    conn.close()

def search_group_chats(args):
    raw_participants = args.participants
    if isinstance(raw_participants, str):
        query_participants = [p.strip() for p in raw_participants.split(',') if p.strip()]
    elif isinstance(raw_participants, list):
        query_participants = raw_participants
    else:
        query_participants = []

    conn = get_db_connection()
    cursor = conn.cursor()
    cmap = get_contacts_map()

    cursor.execute("SELECT ROWID, COALESCE(display_name, ''), chat_identifier FROM chat")
    chats = cursor.fetchall()

    matching_chats = []
    for rowid, display_name, identifier in chats:
        cursor.execute("""
            SELECT h.id
            FROM chat_handle_join chj
            JOIN handle h ON chj.handle_id = h.ROWID
            WHERE chj.chat_id = ?
        """, (rowid,))
        handles = [r[0] for r in cursor.fetchall()]

        participants = []
        participant_search_space = []
        for h in handles:
            norm = normalize_handle(h)
            pname = cmap.get(norm, h)
            participants.append({'name': pname, 'handle': h})
            participant_search_space.append(f"{pname} {h}".lower())

        # Check if ALL requested queries match at least one participant in this chat
        all_matched = True
        for q in query_participants:
            q_lower = q.lower()
            found = any(q_lower in search_str for search_str in participant_search_space)
            if not found:
                all_matched = False
                break

        if all_matched and (handles or display_name):
            name = display_name if display_name else ", ".join([p['name'] for p in participants])
            matching_chats.append({
                'rowid': rowid,
                'display_name': display_name,
                'name': name,
                'identifier': identifier,
                'participants': participants
            })

    if getattr(args, 'json', False):
        print(json.dumps(matching_chats, indent=2))
    else:
        print(f"SEARCH GROUP CHATS MATCHING {query_participants} ({len(matching_chats)} chats found):")
        print("=" * 85)
        for c in matching_chats:
            print(f"[{c['rowid']}] {c['name']} ({c['identifier']})")
    conn.close()

def main():
    parser = argparse.ArgumentParser(description="iMessage CLI tool for macOS")
    subparsers = parser.add_subparsers(dest="command", required=True)
    
    list_parser = subparsers.add_parser("list", help="List active iMessage chats")
    list_parser.add_argument("--limit", type=int, default=30, help="Number of chats to list (default 30)")
    list_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    list_parser.set_defaults(func=list_chats)
    
    read_parser = subparsers.add_parser("read", help="Read recent messages from a chat")
    read_parser.add_argument("chat", help="Chat ID, display name, or contact identifier")
    read_parser.add_argument("--days", type=int, default=14, help="Days of history to fetch (default 14)")
    read_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    read_parser.set_defaults(func=read_messages)

    recent_parser = subparsers.add_parser("recent", help="Get recent messages preview")
    recent_parser.add_argument("chat", help="Chat ID, display name, or contact identifier")
    recent_parser.add_argument("--limit", type=int, default=5, help="Number of recent messages to preview (default 5)")
    recent_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    recent_parser.set_defaults(func=get_recent_messages)

    search_parser = subparsers.add_parser("search", help="Search message history")
    search_parser.add_argument("query", help="Search keyword or phrase")
    search_parser.add_argument("--limit", type=int, default=30, help="Max results (default 30)")
    search_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    search_parser.set_defaults(func=search_messages)

    search_group_parser = subparsers.add_parser("search-group", help="Search group chats by participant names/handles")
    search_group_parser.add_argument("participants", nargs="+", help="Participant names or phone numbers")
    search_group_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    search_group_parser.set_defaults(func=search_group_chats)

    contacts_parser = subparsers.add_parser("contacts", help="Search macOS contacts")
    contacts_parser.add_argument("query", nargs="?", default="", help="Name, phone number, or email search query")
    contacts_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    contacts_parser.set_defaults(func=search_contacts)

    members_parser = subparsers.add_parser("members", help="Get members of a group chat")
    members_parser.add_argument("chat", help="Chat ID or chat identifier")
    members_parser.add_argument("--json", action="store_true", help="Output results in JSON format")
    members_parser.set_defaults(func=get_members)

    attachment_parser = subparsers.add_parser("attachment", help="Get base64/multimodal attachment payload")
    attachment_parser.add_argument("path", help="POSIX path to attachment file")
    attachment_parser.add_argument("--json", action="store_true", help="Output JSON with base64 data")
    attachment_parser.set_defaults(func=get_attachment_payload)

    send_parser = subparsers.add_parser("send", help="Send an iMessage")
    send_parser.add_argument("recipient", help="Recipient identifier")
    send_parser.add_argument("--message", "-m", help="Message text body")
    send_parser.add_argument("--attachment", "-a", help="POSIX path to attachment file")
    send_parser.set_defaults(func=send_message)
    
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except CliError as e:
        # Structured, actionable failure. Exit code 1 = recoverable.
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)
    except BrokenPipeError:
        # The Node parent closed stdout (client disconnected / timeout kill).
        # Suppress Python's noisy secondary error on interpreter shutdown.
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
    except sqlite3.OperationalError as e:
        msg = str(e)
        if "locked" in msg.lower() or "busy" in msg.lower():
            print(
                f"ERROR: iMessage database is locked by Messages.app ({msg}). "
                "This is usually transient during an iCloud sync; retry shortly.",
                file=sys.stderr,
            )
            sys.exit(75)  # EX_TEMPFAIL: signals a retryable condition
        print(f"ERROR: Database error: {msg}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        # Last-resort guard: never surface a raw traceback to the MCP client.
        print(f"ERROR: Unexpected failure: {type(e).__name__}: {e}", file=sys.stderr)
        sys.exit(1)
    finally:
        close_all_connections()
