#!/usr/bin/env python3
"""Download whisper.cpp speech recognition models with SHA-256 verification."""
import sys
import os
import hashlib
import argparse
import urllib.request

MODEL_REGISTRY = {
    "large-v3-turbo-q5_0": {
        "filename": "ggml-large-v3-turbo-q5_0.bin",
        "sha256": "394221709cd5ad1f40c46e6031ca61bce88931e6e088c188294c6d5a55ffa7e2",
        "size": 574041195,
        "url": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo-q5_0.bin",
    },
    "large-v3-turbo": {
        "filename": "ggml-large-v3-turbo.bin",
        "sha256": "1fc70f774d38eb169993ac391eea357ef47c88757ef72ee5943879b7e8e2bc69",
        "size": 1624555275,
        "url": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin",
    },
    "small": {
        "filename": "ggml-small.bin",
        "sha256": "1be3a9b2063867b937e64e2ec7483364a79917e157fa98c5d94b5c1fffea987b",
        "size": 487601967,
        "url": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.bin",
    },
    "base": {
        "filename": "ggml-base.bin",
        "sha256": "60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe",
        "size": 147951465,
        "url": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin",
    },
    "tiny": {
        "filename": "ggml-tiny.bin",
        "sha256": "be07e048e1e599ad46341c8d2a135645097a538221678b7acdd1b1919c6e1b21",
        "size": 77691713,
        "url": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.bin",
    },
}

def download_model(model_name="large-v3-turbo-q5_0", dest_dir=None, force=False):
    # Normalize model name
    clean_name = model_name.lower().replace("ggml-", "").replace(".bin", "")
    if clean_name not in MODEL_REGISTRY:
        print(f"Error: Unknown model '{model_name}'.", file=sys.stderr)
        print(f"Available models: {', '.join(MODEL_REGISTRY.keys())}", file=sys.stderr)
        return False

    meta = MODEL_REGISTRY[clean_name]
    target_dir = dest_dir or os.environ.get("TRANSCRIBE_MODELS_DIR") or os.path.expanduser("~/.imessage-mcp/models")
    os.makedirs(target_dir, mode=0o700, exist_ok=True)
    target_path = os.path.join(target_dir, meta["filename"])

    if os.path.exists(target_path) and not force:
        # Verify existing file
        h = hashlib.sha256()
        with open(target_path, "rb") as f:
            while chunk := f.read(65536):
                h.update(chunk)
        if h.hexdigest() == meta["sha256"]:
            print(f"Model already present and verified: {target_path}")
            return True
        else:
            print("Existing model file corrupted or checksum mismatch; re-downloading...", file=sys.stderr)

    tmp_path = f"{target_path}.tmp"
    url = meta["url"]
    expected_size = meta["size"]
    expected_sha = meta["sha256"]

    print(f"Downloading {clean_name} ({expected_size / 1024 / 1024:.1f} MB) from {url}...")
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "imessage-mcp-server/1.14.0"})
        with urllib.request.urlopen(req) as resp, open(tmp_path, "wb") as out_file:
            downloaded = 0
            hasher = hashlib.sha256()
            while True:
                chunk = resp.read(131072)
                if not chunk:
                    break
                out_file.write(chunk)
                hasher.update(chunk)
                downloaded += len(chunk)
                if expected_size:
                    pct = (downloaded / expected_size) * 100
                    mb = downloaded / 1024 / 1024
                    sys.stderr.write(f"\rProgress: {pct:.1f}% ({mb:.1f} MB)")
                    sys.stderr.flush()
            sys.stderr.write("\n")

        actual_sha = hasher.hexdigest()
        if actual_sha != expected_sha:
            print(f"Error: SHA-256 checksum mismatch!\nExpected: {expected_sha}\nActual:   {actual_sha}", file=sys.stderr)
            if os.path.exists(tmp_path):
                os.remove(tmp_path)
            return False

        os.replace(tmp_path, target_path)
        os.chmod(target_path, 0o600)
        print(f"Successfully downloaded and verified: {target_path}")
        return True
    except Exception as e:
        print(f"Download failed: {e}", file=sys.stderr)
        if os.path.exists(tmp_path):
            os.remove(tmp_path)
        return False

def main():
    parser = argparse.ArgumentParser(description="Download whisper speech recognition model with checksum verification.")
    parser.add_argument("model", nargs="?", default="large-v3-turbo-q5_0", help="Model name (default: large-v3-turbo-q5_0).")
    parser.add_argument("--dir", default=None, help="Destination directory (default: ~/.imessage-mcp/models).")
    parser.add_argument("--force", action="store_true", help="Force re-download even if already downloaded.")
    args = parser.parse_args()

    success = download_model(model_name=args.model, dest_dir=args.dir, force=args.force)
    sys.exit(0 if success else 1)

if __name__ == "__main__":
    main()
