# ---- Core ----
PORT=8765
AUTH_TOKEN=change-me-to-a-secure-random-token
USE_HTTPS=false
PUBLIC_DOMAIN=imessage.genericservice.app

# ---- OAuth 2.0 ----
# Set JWT_SECRET explicitly. If it is unset, tokens are signed with an
# ephemeral per-boot secret, so every restart invalidates all issued tokens.
# JWT_SECRET=another-long-random-secret
# OAUTH_CLIENT_ID=imessage-cli-client
# OAUTH_CLIENT_SECRET=client-secret-here
# CLIENT_UBUNTU_SECRET=ubuntu-remote-secret-here

# Transitional full-access token, previously hardcoded in source.
# Leave unset unless you have a client that still depends on it.
# LEGACY_TOKEN=

# ---- Audit logging ----
ENABLE_AUDIT_LOG=false
# LOG_DIR=/absolute/path/to/logs
# AUDIT_MAX_BYTES=10485760   # rotate at 10 MB
# AUDIT_MAX_FILES=5

# ---- Resilience tuning ----
# Hard timeouts prevent a wedged AppleScript/TCC prompt from hanging a request
# forever and pinning the MCP session behind it.
# CLI_READ_TIMEOUT_MS=30000
# CLI_SEND_TIMEOUT_MS=90000
# CLI_ATTACHMENT_TIMEOUT_MS=60000
# CLI_MAX_BUFFER_BYTES=134217728   # base64 attachments exceed Node's 1 MB default
# MAX_CONCURRENT_CLI=4             # caps concurrent python3/sqlite subprocesses

# Session lifecycle
# SESSION_IDLE_MS=300000
# SESSION_SWEEP_MS=60000
# MAX_HTTP_SESSIONS=256
# MAX_SSE_SESSIONS=256
# CONFIRM_TOKEN_TTL_MS=600000

# HTTP server
# BODY_LIMIT=1mb
# KEEP_ALIVE_TIMEOUT_MS=76000      # must exceed your proxy's idle timeout
# HEADERS_TIMEOUT_MS=80000         # must exceed KEEP_ALIVE_TIMEOUT_MS
# SHUTDOWN_GRACE_MS=15000
# TRUST_PROXY=true                 # required behind Cloudflare Tunnel / Tailscale

# Rate limiting / brute-force protection
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=600
# AUTH_FAIL_WINDOW_MS=900000
# AUTH_FAIL_MAX=25

# ---- Advanced ----
# PYTHON_BIN=/usr/bin/python3
# IMESSAGE_DB_PATH=~/Library/Messages/chat.db
# IMESSAGE_DB_TIMEOUT=15           # sqlite busy_timeout, for iCloud sync locks
# IMESSAGE_MAX_ATTACHMENT_BYTES=67108864
