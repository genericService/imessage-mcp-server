PORT=8765
# Primary bearer token — this is the only credential that grants iMessage access.
# Mint it on the backend; paste it into Grok/Cursor as the MCP token.
BEARER_TOKEN=change-me-to-a-secure-random-token
USE_HTTPS=false
PUBLIC_DOMAIN=imessage.genericservice.app

# Dual-stack bind address (default ::). Use 0.0.0.0 for IPv4-only.
HOST=::

# Route imessage CLI through localhost SSH so sshd's Full Disk Access reads chat.db
# Set to false when running interactively in Terminal with FDA granted.
IMESSAGE_SSH_FDA=true
IMESSAGE_SSH_FDA_HOST=localhost

# Per-client static secrets (client_id -> secret) for headless agents
CLIENT_UBUNTU_SECRET=

# Comma-separated legacy bearer tokens (avoid hardcoding in source)
LEGACY_BEARER_TOKENS=

ENABLE_AUDIT_LOG=false
